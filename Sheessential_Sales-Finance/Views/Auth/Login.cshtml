@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sheessentials - Login</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: #A36A66;
            --brand-d: #8a5a57;
            --brand-l: #FBEAEB;
            --ink: #2c1f1e;
            --muted: #9b8784;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            height: 100vh;
            display: flex;
            overflow: hidden;
            background: #f5eeec;
        }

        /* ── LEFT PANEL ──────────────────────────────── */
        .left-panel {
            position: relative;
            width: 55%;
            overflow: hidden;
            flex-shrink: 0;
        }

        .left-bg {
            position: absolute;
            inset: 0;
            background-image: url('/images/login_background.jpg');
            background-size: cover;
            background-position: center;
            transform: scale(1.04);
            transition: transform 8s ease;
        }

        .left-panel:hover .left-bg {
            transform: scale(1.08);
        }

        /* warm tinted overlay */
        .left-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient( 135deg, rgba(44, 31, 30, 0.52) 0%, rgba(163, 106, 102, 0.28) 50%, rgba(44, 31, 30, 0.18) 100% );
        }

        /* decorative diagonal slice on the right edge */
        .left-panel::after {
            content: '';
            position: absolute;
            top: 0;
            right: -1px;
            bottom: 0;
            width: 80px;
            background: #f5eeec;
            clip-path: polygon(100% 0, 100% 100%, 0 100%);
            z-index: 2;
        }

        /* brand text sitting on photo */
        .left-content {
            position: relative;
            z-index: 3;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 48px 64px;
        }

        .left-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.22);
            backdrop-filter: blur(8px);
            color: #fff;
            font-size: 11px;
            font-weight: 500;
            letter-spacing: .12em;
            text-transform: uppercase;
            padding: 6px 14px;
            border-radius: 99px;
            margin-bottom: 20px;
            width: fit-content;
        }

            .left-tag span {
                width: 6px;
                height: 6px;
                background: #A36A66;
                border-radius: 50%;
                display: inline-block;
            }

        .left-headline {
            font-family: 'Cormorant Garamond', serif;
            font-size: clamp(36px, 4vw, 52px);
            font-weight: 300;
            color: #fff;
            line-height: 1.15;
            letter-spacing: -0.01em;
            margin-bottom: 16px;
        }

            .left-headline em {
                font-style: italic;
                color: #f8d8d6;
            }

        .left-sub {
            font-size: 13px;
            color: rgba(255,255,255,0.65);
            font-weight: 300;
            line-height: 1.6;
            max-width: 340px;
        }

        /* decorative dots */
        .dots-row {
            display: flex;
            gap: 6px;
            margin-top: 32px;
        }

            .dots-row span {
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: rgba(255,255,255,0.3);
            }

                .dots-row span:first-child {
                    background: #A36A66;
                    width: 22px;
                    border-radius: 99px;
                }

        /* ── RIGHT PANEL ─────────────────────────────── */
        .right-panel {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5eeec;
            padding: 48px 32px;
            position: relative;
        }

            /* faint radial glow behind form */
            .right-panel::before {
                content: '';
                position: absolute;
                top: 30%;
                left: 50%;
                transform: translate(-50%, -50%);
                width: 420px;
                height: 420px;
                background: radial-gradient(circle, rgba(163,106,102,0.09) 0%, transparent 70%);
                pointer-events: none;
            }

        .form-card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 380px;
        }

        /* logo */
        .logo-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 36px;
            animation: fadeDown 0.6s ease both;
        }

            .logo-wrap img {
                height: 80px;
                width: auto;
                object-fit: contain;
                margin-bottom: 10px;
            }

        .logo-divider {
            width: 36px;
            height: 2px;
            background: linear-gradient(90deg, transparent, #A36A66, transparent);
            border-radius: 99px;
        }

        /* welcome text */
        .welcome-block {
            text-align: center;
            margin-bottom: 32px;
            animation: fadeDown 0.6s 0.08s ease both;
        }

        .welcome-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 28px;
            font-weight: 400;
            color: var(--ink);
            letter-spacing: -0.01em;
            margin-bottom: 6px;
        }

        .welcome-sub {
            font-size: 12px;
            color: var(--muted);
            font-weight: 300;
            letter-spacing: 0.04em;
        }

        /* form fields */
        .field-group {
            display: flex;
            flex-direction: column;
            gap: 14px;
            margin-bottom: 12px;
            animation: fadeUp 0.6s 0.14s ease both;
        }

        .field-wrap {
            position: relative;
        }

        .field-label {
            display: block;
            font-size: 10px;
            font-weight: 500;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .field-input {
            width: 100%;
            background: #fff;
            border: 1.5px solid #e8dbd9;
            border-radius: 12px;
            padding: 13px 16px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            color: var(--ink);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .field-input::placeholder {
                color: #c8b8b6;
            }

            .field-input:focus {
                border-color: var(--brand);
                box-shadow: 0 0 0 4px rgba(163,106,102,0.10);
            }

        .eye-btn {
            position: absolute;
            right: 14px;
            bottom: 13px;
            background: none;
            border: none;
            cursor: pointer;
            color: #c8b8b6;
            display: flex;
            align-items: center;
            transition: color 0.15s;
        }

            .eye-btn:hover {
                color: var(--brand);
            }

        /* forgot */
        .forgot-row {
            text-align: right;
            margin-bottom: 24px;
            animation: fadeUp 0.6s 0.18s ease both;
        }

        .forgot-link {
            font-size: 11.5px;
            color: var(--muted);
            text-decoration: none;
            transition: color 0.15s;
            letter-spacing: 0.02em;
        }

            .forgot-link:hover {
                color: var(--brand);
            }

        /* submit */
        .submit-btn {
            width: 100%;
            padding: 14px;
            background: var(--brand);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px;
            font-weight: 500;
            letter-spacing: .08em;
            text-transform: uppercase;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 4px 18px rgba(163,106,102,0.28);
            animation: fadeUp 0.6s 0.22s ease both;
        }

            .submit-btn:hover {
                background: var(--brand-d);
                transform: translateY(-1px);
                box-shadow: 0 8px 24px rgba(163,106,102,0.32);
            }

            .submit-btn:active {
                transform: translateY(0);
                box-shadow: 0 2px 10px rgba(163,106,102,0.20);
            }

        /* error alert */
        .alert-error {
            background: #fff1f1;
            border: 1px solid #fac5c5;
            color: #b91c1c;
            padding: 11px 16px;
            border-radius: 10px;
            font-size: 12.5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            animation: shake 0.4s ease;
        }

            .alert-error::before {
                content: '⚠';
                font-size: 14px;
                flex-shrink: 0;
            }

        /* bottom note */
        .bottom-note {
            text-align: center;
            margin-top: 28px;
            font-size: 11px;
            color: #c8b8b6;
            letter-spacing: 0.03em;
            animation: fadeUp 0.6s 0.26s ease both;
        }

        /* ── ANIMATIONS ──────────────────────────────── */
        @@keyframes fadeDown {
            from {
                opacity: 0;
                transform: translateY(-14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            20% {
                transform: translateX(-6px);
            }

            40% {
                transform: translateX(6px);
            }

            60% {
                transform: translateX(-4px);
            }

            80% {
                transform: translateX(4px);
            }
        }

        /* ── RESPONSIVE ──────────────────────────────── */
        @@media (max-width: 768px) {
            .left-panel {
                display: none;
            }

            .right-panel {
                background: #f5eeec;
            }
        }
    </style>
</head>
<body>

    <!-- ── LEFT: Photo panel ── -->
    <div class="left-panel">
        <div class="left-bg"></div>
        <div class="left-overlay"></div>
        <div class="left-content">
            <div class="left-tag"><span></span> Staff Portal</div>
            <h1 class="left-headline">
                Beauty begins<br>with <em>confidence</em>
            </h1>
            <p class="left-sub">
                Manage your Sheessentials store — products, orders, and payments — all in one place.
            </p>
            <div class="dots-row">
                <span></span><span></span><span></span><span></span>
            </div>
        </div>
    </div>

    <!-- ── RIGHT: Login form ── -->
    <div class="right-panel">
        <div class="form-card">

            <!-- Logo -->
            <div class="logo-wrap">
                <img src="~/images/logo1.png" alt="Sheessentials Logo" />
                <div class="logo-divider"></div>
            </div>

            <!-- Welcome -->
            <div class="welcome-block">
                <h2 class="welcome-title">Welcome back</h2>
                <p class="welcome-sub">Sign in to your account to continue</p>
            </div>

            <!-- Error -->
            @if (ViewBag.Error != null)
            {
                <div class="alert-error">@ViewBag.Error</div>
            }

            <!-- Form -->
            <form asp-controller="Auth" asp-action="Login" method="post">

                <div class="field-group">
                    <!-- Email -->
                    <div class="field-wrap">
                        <label class="field-label">Email address</label>
                        <input type="email" name="Email" placeholder="you@example.com"
                               class="field-input" required autocomplete="email" />
                    </div>

                    <!-- Password -->
                    <div class="field-wrap">
                        <label class="field-label">Password</label>
                        <input id="password" type="password" name="Password" placeholder="••••••••"
                               class="field-input" required autocomplete="current-password" style="padding-right:44px;" />
                        <button type="button" id="togglePassword" class="eye-btn" tabindex="-1">
                            <!-- eye-closed -->
                            <svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                 fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M3 3l18 18M9.88 9.88A3 3 0 0112 9c1.657 0 3 1.343 3 3 0 .386-.073.752-.207 1.086M6.11 6.11C4.24 7.676 2.913 9.72 2.458 12c1.274 4.057 5.064 7 9.542 7 1.848 0 3.593-.502 5.107-1.384M17.89 17.89C19.76 16.324 21.087 14.28 21.542 12c-.387-1.235-1.01-2.39-1.824-3.384M15 12a3 3 0 01-3 3" />
                            </svg>
                            <!-- eye-open -->
                            <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                                 class="hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Forgot password -->
                <div class="forgot-row">
                    <a href="@Url.Action("ForgotPassword", "Auth")" class="forgot-link">Forgot your password?</a>
                </div>

                <!-- Submit -->
                <button type="submit" class="submit-btn">Sign In</button>

            </form>

            <p class="bottom-note">© 2026 Sheessentials. All rights reserved.</p>
        </div>
    </div>

</body>
<script>
    const togglePassword = document.getElementById("togglePassword");
    const passwordInput  = document.getElementById("password");
    const eyeOpen        = document.getElementById("eyeOpen");
    const eyeClosed      = document.getElementById("eyeClosed");

    togglePassword.addEventListener("click", () => {
        const isPassword = passwordInput.type === "password";
        passwordInput.type = isPassword ? "text" : "password";
        eyeOpen.classList.toggle("hidden", !isPassword);
        eyeClosed.classList.toggle("hidden", isPassword);
    });
</script>
</html>
