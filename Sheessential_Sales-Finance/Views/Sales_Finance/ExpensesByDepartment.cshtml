    function buildPayrollPanel(cutoffList) {
        document.getElementById('panelTabs').innerHTML=`<button class="flex-1 px-4 py-2 rounded-lg text-sm font-medium bg-white shadow text-indigo-600">All Cutoffs (${cutoffList.length})</button>`;
        const body=document.getElementById('panelBody');
        if(!cutoffList.length){body.innerHTML='<p class="text-gray-400 text-center py-8">No payroll data</p>';return;}
        const grouped={};
        cutoffList.forEach(pr=>{const k=pr.cutoffLabel;if(!grouped[k])grouped[k]=[];grouped[k].push(pr);});
        const cutoffKeys=Object.keys(grouped).sort().reverse();
        let html='';
        cutoffKeys.forEach(key=>{
            const runs=grouped[key]; const totalGross=runs.reduce((s,r)=>s+r.grossSalary,0); const totalNet=runs.reduce((s,r)=>s+r.netSalary,0); const totalDed=runs.reduce((s,r)=>s+r.totalDeductions,0); const totalEmp=runs.reduce((s,r)=>s+r.totalEmployees,0); const half=runs[0].cutoffHalf; const firstRun=runs[0];
            const statusText=firstRun.status||'Completed'; const ns=(statusText||'').trim().toLowerCase();
            const isPending=ns==='pending'; const isCalculated=ns==='calculated'||ns==='processing'; const isCompleted=ns==='completed'; const isApproved=ns==='approved'; const isDeclined=ns==='declined';
            const statusBadge=isCalculated?'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-blue-100 text-blue-800">Processing</span>':isCompleted?'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800">✓ Completed</span>':isApproved?'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800">✓ Approved</span>':isDeclined?'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-red-100 text-red-800">✕ Declined</span>':isPending?'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>':`<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-gray-100 text-gray-700">${esc(statusText)}</span>`;
            const payrollActions=isPending?`<div class="flex gap-1.5 mt-3"><button onclick='event.stopPropagation();confirmPayroll("${firstRun.id}","Completed",${totalGross},${JSON.stringify(firstRun.payRunNumber||"")},${JSON.stringify(half)})' class="px-3 py-1 bg-green-600 text-white text-[11px] font-medium rounded-lg hover:bg-green-700">Approve</button><button onclick='event.stopPropagation();confirmPayroll("${firstRun.id}","Declined",${totalGross},${JSON.stringify(firstRun.payRunNumber||"")},${JSON.stringify(half)})' class="px-3 py-1 bg-red-600 text-white text-[11px] font-medium rounded-lg hover:bg-red-700">Decline</button></div>`:'';
            html+=`<div class="mb-8 bg-indigo-50 rounded-2xl p-5 border border-indigo-100"><div class="flex items-center justify-between mb-1"><div><h3 class="text-base font-bold text-indigo-900">${esc(key)}</h3><p class="text-xs text-indigo-600">${half} • ${totalEmp} employee(s) • ${runs.length} run(s) ${statusBadge}</p></div><span class="text-lg font-bold text-indigo-700">${fmt(totalGross)}</span></div><div class="grid grid-cols-3 gap-2 my-4"><div class="text-center bg-white rounded-lg p-2 border"><p class="text-[10px] text-gray-400">Gross</p><p class="text-xs font-bold">${fmt(totalGross)}</p></div><div class="text-center bg-white rounded-lg p-2 border"><p class="text-[10px] text-gray-400">Deductions</p><p class="text-xs font-bold text-red-600">${fmt(totalDed)}</p></div><div class="text-center bg-white rounded-lg p-2 border"><p class="text-[10px] text-gray-400">Net</p><p class="text-xs font-bold text-green-700">${fmt(totalNet)}</p></div></div>${payrollActions}`;
            const deptMap={};
            runs.forEach(pr=>{(pr.departments||[]).forEach(d=>{if(!deptMap[d.name])deptMap[d.name]={...d,employees:[...d.employees]};else{deptMap[d.name].employeeCount+=d.employeeCount;deptMap[d.name].grossSalary+=d.grossSalary;deptMap[d.name].netSalary+=d.netSalary;deptMap[d.name].totalDeductions+=d.totalDeductions;deptMap[d.name].employees=deptMap[d.name].employees.concat(d.employees);}});});
            Object.keys(deptMap).sort().forEach((dName,di)=>{
                const dept=deptMap[dName]; const deptId=`dept_${key.replace(/[^a-zA-Z0-9]/g,'')}_${di}`;
                html+=`<div class="mb-3"><button onclick="toggleDept('${deptId}')" class="w-full flex items-center justify-between bg-white rounded-xl p-4 border border-gray-200 hover:border-indigo-300 hover:shadow transition-all text-left"><div class="flex items-center gap-3"><div class="w-8 h-8 bg-indigo-100 rounded-lg flex items-center justify-center"><span class="text-indigo-600 font-bold text-[10px]">${esc(dName.substring(0,2).toUpperCase())}</span></div><div><p class="text-sm font-semibold text-gray-900">${esc(dName)}</p><p class="text-[11px] text-gray-400">${dept.employeeCount} employee(s)</p></div></div><div class="flex items-center gap-4"><div class="text-right"><p class="text-sm font-bold text-gray-900">${fmt(dept.grossSalary)}</p><p class="text-[10px] text-gray-400">Ded: ${fmt(dept.totalDeductions)} • Net: ${fmt(dept.netSalary)}</p></div><svg id="${deptId}_arrow" class="w-4 h-4 text-gray-400 transform transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg></div></button><div id="${deptId}" class="hidden mt-2 ml-4 space-y-2"><div class="bg-gray-50 rounded-xl p-3 border border-gray-100"><div class="grid grid-cols-2 gap-x-4 gap-y-1 text-[11px]"><div class="flex justify-between"><span class="text-gray-400">SSS</span><span class="font-medium">${fmt(dept.sss)}</span></div><div class="flex justify-between"><span class="text-gray-400">PhilHealth</span><span class="font-medium">${fmt(dept.philHealth)}</span></div><div class="flex justify-between"><span class="text-gray-400">Pag-IBIG</span><span class="font-medium">${fmt(dept.pagIbig)}</span></div><div class="flex justify-between"><span class="text-gray-400">Tax</span><span class="font-medium">${fmt(dept.withholdingTax)}</span></div><div class="flex justify-between"><span class="text-gray-400">SSS Loan</span><span class="font-medium">${fmt(dept.sssLoan)}</span></div><div class="flex justify-between"><span class="text-gray-400">Pag-IBIG Loan</span><span class="font-medium">${fmt(dept.pagIbigLoan)}</span></div><div class="flex justify-between"><span class="text-gray-400">Company Loan</span><span class="font-medium">${fmt(dept.companyLoan)}</span></div><div class="flex justify-between"><span class="text-gray-400">Late/Absence</span><span class="font-medium">${fmt(dept.latePenalty+dept.absencePenalty)}</span></div></div><div class="mt-1 pt-1 border-t flex justify-between text-[11px] font-bold"><span class="text-red-600">Total Deductions</span><span class="text-red-600">${fmt(dept.totalDeductions)}</span></div></div>`;
                dept.employees.forEach(emp=>{html+=`<button onclick="event.stopPropagation();showEmployeeBreakdown(${JSON.stringify(emp).replace(/"/g,'&quot;')})" class="w-full flex items-center justify-between bg-white rounded-xl p-3 border border-gray-100 hover:border-indigo-200 hover:bg-indigo-50/30 transition-all text-left"><div><p class="text-sm font-medium text-gray-800">${esc(emp.employeeName)}</p><p class="text-[10px] text-gray-400">${esc(emp.position)} • ${emp.daysPresent}/${emp.totalWorkingDays} days</p></div><div class="text-right"><p class="text-sm font-bold">${fmt(emp.grossSalary)}</p><p class="text-[10px] text-green-600">Net: ${fmt(emp.netSalary)}</p></div></button>`;});
                html+=`</div></div>`;
            });
            html+=`</div>`;
        });
        body.innerHTML=html;
    }

