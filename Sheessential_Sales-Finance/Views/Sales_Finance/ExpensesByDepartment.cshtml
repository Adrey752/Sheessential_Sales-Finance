    async function approveIngredient(id,expenseId){if(!confirm('Approve this stock request?'))return;try{const res=await fetch('/Sales_Finance/UpdatedStockRequestStatus',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:`id=${encodeURIComponent(id)}&expenseId=${encodeURIComponent(expenseId||'')}`});const data=await res.json();if(data.success){alert('✅ Approved!');location.reload();}else{alert('❌ '+(data.message||'Error'));}}catch(err){alert('❌ '+err.message);}}

    let pendingPayrollId=null,pendingPayrollStatus=null;
    function confirmPayroll(id,status,grossAmount,runNumber,cutoffHalf){
        pendingPayrollId=id;pendingPayrollStatus=status;
        const btn=document.getElementById('payrollConfirmBtn');
        const details=document.getElementById('payrollConfirmDetails');
        const reasonWrap=document.getElementById('payrollDeclineReasonWrap');
        const reasonInput=document.getElementById('payrollDeclineReason');

        if(reasonInput) reasonInput.value='';

        if(status==='Completed'||status==='Approved'){
            document.getElementById('payrollConfirmTitle').textContent='Approve & Release Payroll';
            document.getElementById('payrollConfirmMsg').textContent=`Release ${runNumber} (${cutoffHalf})?`;
            btn.className='px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium';
            btn.textContent='Approve';
            const balAfter=availableBalance-grossAmount;
            details.innerHTML=`<div class="flex justify-between text-sm"><span class="text-gray-500">Balance</span><span>${fmt(availableBalance)}</span></div><div class="flex justify-between text-sm"><span class="text-gray-500">Amount</span><span class="text-red-600">-${fmt(grossAmount)}</span></div><hr><div class="flex justify-between text-sm"><span class="font-medium">After</span><span class="font-bold ${balAfter<0?'text-red-600':'text-green-600'}">${fmt(balAfter)}</span></div>${balAfter<0?'<p class="text-xs text-red-500 mt-1">⚠️ Insufficient balance!</p>':''}`;
            details.classList.remove('hidden');
            if(reasonWrap) reasonWrap.classList.add('hidden');
        }
        else{
            document.getElementById('payrollConfirmTitle').textContent='Decline Payroll';
            document.getElementById('payrollConfirmMsg').textContent=`Decline ${runNumber} (${cutoffHalf})?`;
            btn.className='px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium';
            btn.textContent='Decline';
            details.innerHTML='';
            details.classList.add('hidden');
            if(reasonWrap) reasonWrap.classList.remove('hidden');
        }

        document.getElementById('payrollConfirmModal').classList.remove('hidden');
    }
    function closePayrollConfirm(){
        document.getElementById('payrollConfirmModal').classList.add('hidden');
        const reasonInput=document.getElementById('payrollDeclineReason');
        const reasonWrap=document.getElementById('payrollDeclineReasonWrap');
        if(reasonInput) reasonInput.value='';
        if(reasonWrap) reasonWrap.classList.add('hidden');
    }

    document.getElementById('payrollConfirmBtn').addEventListener('click',async()=>{
        if(!pendingPayrollId)return;

        const reasonInput=document.getElementById('payrollDeclineReason');
        const declineReason=(reasonInput?.value||'').trim();

        if((pendingPayrollStatus||'').toLowerCase()==='declined' && !declineReason){
            alert('❌ Please provide a reason for declining payroll.');
            reasonInput?.focus();
            return;
        }

        try{
            const body=`id=${encodeURIComponent(pendingPayrollId)}&status=${encodeURIComponent(pendingPayrollStatus)}&declineReason=${encodeURIComponent(declineReason)}`;
            const res=await fetch('/Sales_Finance/ReleasePayroll',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});
            const raw=await res.text();
            let data;
            try{data=JSON.parse(raw);}catch{alert('❌ Server error: '+raw);closePayrollConfirm();return;}
            if(res.ok&&data.success){alert(`✅ Payroll ${pendingPayrollStatus.toLowerCase()}!`);location.reload();}
            else{alert('❌ '+(data.message||'Error'));}
        }catch(err){alert('❌ '+err.message);}

        closePayrollConfirm();
    });

    // ─── PINNED DEPARTMENTS ───
    const PINNED_KEY = 'sheessential_pinned_depts';
    function getPinned(){ try{ return JSON.parse(localStorage.getItem(PINNED_KEY)||'[]'); }catch(e){ return []; } }
    function savePinned(arr){ localStorage.setItem(PINNED_KEY, JSON.stringify(arr)); }
    function togglePin(deptName, btn){
        let pinned = getPinned();
        const idx = pinned.indexOf(deptName);
        if(idx > -1){ pinned.splice(idx,1); }
        else{ pinned.push(deptName); }
        savePinned(pinned);
        applyPinnedState();
    }
    function applyPinnedState(){
        const pinned = getPinned();
        const grid = document.querySelector('.grid.grid-cols-1.sm\\:grid-cols-2');
        if(!grid) return;
        const cards = [...grid.children];
        cards.forEach(card => {
            const btn = card.querySelector('.pin-btn');
            if(!btn) return;
            const dept = btn.dataset.dept;
            const isPinned = pinned.includes(dept);
            btn.classList.toggle('text-amber-400', isPinned);
            btn.classList.toggle('text-gray-300', !isPinned);
            card.style.order = isPinned ? '-1' : '0';
        });
    }

    // ─── UNDO TOAST ───
    let undoTimer = null, undoAction = null;
    let actionNoticeTimer = null;

    function showActionNotice(message, type = 'success') {
        const notice = document.getElementById('actionNotice');
        const box = document.getElementById('actionNoticeBox');
        if (!notice || !box) return;

        clearTimeout(actionNoticeTimer);

        const map = {
            success: 'bg-green-50 text-green-800 border-green-200',
            error: 'bg-red-50 text-red-800 border-red-200',
            info: 'bg-blue-50 text-blue-800 border-blue-200'
        };

        box.className = `px-4 py-3 rounded-xl shadow-xl border text-sm font-medium ${map[type] || map.info}`;
        box.textContent = message;
        notice.classList.remove('hidden');

        actionNoticeTimer = setTimeout(() => {
            notice.classList.add('hidden');
        }, 2200);
    }

    function showUndoToast(message, undoFn){
        clearTimeout(undoTimer);
        undoAction = undoFn;
        const toast = document.getElementById('undoToast');
        document.getElementById('undoToastMsg').textContent = message;
        const bar = document.getElementById('undoProgressBar');
        toast.classList.remove('hidden');
        bar.style.transition = 'none';
        bar.style.width = '100%';
        requestAnimationFrame(()=>{
            requestAnimationFrame(()=>{
                bar.style.transition = 'width 5s linear';
                bar.style.width = '0%';
            });
        });
        undoTimer = setTimeout(()=>{ toast.classList.add('hidden'); undoAction=null; }, 5000);
    }
    function dismissToast(){
        clearTimeout(undoTimer);
        document.getElementById('undoToast').classList.add('hidden');
        undoAction = null;
    }

    // ─── OPTIMISTIC UI ───
    async function optimisticApprove(id, label, amount, formData){
        try {
            const res = await fetch('/Sales_Finance/ApproveExpense', { method: 'POST', body: new URLSearchParams(formData) });
            if(res.ok || res.redirected){
                showUndoToast(`✓ Approved: ${label} (${fmt(amount)})`, ()=>{ location.reload(); });
                document.querySelectorAll(`[data-expense-id="${id}"]`).forEach(el => {
                    const actionDiv = el.querySelector('.optimistic-actions');
                    if(actionDiv) actionDiv.remove();
                    el.classList.add('opacity-50');
                    const badge = el.querySelector('.status-badge');
                    if(badge){ badge.className='px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800 status-badge'; badge.textContent='✓ Approved'; }
                });
                closeApproveModal();
            } else { location.reload(); }
        } catch(err) { location.reload(); }
    }

    // ─── GLOBAL SEARCH ───
    function onGlobalSearch(query){
        const dd = document.getElementById('searchDropdown');
        if(!query || query.length < 2){ dd.classList.add('hidden'); return; }
        const q = query.toLowerCase();
        const results = [];

        REPORT_DEPT_DATA.forEach(dept => {
            dept.expenses.forEach(e => {
                if((e.description||'').toLowerCase().includes(q) ||
                   (e.expenseType||'').toLowerCase().includes(q) ||
                   (e.requestedBy||'').toLowerCase().includes(q) ||
                   String(e.amount).includes(q)){
                    results.push({ type:'expense', dept:dept.name, label:e.description||e.expenseType, sub:e.requestedBy+' • '+fmt(e.amount), status:e.status });
                }
            });
        });

        UTILITY_EXPENSES.forEach(e => {
            if((e.description||'').toLowerCase().includes(q) ||
               (e.expenseType||'').toLowerCase().includes(q) ||
               (e.requestedBy||'').toLowerCase().includes(q) ||
               (e.expenseId||'').toLowerCase().includes(q)){
                results.push({ type:'utility', dept:'Utilities', label:e.category+': '+(e.description||e.expenseType), sub:e.requestedBy+' • '+fmt(e.amount), status:e.status });
            }
        });

        if(typeof ALL_EXPENSES_CMP !== 'undefined'){
            ALL_EXPENSES_CMP.forEach(e => {
                if((e.description||'').toLowerCase().includes(q) ||
                   (e.expenseType||'').toLowerCase().includes(q) ||
                   (e.department||'').toLowerCase().includes(q)){
                    if(!results.find(r=>r.label===e.description&&r.dept===e.department)){
                        results.push({ type:'all', dept:e.department, label:e.description||e.expenseType, sub:e.department+' • '+fmt(e.amount), status:e.status });
                    }
                }
            });
        }

        if(!results.length){
            dd.innerHTML='<div class="px-4 py-6 text-center text-sm text-gray-400">No results found for "<strong>'+esc(query)+'</strong>"</div>';
            dd.classList.remove('hidden');
            return;
        }

        const statusColor = s => s==='Approved'?'bg-green-100 text-green-800':s==='Pending'?'bg-yellow-100 text-yellow-800':'bg-red-100 text-red-800';
        const typeIcon = t => t==='utility'?'⚡':t==='expense'?'📋':'📦';

        dd.innerHTML = results.slice(0,12).map(r=>`
            <div class="px-4 py-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-0 flex items-start gap-3">
                <span class="text-base mt-0.5">${typeIcon(r.type)}</span>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-800 truncate">${esc(r.label)}</p>
                    <p class="text-xs text-gray-400 truncate">${esc(r.sub)}</p>
                    <p class="text-[10px] text-gray-400">${esc(r.dept)}</p>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full shrink-0 ${statusColor(r.status)}">${esc(r.status)}</span>
            </div>`).join('') + (results.length>12?`<div class="px-4 py-2 text-center text-xs text-gray-400">${results.length-12} more results…</div>`:'');

        dd.classList.remove('hidden');
    }

    document.addEventListener('click', e => {
        if(!e.target.closest('#globalSearch') && !e.target.closest('#searchDropdown')){
            document.getElementById('searchDropdown').classList.add('hidden');
        }
    });

    // ─── AGING PANEL ───
    const AGING_THRESHOLD_DAYS = 3;

    function computeAgingDays(isoDate){
        if(!isoDate) return 0;
        const d = new Date(isoDate);
        return Math.floor((Date.now() - d.getTime()) / 86400000);
    }

    function openDepartmentFromNewRequest(deptName){
        const dept = (REPORT_DEPT_DATA || []).find(d => (d.name || '').toLowerCase() === (deptName || '').toLowerCase());
        if(!dept) return;

        closeNewRequestPanel();
        openDeptPanel('department', dept.name, dept.expenses || [], []);

        const card = document.querySelector(`[data-dept-card="${CSS.escape(dept.name)}"]`);
        if(card){
            card.scrollIntoView({ behavior:'smooth', block:'center' });
            card.classList.add('ring-2','ring-rose-300');
            setTimeout(()=>card.classList.remove('ring-2','ring-rose-300'), 1200);
        }
    }

    function initNewRequestBadge(){
        const count = (NEW_EXPENSE_REQUESTS || []).length;
        const btn = document.getElementById('newReqBadgeBtn');
        const badge = document.getElementById('newReqBadgeCount');
        if(btn && badge && count > 0){
            btn.classList.remove('hidden');
            btn.classList.add('flex');
            badge.textContent = count;
        }
    }

    function openNewRequestPanel(){
        const panel = document.getElementById('newReqPanel');
        const content = document.getElementById('newReqPanelContent');
        buildNewRequestPanel();
        panel.classList.remove('hidden');
        requestAnimationFrame(()=>{ content.classList.remove('translate-x-full'); content.classList.add('translate-x-0'); });
    }

    function closeNewRequestPanel(){
        const c = document.getElementById('newReqPanelContent');
        c.classList.remove('translate-x-0'); c.classList.add('translate-x-full');
        setTimeout(()=>document.getElementById('newReqPanel').classList.add('hidden'), 300);
    }

    function buildNewRequestPanel(){
        const body = document.getElementById('newReqPanelBody');
        const list = (NEW_EXPENSE_REQUESTS || []).slice().sort((a,b)=> (a.requestedAt < b.requestedAt ? 1 : -1));
        if(!list.length){ body.innerHTML = '<p class="text-gray-400 text-center py-12">No new pending requests.</p>'; return; }

        const grouped = {};
        list.forEach(r => { if(!grouped[r.department]) grouped[r.department] = []; grouped[r.department].push(r); });

        let html = `<div class="mb-4 p-3 bg-rose-50 border border-rose-200 rounded-xl text-sm text-rose-800"><strong>${list.length} new request${list.length>1?'s':''}</strong> across ${Object.keys(grouped).length} department(s).</div>`;
        Object.keys(grouped).sort().forEach(dept => {
            html += `<div class="mb-5"><h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2"><span class="w-2 h-2 bg-rose-400 rounded-full"></span>${esc(dept)} (${grouped[dept].length})</h3><div class="space-y-2">`;
            grouped[dept].forEach(r => {
                html += `<button type="button" onclick="openDepartmentFromNewRequest(decodeURIComponent('${encodeURIComponent(r.department || '')}'))" class="w-full text-left border-l-4 border-rose-300 rounded-r-xl p-4 bg-rose-50/40 hover:bg-rose-100/60 transition"><div class="flex items-start justify-between"><div class="flex-1 mr-3"><p class="text-xs font-semibold text-rose-700">${esc(r.expenseId || '')}</p><p class="text-sm font-medium text-gray-800">${esc(r.requestedBy || '')}</p><p class="text-xs text-gray-600 mt-0.5"><span class="font-semibold">Requested for:</span> ${esc(r.description || r.expenseType || 'No details provided')}</p><p class="text-[11px] text-gray-400 mt-1">${esc(r.requestedAtDisplay || '')}</p><p class="text-[11px] text-rose-700 mt-1 font-medium">Open ${esc(r.department)} requests</p></div><p class="text-sm font-bold text-gray-900 shrink-0">${fmt(Number(r.amount || 0))}</p></div></button>`;
            });
            html += '</div></div>';
        });

        body.innerHTML = html;
    }

    function initAgingBadge(){
        let agingCount = 0;
        REPORT_DEPT_DATA.forEach(dept => {
            dept.expenses.forEach(e => {
                if(e.status === 'Pending' && e.isoDate){
                    const days = computeAgingDays(e.isoDate);
                    if(days >= AGING_THRESHOLD_DAYS) agingCount++;
                }
            });
        });
        const btn = document.getElementById('agingBadgeBtn');
        const count = document.getElementById('agingBadgeCount');
        if(agingCount > 0){
            btn.classList.remove('hidden');
            count.textContent = agingCount;
        }
    }

    function openAgingPanel(){
        const panel = document.getElementById('agingPanel');
        const content = document.getElementById('agingPanelContent');
        buildAgingPanel();
        panel.classList.remove('hidden');
        requestAnimationFrame(()=>{ content.classList.remove('translate-x-full'); content.classList.add('translate-x-0'); });
    }

    function closeAgingPanel(){
        const c = document.getElementById('agingPanelContent');
        c.classList.remove('translate-x-0'); c.classList.add('translate-x-full');
        setTimeout(()=>document.getElementById('agingPanel').classList.add('hidden'), 300);
    }

    function buildAgingPanel(){
        const body = document.getElementById('agingPanelBody');
        const aging = [];
        REPORT_DEPT_DATA.forEach(dept => {
            dept.expenses.forEach(e => {
                if(e.status === 'Pending'){
                    const days = e.isoDate ? computeAgingDays(e.isoDate) : 0;
                    if(days >= AGING_THRESHOLD_DAYS){
                        aging.push({ ...e, dept:dept.name, days });
                    }
                }
            });
        });
        aging.sort((a,b) => b.days - a.days);

        if(!aging.length){ body.innerHTML='<p class="text-gray-400 text-center py-12">No aging requests found. All caught up!</p>'; return; }

        const urgencyColor = days => days >= 14?'border-red-400 bg-red-50':days >= 7?'border-orange-400 bg-orange-50':'border-amber-400 bg-amber-50';
        const urgencyText  = days => days >= 14?'text-red-700':days >= 7?'text-orange-700':'text-amber-700';
        const urgencyLabel = days => days >= 14?'Critical':'Overdue';

        let html = `<div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800">
            <strong>${aging.length} request${aging.length>1?'s':''}</strong> pending for ${AGING_THRESHOLD_DAYS}+ days across ${[...new Set(aging.map(e=>e.dept))].length} department(s).
        </div>`;

        const byDept = {};
        aging.forEach(e => { if(!byDept[e.dept]) byDept[e.dept]=[]; byDept[e.dept].push(e); });

        Object.keys(byDept).sort().forEach(dept => {
            html += `<div class="mb-5"><h3 class="text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                <span class="w-2 h-2 bg-amber-400 rounded-full"></span>${esc(dept)} (${byDept[dept].length})
            </h3><div class="space-y-2">`;
            byDept[dept].forEach(e => {
                html += `<div class="border-l-4 rounded-r-xl p-4 ${urgencyColor(e.days)}">
                    <div class="flex items-start justify-between">
                        <div class="flex-1 mr-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-xs font-bold ${urgencyText(e.days)}">${e.days} DAYS</span>
                                ${e.days>=14?`<span class="px-1.5 py-0.5 text-[10px] font-bold rounded bg-red-100 text-red-800">${urgencyLabel(e.days)}</span>`:''}
                            </div>
                            <p class="text-sm font-medium text-gray-800">${esc(e.description||e.expenseType||'')}</p>
                            <p class="text-xs text-gray-500 mt-0.5">${esc(e.requestedBy||'')} • ${esc(e.expenseType||'')}</p>
                        </div>
                        <p class="text-sm font-bold text-gray-900 shrink-0">${fmt(e.amount)}</p>
                    </div>
                </div>`;
            });
            html += '</div></div>';
        });

        body.innerHTML = html;
    }

    // ─── SUPPLIER RANKING PANEL ───
    function openSupplierPanel(){
        const panel = document.getElementById('supplierPanel');
        const content = document.getElementById('supplierPanelContent');
        buildSupplierPanel();
        panel.classList.remove('hidden');
        requestAnimationFrame(()=>{ content.classList.remove('translate-x-full'); content.classList.add('translate-x-0'); });
