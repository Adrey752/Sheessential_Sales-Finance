    function closeCapsModal() {
        const modal = document.getElementById('capsModal');
        if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
    }

    function saveCapsFromModal() {
        const caps = getCaps();
        const categories = [...new Set(UTILITY_EXPENSES.map(e => e.category))].sort();
        const allCats = categories.length ? categories : ['Electricity','Water','Internet','Gas','Phone','Cable','Waste','HVAC'];
        allCats.forEach(cat => {
            const input = document.getElementById('cap_' + cat.replace(/\s/g,'_'));
            if (!input) return;
            const val = parseFloat(input.value);
            if (val > 0) caps[cat] = val;
            else delete caps[cat];
        });
        saveCaps(caps);
        closeCapsModal();
        buildUtilitiesPanel('all');
    }

    function clearAllCaps() {
        saveCaps({});
        closeCapsModal();
        buildUtilitiesPanel('all');
    }

