                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Headcount</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Total Gross</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Cost/Head</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Net Pay</th>
                </tr></thead>
                <tbody class="divide-y divide-gray-100">`;

        depts.forEach(([name, v], i) => {
            const hc = v.headcount.size || 1;
            const costPerHead = v.totalGross / hc;
