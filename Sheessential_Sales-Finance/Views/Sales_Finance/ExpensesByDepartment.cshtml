    // ─── Utility category classifier ───
    function classifyUtility(exp) {
        const s = ((exp.expenseType||'') + ' ' + (exp.description||'')).toLowerCase();
        if (s.includes('water') || s.includes('waterworks')) return 'Water';
        if (s.includes('electric') || s.includes('meralco') || s.includes('power') || s.includes('energy') || s.includes('kwh')) return 'Electricity';
        if (s.includes('internet') || s.includes('wifi') || s.includes('wi-fi') || s.includes('broadband') || s.includes('fiber') || s.includes('globe') || s.includes('pldt') || s.includes('converge')) return 'Internet';
        if (s.includes('lpg') || s.includes('natural gas') || s.includes(' gas')) return 'Gas';
        if (s.includes('phone') || s.includes('telephone') || s.includes('landline') || s.includes('mobile bill')) return 'Phone';
        if (s.includes('cable') || s.includes('skycable') || s.includes('cignal')) return 'Cable';
        if (s.includes('waste') || s.includes('garbage') || s.includes('trash') || s.includes('sewage') || s.includes('sanitation') || s.includes('disposal')) return 'Waste';
        if (s.includes('cooling') || s.includes('heating') || s.includes('hvac') || s.includes('aircon') || s.includes('air conditioning') || s.includes('ventilation')) return 'HVAC';
        return 'Other Utilities';
    }

    UTILITY_EXPENSES.forEach(e => { e.category = classifyUtility(e); });

    // ─── UTILITIES PANEL ───
    // ─── UTILITY BUDGET CAPS ───
    const CAPS_KEY = 'sheessential_utility_caps';

    function getCaps() {
        try { return JSON.parse(localStorage.getItem(CAPS_KEY) || '{}'); } catch(e) { return {}; }
    }
    function saveCaps(caps) {
        localStorage.setItem(CAPS_KEY, JSON.stringify(caps));
    }

