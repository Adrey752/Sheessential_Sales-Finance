        const caps = getCaps();
        const categories = [...new Set(UTILITY_EXPENSES.map(e => e.category))].sort();
        const allCats = categories.length ? categories : ['Electricity','Water','Internet','Gas','Phone','Cable','Waste','HVAC'];

        let fields = allCats.map(cat => {
            const icon = UTIL_ICONS[cat] || '🔌';
            const color = UTIL_PALETTE[cat] || '#9ca3af';
            const cap = caps[cat] || '';
            return `
            <div class="flex items-center gap-3 py-3 border-b border-gray-100 last:border-0">
                <span class="text-xl w-8 text-center">${icon}</span>
                <span class="text-sm font-semibold text-gray-800 w-28 shrink-0">${esc(cat)}</span>
                <div class="flex-1 relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm font-medium">₱</span>
                    <input type="number" min="0" step="100"
                        id="cap_${cat.replace(/\s/g,'_')}"
                        value="${cap}"
                        placeholder="No cap"
                        class="w-full pl-7 pr-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-cyan-300 text-gray-800" />
                </div>
                <button onclick="document.getElementById('cap_${cat.replace(/\s/g,'_')}').value=''" class="text-gray-300 hover:text-red-400 transition text-xs px-2 py-1 rounded-lg hover:bg-red-50">Clear</button>
            </div>`;
        }).join('');

        // Insert modal if not exists
        let modal = document.getElementById('capsModal');
        if (!modal) {
            modal = document.createElement('div');
            modal.id = 'capsModal';
            modal.className = 'fixed inset-0 bg-black/50 hidden flex items-center justify-center z-[80] backdrop-blur-sm';
            document.body.appendChild(modal);
        }
        modal.innerHTML = `
            <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl m-4 max-h-[90vh] flex flex-col">
                <div class="p-5 border-b border-gray-100 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-gray-900">Budget Caps</h3>
                        <p class="text-xs text-gray-500 mt-0.5">Set monthly spending limits per utility type</p>
                    </div>
                    <button onclick="closeCapsModal()" class="text-gray-400 hover:text-gray-600 p-2 rounded-lg hover:bg-gray-100">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                <div class="flex-1 overflow-y-auto px-5 py-2">${fields}</div>
                <div class="p-5 border-t border-gray-100 flex gap-3 justify-end">
                    <button onclick="clearAllCaps()" class="px-4 py-2 text-sm font-medium text-red-600 bg-red-50 rounded-xl hover:bg-red-100 transition">Clear All</button>
                    <button onclick="saveCapsFromModal()" class="px-5 py-2 text-sm font-medium text-white bg-cyan-600 rounded-xl hover:bg-cyan-700 transition">Save Caps</button>
                </div>
            </div>`;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
