    // ─── Helpers ───
    const RPALETTE    = ['#4f46e5','#10b981','#f59e0b','#ef4444','#8b5cf6','#06b6d4','#f97316','#ec4899','#14b8a6','#f43f5e'];
    const UTIL_PALETTE = { Electricity:'#f59e0b', Water:'#06b6d4', Internet:'#6366f1', Gas:'#f97316', Phone:'#8b5cf6', Cable:'#ec4899', Waste:'#6b7280', HVAC:'#14b8a6', 'Other Utilities':'#9ca3af' };
    const RSTATUS_COLORS = { Approved:'#10b981', Pending:'#f59e0b', Declined:'#ef4444' };
    const UTIL_ICONS = { Electricity:'⚡', Water:'💧', Internet:'📶', Gas:'🔥', Phone:'📞', Cable:'📺', Waste:'🗑️', HVAC:'❄️', 'Other Utilities':'🔌' };

    let rCharts = {}, cmpCharts = {};
    let rActiveTab = 'overview', cmpActiveTab = 'monthly';
    let rSelectedPayrollCutoffId = null;

    function fmt(n){ return '\u20B1'+n.toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function esc(s){ if(!s)return ''; const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
    function pctChange(a,b){ if(!a) return b>0?'+100%':'—'; const p=((b-a)/a*100).toFixed(1); return (p>0?'+':'')+p+'%'; }
    function trendColor(a,b){ return b>a?'text-red-600':b<a?'text-green-600':'text-gray-500'; }

    // --- Quick Add Expense modal (same behavior as Expenses page) ---
    const OPEX_CATEGORIES = ['Office Supplies','Maintenance','Software Subscription','Equipment Purchases'];
    const WEBSITE_CATEGORIES = ['Hosting Services','Domain Renewal','Website Maintenance','Security and Backup'];
    const FINANCE_CATEGORIES = ['Bank Charges','Audit & Compliance','Tax & Government Fees','Financial Services'];

    function getExpenseCategoriesByDepartment(dept){
        const base = [...OPEX_CATEGORIES];
        if((dept||'').toLowerCase()==='finance') base.push(...FINANCE_CATEGORIES);
        if((dept||'').toLowerCase()==='website') base.push(...WEBSITE_CATEGORIES);
        return [...new Set(base)];
    }

    function renderQuickExpenseCategories(){
        const deptSel = document.getElementById('quickDepartment');
        const typeSel = document.getElementById('quickExpenseType');
        const other = document.getElementById('quickExpenseTypeOther');
