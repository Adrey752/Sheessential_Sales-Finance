<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>

<script>
    // ─── Data from Razor ───
    const REPORT_DEPT_DATA   = @Html.Raw(JsonConvert.SerializeObject(deptDataForReport));
    const UTILITY_EXPENSES   = @Html.Raw(JsonConvert.SerializeObject(utilityExpensesJson));
    const ALL_EXPENSES_CMP   = @Html.Raw(JsonConvert.SerializeObject(allExpensesForCompare));
    const availableBalance   = @currentBalance;

    // Additional datasets for new panels
    window.STOCK_REQUESTS_DATA = @Html.Raw(JsonConvert.SerializeObject(stockRequestsJson));
    window.PAYROLL_DEPT_DATA   = @Html.Raw(JsonConvert.SerializeObject(payrollCutoffs));

    // ─── Helpers ───
    const RPALETTE    = ['#4f46e5','#10b981','#f59e0b','#ef4444','#8b5cf6','#06b6d4','#f97316','#ec4899','#14b8a6','#f43f5e'];
    const UTIL_PALETTE = { Electricity:'#f59e0b', Water:'#06b6d4', Internet:'#6366f1', Gas:'#f97316', Phone:'#8b5cf6', Cable:'#ec4899', Waste:'#6b7280', HVAC:'#14b8a6', 'Other Utilities':'#9ca3af' };
    const RSTATUS_COLORS = { Approved:'#10b981', Pending:'#f59e0b', Declined:'#ef4444' };
    const UTIL_ICONS = { Electricity:'⚡', Water:'💧', Internet:'📶', Gas:'🔥', Phone:'📞', Cable:'📺', Waste:'🗑️', HVAC:'❄️', 'Other Utilities':'🔌' };

    let rCharts = {}, cmpCharts = {};
    let rActiveTab = 'overview', cmpActiveTab = 'monthly';

    function fmt(n){ return '₱'+n.toLocaleString('en-PH',{minimumFractionDigits:2,maximumFractionDigits:2}); }
    function esc(s){ if(!s)return ''; const d=document.createElement('div'); d.textContent=s; return d.innerHTML; }
    function pctChange(a,b){ if(!a) return b>0?'+100%':'—'; const p=((b-a)/a*100).toFixed(1); return (p>0?'+':'')+p+'%'; }
    function trendColor(a,b){ return b>a?'text-red-600':b<a?'text-green-600':'text-gray-500'; }

    // ─── Utility category classifier ───
    function classifyUtility(exp) {
        const s = ((exp.expenseType||'') + ' ' + (exp.description||'')).toLowerCase();
        if (s.includes('water')) return 'Water';
        if (s.includes('electric') || s.includes('power') || s.includes('energy')) return 'Electricity';
        if (s.includes('internet') || s.includes('wifi') || s.includes('wi-fi')) return 'Internet';
        if (s.includes('gas')) return 'Gas';
        if (s.includes('phone') || s.includes('telephone')) return 'Phone';
        if (s.includes('cable')) return 'Cable';
        if (s.includes('waste') || s.includes('garbage') || s.includes('trash') || s.includes('sewage')) return 'Waste';
        if (s.includes('cooling') || s.includes('heating') || s.includes('hvac')) return 'HVAC';
        return 'Other Utilities';
    }

    // Classify each utility expense
    UTILITY_EXPENSES.forEach(e => { e.category = classifyUtility(e); });

    // ─── UTILITIES PANEL ───
    function openUtilitiesPanel() {
        const panel = document.getElementById('utilitiesPanel');
        const content = document.getElementById('utilitiesPanelContent');
        buildUtilitiesPanel('all');
        panel.classList.remove('hidden');
        requestAnimationFrame(() => { content.classList.remove('translate-x-full'); content.classList.add('translate-x-0'); });
    }

    function closeUtilitiesPanel() {
        const c = document.getElementById('utilitiesPanelContent');
        c.classList.remove('translate-x-0'); c.classList.add('translate-x-full');
        setTimeout(() => document.getElementById('utilitiesPanel').classList.add('hidden'), 300);
    }

    function buildUtilitiesPanel(filterCat) {
        const categories = [...new Set(UTILITY_EXPENSES.map(e => e.category))].sort();
        const all = filterCat === 'all' ? UTILITY_EXPENSES : UTILITY_EXPENSES.filter(e => e.category === filterCat);

        // Build type filter tabs
        const tabsEl = document.getElementById('utilityTypeTabs');
        const tabs = [{ key:'all', label:'All' }, ...categories.map(c => ({ key:c, label:(UTIL_ICONS[c]||'🔌')+' '+c }))];
        tabsEl.innerHTML = tabs.map(t => `
            <button onclick="buildUtilitiesPanel('${t.key}')"
                class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${t.key===filterCat?'bg-white shadow text-cyan-700':'text-cyan-600 hover:text-cyan-800'}">
                ${esc(t.label)}
            </button>`).join('');

        // Update subtitle
        document.getElementById('utilitiesPanelSubtitle').textContent =
            filterCat === 'all' ? `${UTILITY_EXPENSES.length} expense(s) across ${categories.length} category/ies` : `${all.length} ${filterCat} expense(s)`;

        const body = document.getElementById('utilitiesPanelBody');
        if (!all.length) { body.innerHTML = '<p class="text-gray-400 text-center py-12">No utility expenses found for this category.</p>'; return; }

        const total    = all.reduce((s,e)=>s+e.amount, 0);
        const approved = all.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount, 0);
        const pending  = all.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount, 0);
        const declined = all.filter(e=>e.status==='Declined').reduce((s,e)=>s+e.amount, 0);

        // Group by category for display
        const byCat = {};
        all.forEach(e => { if(!byCat[e.category]) byCat[e.category]=[]; byCat[e.category].push(e); });
        const sortedCats = Object.keys(byCat).sort((a,b) => byCat[b].reduce((s,e)=>s+e.amount,0) - byCat[a].reduce((s,e)=>s+e.amount,0));

        let html = `
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            <div class="bg-cyan-50 rounded-xl p-3 border border-cyan-100"><p class="text-xs text-cyan-600 font-medium">Total</p><p class="text-lg font-bold text-cyan-700">${fmt(total)}</p></div>
            <div class="bg-green-50 rounded-xl p-3 border border-green-100"><p class="text-xs text-green-600 font-medium">Approved</p><p class="text-lg font-bold text-green-700">${fmt(approved)}</p></div>
            <div class="bg-yellow-50 rounded-xl p-3 border border-yellow-100"><p class="text-xs text-yellow-600 font-medium">Pending</p><p class="text-lg font-bold text-yellow-700">${fmt(pending)}</p></div>
            <div class="bg-red-50 rounded-xl p-3 border border-red-100"><p class="text-xs text-red-600 font-medium">Declined</p><p class="text-lg font-bold text-red-700">${fmt(declined)}</p></div>
        </div>`;

        sortedCats.forEach(cat => {
            const items = byCat[cat];
            const catTotal = items.reduce((s,e)=>s+e.amount, 0);
            const color = UTIL_PALETTE[cat] || '#9ca3af';
            const icon  = UTIL_ICONS[cat] || '🔌';

            html += `<div class="mb-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                        <span class="text-base">${icon}</span>
                        ${esc(cat)} <span class="text-gray-400 font-normal">(${items.length})</span>
                    </h3>
                    <span class="text-sm font-bold" style="color:${color}">${fmt(catTotal)}</span>
                </div>
                <div class="space-y-2">`;

            // Sort by amount desc
            items.sort((a,b) => b.amount - a.amount).forEach(exp => {
                const badge = exp.status==='Pending'
                    ? '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>'
                    : exp.status==='Approved'
                        ? '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800">✓ Approved</span>'
                        : '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-red-100 text-red-800">✕ Declined</span>';
                const notes = exp.status==='Declined'&&exp.notes
                    ? `<p class="text-[11px] text-red-600 mt-1">Reason: ${esc(exp.notes)}</p>` : '';
                html += `
                <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <div class="flex items-start justify-between">
                        <div class="flex-1 mr-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-xs font-semibold text-cyan-600">${esc(exp.expenseId||'—')}</span>${badge}
                                <span class="text-[11px] text-gray-400">${esc(exp.department)}</span>
                            </div>
                            <p class="text-sm font-medium text-gray-800">${esc(exp.requestedBy||'')}</p>
                            <p class="text-xs text-gray-400 mt-0.5">${esc(exp.description||exp.expenseType||'')}</p>
                            <p class="text-[11px] text-gray-400 mt-1">${esc(exp.requestedAtDisplay)}</p>
                            ${notes}
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-sm font-bold text-gray-900">${fmt(exp.amount)}</p>
                        </div>
                    </div>
                </div>`;
            });

            html += `</div></div>`;
        });

        body.innerHTML = html;
    }

    // ─── UTILITIES COMPARISON MODAL ───
    function openUtilitiesComparison() {
        const modal = document.getElementById('utilitiesCompareModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        populateCmpFilters();
        renderCmpActive();
    }

    function closeUtilitiesComparison() {
        const modal = document.getElementById('utilitiesCompareModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        Object.values(cmpCharts).forEach(c => { try { c.destroy(); } catch(e){} });
        cmpCharts = {};
    }

    function populateCmpFilters() {
        // Categories
        const cats = [...new Set(UTILITY_EXPENSES.map(e => e.category))].sort();
        const catSel = document.getElementById('cmpFilterCat');
        catSel.innerHTML = '<option value="all">All Categories</option>' +
            cats.map(c => `<option value="${esc(c)}">${UTIL_ICONS[c]||'🔌'} ${esc(c)}</option>`).join('');

        // Departments
        const depts = [...new Set(UTILITY_EXPENSES.map(e => e.department))].sort();
        const deptSel = document.getElementById('cmpFilterDept');
        deptSel.innerHTML = '<option value="all">All Departments</option>' +
            depts.map(d => `<option value="${esc(d)}">${esc(d)}</option>`).join('');

        // Months for period selectors
        const months = [...new Set(UTILITY_EXPENSES.map(e => e.month))].sort().reverse();
        ['cmpPeriodA','cmpPeriodB'].forEach((id,i) => {
            document.getElementById(id).innerHTML = months.map((m,mi) => {
                const label = UTILITY_EXPENSES.find(e=>e.month===m)?.monthLabel || m;
                const sel = mi === i ? 'selected' : '';
                return `<option value="${m}" ${sel}>${label}</option>`;
            }).join('');
        });
    }

    function cmpFilteredExpenses() {
        const cat  = document.getElementById('cmpFilterCat').value;
        const st   = document.getElementById('cmpFilterStatus').value;
        const dept = document.getElementById('cmpFilterDept').value;
        return UTILITY_EXPENSES.filter(e =>
            (cat  === 'all' || e.category   === cat)  &&
            (st   === 'all' || e.status     === st)   &&
            (dept === 'all' || e.department === dept)
        );
    }

    function renderCmpActive() {
        const data = cmpFilteredExpenses();
        buildCmpKpiStrip(data);
        if      (cmpActiveTab==='monthly')    renderCmpMonthly(data);
        else if (cmpActiveTab==='period')     renderCmpPeriod(data);
        else if (cmpActiveTab==='category')   renderCmpCategory(data);
        else if (cmpActiveTab==='department') renderCmpDepartment(data);
        else if (cmpActiveTab==='status')     renderCmpStatus(data);
        else if (cmpActiveTab==='yoy')        renderCmpYoY(data);
    }

    function switchCmpTab(tab, btn) {
        cmpActiveTab = tab;
        ['monthly','period','category','department','status','yoy'].forEach(t => {
            document.getElementById('cmpTab-'+t).className =
                'flex-1 min-w-[120px] px-3 py-2 rounded-lg text-sm font-medium transition-all ' +
                (t===tab?'bg-white shadow text-cyan-600':'text-gray-500 hover:text-gray-700');
            document.getElementById('cmpPanel-'+t).style.display = t===tab?'block':'none';
        });
        // Show/hide period selectors
        document.getElementById('periodSelectors').classList.toggle('hidden', tab!=='period');
        document.getElementById('periodSelectors').classList.toggle('flex', tab==='period');
        renderCmpActive();
    }

    function buildCmpKpiStrip(data) {
        const total = data.reduce((s,e)=>s+e.amount,0);
        const cats  = [...new Set(data.map(e=>e.category))].length;
        const months = [...new Set(data.map(e=>e.month))].length;
        const approved = data.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount,0);
        const appRate  = data.length ? Math.round(data.filter(e=>e.status==='Approved').length/data.length*100) : 0;
        document.getElementById('cmpKpiStrip').innerHTML = `
            <div class="bg-cyan-50 rounded-xl p-3 border border-cyan-100">
                <p class="text-[11px] text-cyan-600 font-medium uppercase tracking-wider">Total</p>
                <p class="text-lg font-bold text-cyan-700">${fmt(total)}</p>
                <p class="text-[11px] text-cyan-400">${data.length} request(s)</p>
            </div>
            <div class="bg-green-50 rounded-xl p-3 border border-green-100">
                <p class="text-[11px] text-green-600 font-medium uppercase tracking-wider">Approved</p>
                <p class="text-lg font-bold text-green-700">${fmt(approved)}</p>
                <p class="text-[11px] text-green-400">${appRate}% approval rate</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                <p class="text-[11px] text-gray-500 font-medium uppercase tracking-wider">Categories</p>
                <p class="text-lg font-bold text-gray-700">${cats}</p>
                <p class="text-[11px] text-gray-400">utility type(s)</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                <p class="text-[11px] text-gray-500 font-medium uppercase tracking-wider">Months</p>
                <p class="text-lg font-bold text-gray-700">${months}</p>
                <p class="text-[11px] text-gray-400">with data</p>
            </div>`;
    }

    function cmpDestroyChart(id) {
        if(cmpCharts[id]){ try{ cmpCharts[id].destroy(); }catch(e){} delete cmpCharts[id]; }
    }

    // ── CMP: Monthly Trend ──
    function renderCmpMonthly(data) {
        const monthMap = {};
        data.forEach(e => { if(!monthMap[e.month]) monthMap[e.month]={ label:e.monthLabel, total:0, approved:0, pending:0, declined:0 }; monthMap[e.month].total+=e.amount; if(e.status==='Approved')monthMap[e.month].approved+=e.amount; if(e.status==='Pending')monthMap[e.month].pending+=e.amount; if(e.status==='Declined')monthMap[e.month].declined+=e.amount; });
        const months = Object.keys(monthMap).sort();
        const labels = months.map(m=>monthMap[m].label);
        cmpDestroyChart('cmpMonthlyChart');

        // Build month-over-month comparison table
        let tableRows = '';
        months.forEach((m,i) => {
            const curr = monthMap[m].total;
            const prev = i>0 ? monthMap[months[i-1]].total : null;
            const pct  = prev!==null ? pctChange(prev,curr) : '—';
            const color = prev!==null ? trendColor(prev,curr) : 'text-gray-400';
            tableRows += `<tr class="hover:bg-gray-50"><td class="px-3 py-2 text-sm font-medium text-gray-800">${esc(monthMap[m].label)}</td><td class="px-3 py-2 text-sm font-bold text-cyan-700">${fmt(curr)}</td><td class="px-3 py-2 text-sm text-green-700">${fmt(monthMap[m].approved)}</td><td class="px-3 py-2 text-sm text-yellow-700">${fmt(monthMap[m].pending)}</td><td class="px-3 py-2 text-sm text-red-700">${fmt(monthMap[m].declined)}</td><td class="px-3 py-2 text-sm font-semibold ${color}">${pct}</td></tr>`;
        });

        const h = Math.max(220, months.length * 32 + 80);
        document.getElementById('cmpPanel-monthly').innerHTML = `
            <div style="position:relative;width:100%;height:${h}px;margin-bottom:20px"><canvas id="cmpMonthlyChart"></canvas></div>
            <div class="overflow-x-auto rounded-xl border border-gray-200 mt-4">
                <table class="w-full text-sm border-collapse">
                    <thead><tr class="bg-gray-50 border-b border-gray-200">
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Month</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Approved</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Pending</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Declined</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">vs Prev Month</th>
                    </tr></thead>
                    <tbody class="divide-y divide-gray-100">${tableRows}</tbody>
                </table>
            </div>`;

        if (!months.length) { document.getElementById('cmpPanel-monthly').innerHTML = '<p class="text-gray-400 text-center py-8">No monthly data available.</p>'; return; }
        cmpCharts['cmpMonthlyChart'] = new Chart(document.getElementById('cmpMonthlyChart').getContext('2d'), {
            type: 'bar',
            data: { labels, datasets: [
                { label:'Approved', data:months.map(m=>monthMap[m].approved), backgroundColor:'#10b98155', borderColor:'#10b981', borderWidth:1.5, borderRadius:4, borderSkipped:false },
                { label:'Pending',  data:months.map(m=>monthMap[m].pending),  backgroundColor:'#f59e0b55', borderColor:'#f59e0b', borderWidth:1.5, borderRadius:4, borderSkipped:false },
                { label:'Declined', data:months.map(m=>monthMap[m].declined), backgroundColor:'#ef444455', borderColor:'#ef4444', borderWidth:1.5, borderRadius:4, borderSkipped:false },
            ]},
            options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:true, position:'top', labels:{ boxWidth:12, font:{size:11} } }, tooltip:{ callbacks:{ label:c=>' '+fmt(c.raw) } } }, scales:{ x:{ grid:{color:'rgba(0,0,0,.04)'}, ticks:{font:{size:11}}, stacked:true }, y:{ grid:{color:'rgba(0,0,0,.04)'}, ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}, stacked:true } } }
        });
    }

    // ── CMP: Period vs Period ──
    function renderCmpPeriod(data) {
        const mA = document.getElementById('cmpPeriodA').value;
        const mB = document.getElementById('cmpPeriodB').value;
        const dA = data.filter(e=>e.month===mA);
        const dB = data.filter(e=>e.month===mB);
        const labelA = UTILITY_EXPENSES.find(e=>e.month===mA)?.monthLabel || mA;
        const labelB = UTILITY_EXPENSES.find(e=>e.month===mB)?.monthLabel || mB;

        const cats = [...new Set([...dA,...dB].map(e=>e.category))].sort();
        const totA = dA.reduce((s,e)=>s+e.amount,0);
        const totB = dB.reduce((s,e)=>s+e.amount,0);
        const diff = totB - totA;
        const diffPct = pctChange(totA, totB);
        const diffColor = diff>0?'text-red-600':diff<0?'text-green-600':'text-gray-500';

        cmpDestroyChart('cmpPeriodChart');

        let rows = '';
        cats.forEach(c => {
            const a = dA.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0);
            const b = dB.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0);
            const d = b-a; const dc = pctChange(a,b); const tcl = trendColor(a,b);
            rows += `<tr class="hover:bg-gray-50"><td class="px-3 py-2 text-sm">${UTIL_ICONS[c]||'🔌'} ${esc(c)}</td><td class="px-3 py-2 text-sm font-semibold text-cyan-700">${fmt(a)}</td><td class="px-3 py-2 text-sm font-semibold text-orange-600">${fmt(b)}</td><td class="px-3 py-2 text-sm font-semibold ${tcl}">${dc}</td><td class="px-3 py-2 text-sm ${d>0?'text-red-600':d<0?'text-green-600':'text-gray-500'}">${d>=0?'+':''}${fmt(d)}</td></tr>`;
        });

        document.getElementById('cmpPanel-period').innerHTML = `
            <div class="grid grid-cols-3 gap-4 mb-5">
                <div class="bg-cyan-50 rounded-xl p-4 border border-cyan-100 text-center">
                    <p class="text-xs text-cyan-600 font-semibold mb-1">${esc(labelA)}</p>
                    <p class="text-xl font-bold text-cyan-700">${fmt(totA)}</p>
                    <p class="text-xs text-cyan-400">${dA.length} request(s)</p>
                </div>
                <div class="flex flex-col items-center justify-center">
                    <p class="text-2xl font-bold ${diffColor}">${diffPct}</p>
                    <p class="text-xs text-gray-400 mt-1">${diff>=0?'increase':'decrease'}</p>
                    <p class="text-xs font-semibold ${diffColor}">${diff>=0?'+':''}${fmt(diff)}</p>
                </div>
                <div class="bg-orange-50 rounded-xl p-4 border border-orange-100 text-center">
                    <p class="text-xs text-orange-600 font-semibold mb-1">${esc(labelB)}</p>
                    <p class="text-xl font-bold text-orange-600">${fmt(totB)}</p>
                    <p class="text-xs text-orange-400">${dB.length} request(s)</p>
                </div>
            </div>
            <div style="position:relative;width:100%;height:${Math.max(220,cats.length*48+80)}px;margin-bottom:20px"><canvas id="cmpPeriodChart"></canvas></div>
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-sm border-collapse">
                    <thead><tr class="bg-gray-50 border-b border-gray-200">
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Category</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-cyan-600 uppercase">${esc(labelA)}</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-orange-600 uppercase">${esc(labelB)}</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Change %</th>
                        <th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Diff</th>
                    </tr></thead>
                    <tbody class="divide-y divide-gray-100">${rows}</tbody>
                </table>
            </div>`;

        if (cats.length) {
            cmpCharts['cmpPeriodChart'] = new Chart(document.getElementById('cmpPeriodChart').getContext('2d'), {
                type:'bar', indexAxis:'y',
                data:{ labels:cats.map(c=>(UTIL_ICONS[c]||'🔌')+' '+c), datasets:[
                    { label:labelA, data:cats.map(c=>dA.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0)), backgroundColor:'#06b6d455', borderColor:'#06b6d4', borderWidth:1.5, borderRadius:4, borderSkipped:false },
                    { label:labelB, data:cats.map(c=>dB.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0)), backgroundColor:'#f9731655', borderColor:'#f97316', borderWidth:1.5, borderRadius:4, borderSkipped:false },
                ]},
                options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:true,position:'top',labels:{boxWidth:12,font:{size:11}}}, tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}} }, scales:{ x:{grid:{color:'rgba(0,0,0,.04)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}}, y:{grid:{display:false},ticks:{font:{size:11}}} } }
            });
        }
    }

    // ── CMP: By Category ──
    function renderCmpCategory(data) {
        const catMap = {};
        data.forEach(e=>{ if(!catMap[e.category])catMap[e.category]={total:0,approved:0,pending:0,declined:0,count:0}; catMap[e.category].total+=e.amount; catMap[e.category].count++; if(e.status==='Approved')catMap[e.category].approved+=e.amount; if(e.status==='Pending')catMap[e.category].pending+=e.amount; if(e.status==='Declined')catMap[e.category].declined+=e.amount; });
        const cats = Object.keys(catMap).sort((a,b)=>catMap[b].total-catMap[a].total);
        const grandTotal = cats.reduce((s,c)=>s+catMap[c].total,0);

        cmpDestroyChart('cmpCatChart'); cmpDestroyChart('cmpCatDonut');

        let rows = cats.map(c=>{
            const d=catMap[c]; const pct=grandTotal?Math.round(d.total/grandTotal*100):0;
            const color=UTIL_PALETTE[c]||'#9ca3af';
            return `<tr class="hover:bg-gray-50"><td class="px-3 py-2 text-sm">${UTIL_ICONS[c]||'🔌'} ${esc(c)}</td><td class="px-3 py-2 text-sm font-bold" style="color:${color}">${fmt(d.total)}</td><td class="px-3 py-2"><div class="h-1.5 bg-gray-200 rounded-full w-24"><div class="h-1.5 rounded-full" style="width:${pct}%;background:${color}"></div></div></td><td class="px-3 py-2 text-sm text-gray-500">${pct}%</td><td class="px-3 py-2 text-sm text-green-700">${fmt(d.approved)}</td><td class="px-3 py-2 text-sm text-yellow-700">${fmt(d.pending)}</td><td class="px-3 py-2 text-sm text-red-700">${fmt(d.declined)}</td><td class="px-3 py-2 text-sm text-gray-500">${d.count}</td></tr>`;
        }).join('');

        document.getElementById('cmpPanel-category').innerHTML = `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-6">
                <div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Amount by category</p><div style="position:relative;width:100%;height:${Math.max(180,cats.length*36+60)}px"><canvas id="cmpCatChart"></canvas></div></div>
                <div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Share breakdown</p><div style="position:relative;width:100%;height:220px"><canvas id="cmpCatDonut"></canvas></div></div>
            </div>
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-sm border-collapse">
                    <thead><tr class="bg-gray-50 border-b border-gray-200"><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Category</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Total</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Share bar</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">%</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Approved</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Pending</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Declined</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Count</th></tr></thead>
                    <tbody class="divide-y divide-gray-100">${rows}</tbody>
                </table>
            </div>`;

        if (cats.length) {
            const colors = cats.map(c=>UTIL_PALETTE[c]||'#9ca3af');
            cmpCharts['cmpCatChart'] = new Chart(document.getElementById('cmpCatChart').getContext('2d'),{ type:'bar', indexAxis:'y', data:{ labels:cats.map(c=>(UTIL_ICONS[c]||'🔌')+' '+c), datasets:[{ label:'Total', data:cats.map(c=>catMap[c].total), backgroundColor:colors.map(c=>c+'cc'), borderColor:colors, borderWidth:1.5, borderRadius:6, borderSkipped:false }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}} }, scales:{ x:{grid:{color:'rgba(0,0,0,.04)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}}, y:{grid:{display:false},ticks:{font:{size:11}}} } } });
            cmpCharts['cmpCatDonut'] = new Chart(document.getElementById('cmpCatDonut').getContext('2d'),{ type:'doughnut', data:{ labels:cats, datasets:[{ data:cats.map(c=>catMap[c].total), backgroundColor:colors, borderWidth:2, borderColor:'#fff', hoverOffset:4 }] }, options:{ responsive:true, maintainAspectRatio:false, cutout:'60%', plugins:{ legend:{ display:true, position:'right', labels:{ boxWidth:10, font:{size:10} } }, tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}} } } });
        }
    }

    // ── CMP: By Department ──
    function renderCmpDepartment(data) {
        const deptMap = {};
        data.forEach(e=>{ if(!deptMap[e.department])deptMap[e.department]={total:0,approved:0,pending:0,declined:0,count:0,cats:{}}; deptMap[e.department].total+=e.amount; deptMap[e.department].count++; if(e.status==='Approved')deptMap[e.department].approved+=e.amount; if(e.status==='Pending')deptMap[e.department].pending+=e.amount; if(e.status==='Declined')deptMap[e.department].declined+=e.amount; if(!deptMap[e.department].cats[e.category])deptMap[e.department].cats[e.category]=0; deptMap[e.department].cats[e.category]+=e.amount; });
        const depts = Object.keys(deptMap).sort((a,b)=>deptMap[b].total-deptMap[a].total);
        cmpDestroyChart('cmpDeptChart');

        let rows = depts.map((d,i)=>{
            const v=deptMap[d]; const color=RPALETTE[i%RPALETTE.length];
            const topCat = Object.entries(v.cats).sort((a,b)=>b[1]-a[1])[0];
            return `<tr class="hover:bg-gray-50"><td class="px-3 py-2 text-sm font-medium text-gray-800">${esc(d)}</td><td class="px-3 py-2 text-sm font-bold" style="color:${color}">${fmt(v.total)}</td><td class="px-3 py-2 text-sm text-green-700">${fmt(v.approved)}</td><td class="px-3 py-2 text-sm text-yellow-700">${fmt(v.pending)}</td><td class="px-3 py-2 text-sm text-red-700">${fmt(v.declined)}</td><td class="px-3 py-2 text-sm text-gray-500">${topCat?`${UTIL_ICONS[topCat[0]]||'🔌'} ${esc(topCat[0])}`:'-'}</td><td class="px-3 py-2 text-sm text-gray-500">${v.count}</td></tr>`;
        }).join('');

        const h = Math.max(220, depts.length*48+80);
        document.getElementById('cmpPanel-department').innerHTML = `
            <div style="position:relative;width:100%;height:${h}px;margin-bottom:20px"><canvas id="cmpDeptChart"></canvas></div>
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-sm border-collapse">
                    <thead><tr class="bg-gray-50 border-b border-gray-200"><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Department</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Total</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Approved</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Pending</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Declined</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Top Category</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Count</th></tr></thead>
                    <tbody class="divide-y divide-gray-100">${rows}</tbody>
                </table>
            </div>`;

        if (depts.length) {
            const colors = depts.map((_,i)=>RPALETTE[i%RPALETTE.length]);
            cmpCharts['cmpDeptChart'] = new Chart(document.getElementById('cmpDeptChart').getContext('2d'),{ type:'bar', indexAxis:'y', data:{ labels:depts, datasets:[{ label:'Total', data:depts.map(d=>deptMap[d].total), backgroundColor:colors.map(c=>c+'cc'), borderColor:colors, borderWidth:1.5, borderRadius:6, borderSkipped:false }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}} }, scales:{ x:{grid:{color:'rgba(0,0,0,.04)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}}, y:{grid:{display:false},ticks:{font:{size:11}}} } } });
        }
    }

    // ── CMP: By Status ──
    function renderCmpStatus(data) {
        const statuses = ['Approved','Pending','Declined'];
        const amounts = statuses.map(s=>data.filter(e=>e.status===s).reduce((sum,e)=>sum+e.amount,0));
        const counts  = statuses.map(s=>data.filter(e=>e.status===s).length);
        const total   = amounts.reduce((s,a)=>s+a,0);
        cmpDestroyChart('cmpStatusChart');

        // By category + status stacked
        const cats = [...new Set(data.map(e=>e.category))].sort();
        const stackColors = { Approved:'#10b981', Pending:'#f59e0b', Declined:'#ef4444' };

        let rows = statuses.map((s,i)=>{
            const pct = total ? Math.round(amounts[i]/total*100) : 0;
            const bg  = i===0?'bg-green-50 border-green-100':i===1?'bg-yellow-50 border-yellow-100':'bg-red-50 border-red-100';
            const tc  = i===0?'text-green-700':i===1?'text-yellow-700':'text-red-700';
            return `<div class="${bg} border rounded-xl p-4">
                <p class="text-xs font-semibold ${tc} uppercase tracking-wider">${s}</p>
                <p class="text-xl font-bold ${tc}">${fmt(amounts[i])}</p>
                <p class="text-xs ${tc} opacity-70">${counts[i]} request(s) · ${pct}% of total</p>
            </div>`;
        }).join('');

        let tableRows = cats.map(c=>{
            const app=data.filter(e=>e.category===c&&e.status==='Approved').reduce((s,e)=>s+e.amount,0);
            const pen=data.filter(e=>e.category===c&&e.status==='Pending').reduce((s,e)=>s+e.amount,0);
            const dec=data.filter(e=>e.category===c&&e.status==='Declined').reduce((s,e)=>s+e.amount,0);
            const tot=app+pen+dec;
            const appPct=tot?Math.round(app/tot*100):0;
            return `<tr class="hover:bg-gray-50"><td class="px-3 py-2 text-sm">${UTIL_ICONS[c]||'🔌'} ${esc(c)}</td><td class="px-3 py-2 text-sm font-bold text-gray-800">${fmt(tot)}</td><td class="px-3 py-2 text-sm text-green-700">${fmt(app)}</td><td class="px-3 py-2 text-sm text-yellow-700">${fmt(pen)}</td><td class="px-3 py-2 text-sm text-red-700">${fmt(dec)}</td><td class="px-3 py-2"><div class="h-1.5 bg-gray-200 rounded-full w-20"><div class="h-1.5 rounded-full bg-green-500" style="width:${appPct}%"></div></div></td></tr>`;
        }).join('');

        document.getElementById('cmpPanel-status').innerHTML = `
            <div class="grid grid-cols-3 gap-4 mb-5">${rows}</div>
            <div style="position:relative;width:100%;height:${Math.max(200,cats.length*36+80)}px;margin-bottom:20px"><canvas id="cmpStatusChart"></canvas></div>
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-sm border-collapse">
                    <thead><tr class="bg-gray-50 border-b border-gray-200"><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Category</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Total</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Approved</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Pending</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Declined</th><th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Approval %</th></tr></thead>
                    <tbody class="divide-y divide-gray-100">${tableRows}</tbody>
                </table>
            </div>`;

        if (cats.length) {
            cmpCharts['cmpStatusChart'] = new Chart(document.getElementById('cmpStatusChart').getContext('2d'),{ type:'bar', indexAxis:'y', data:{ labels:cats.map(c=>(UTIL_ICONS[c]||'🔌')+' '+c), datasets:statuses.map(s=>({ label:s, data:cats.map(c=>data.filter(e=>e.category===c&&e.status===s).reduce((sum,e)=>sum+e.amount,0)), backgroundColor:stackColors[s]+'88', borderColor:stackColors[s], borderWidth:1.5, borderRadius:4, borderSkipped:false })) }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:true,position:'top',labels:{boxWidth:10,font:{size:11}}}, tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}} }, scales:{ x:{stacked:true,grid:{color:'rgba(0,0,0,.04)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}}, y:{stacked:true,grid:{display:false},ticks:{font:{size:11}}} } } });
        }
    }

    // ── CMP: Year-over-Year ──
    function renderCmpYoY(data) {
        const yearMap = {};
        data.forEach(e=>{ const y=e.month.substring(0,4); const mo=e.month.substring(5,7); if(!yearMap[y])yearMap[y]={}; if(!yearMap[y][mo])yearMap[y][mo]=0; yearMap[y][mo]+=e.amount; });
        const years = Object.keys(yearMap).sort();
        const allMonths = ['01','02','03','04','05','06','07','08','09','10','11','12'];
        const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        cmpDestroyChart('cmpYoYChart');

        const yearColors = ['#06b6d4','#f97316','#8b5cf6','#10b981','#ef4444'];

        // YoY table: months × years
        let tHead = `<th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">Month</th>` + years.map((y,i)=>`<th class="px-3 py-2 text-left text-xs font-semibold uppercase" style="color:${yearColors[i%yearColors.length]}">${y}</th>`).join('') + (years.length>=2?`<th class="px-3 py-2 text-left text-xs font-semibold text-gray-500 uppercase">YoY Change</th>`:'');
        let tBody = allMonths.map((mo,mi)=>{
            const vals = years.map(y=>yearMap[y][mo]||0);
            const hasData = vals.some(v=>v>0);
            if (!hasData) return '';
            const change = years.length>=2&&vals[vals.length-2]>0 ? pctChange(vals[vals.length-2],vals[vals.length-1]) : '—';
            const cc = years.length>=2 ? trendColor(vals[years.length-2],vals[years.length-1]) : 'text-gray-400';
            return `<tr class="hover:bg-gray-50"><td class="px-3 py-2 text-sm font-medium text-gray-700">${monthNames[mi]}</td>${vals.map(v=>`<td class="px-3 py-2 text-sm text-gray-800">${v?fmt(v):'—'}</td>`).join('')}${years.length>=2?`<td class="px-3 py-2 text-sm font-semibold ${cc}">${change}</td>`:''}</tr>`;
        }).filter(Boolean).join('');

        // Year totals row
        const yearTotals = years.map(y=>Object.values(yearMap[y]).reduce((s,v)=>s+v,0));
        const yoyChange = years.length>=2&&yearTotals[yearTotals.length-2]>0 ? pctChange(yearTotals[yearTotals.length-2],yearTotals[yearTotals.length-1]) : '—';
        const yyc = years.length>=2 ? trendColor(yearTotals[years.length-2],yearTotals[years.length-1]) : 'text-gray-400';
        const totalsRow = `<tr class="bg-gray-50 font-semibold border-t border-gray-300"><td class="px-3 py-2 text-sm text-gray-700">Total</td>${yearTotals.map(v=>`<td class="px-3 py-2 text-sm text-gray-900">${fmt(v)}</td>`).join('')}${years.length>=2?`<td class="px-3 py-2 text-sm ${yyc}">${yoyChange}</td>`:''}</tr>`;

        document.getElementById('cmpPanel-yoy').innerHTML = `
            <div style="position:relative;width:100%;height:260px;margin-bottom:20px"><canvas id="cmpYoYChart"></canvas></div>
            <div class="overflow-x-auto rounded-xl border border-gray-200">
                <table class="w-full text-sm border-collapse">
                    <thead><tr class="bg-gray-50 border-b border-gray-200">${tHead}</tr></thead>
                    <tbody class="divide-y divide-gray-100">${tBody}${totalsRow}</tbody>
                </table>
            </div>`;

        if (years.length) {
            cmpCharts['cmpYoYChart'] = new Chart(document.getElementById('cmpYoYChart').getContext('2d'),{ type:'line', data:{ labels:monthNames, datasets:years.map((y,i)=>({ label:y, data:allMonths.map(mo=>yearMap[y][mo]||0), borderColor:yearColors[i%yearColors.length], backgroundColor:yearColors[i%yearColors.length]+'22', borderWidth:2, pointRadius:4, pointHoverRadius:6, tension:0.35, fill:false })) }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:true,position:'top',labels:{boxWidth:12,font:{size:11}}}, tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}} }, scales:{ x:{grid:{color:'rgba(0,0,0,.04)'},ticks:{font:{size:11}}}, y:{grid:{color:'rgba(0,0,0,.04)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}} } } });
        }
    }

    // ═══════════════════════════════
    // REPORT FUNCTIONS (unchanged)
    // ═══════════════════════════════
    let rActiveTab2 = 'overview';

    function openReport() {
        const modal = document.getElementById('reportModal');
        modal.classList.remove('hidden'); modal.classList.add('flex');
        document.getElementById('reportDateLabel').textContent = 'Generated ' + new Date().toLocaleDateString('en-PH', { month:'long', day:'numeric', year:'numeric' });
        renderReportActive();
