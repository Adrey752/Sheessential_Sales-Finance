    function buildCmpKpiStrip(data) {
        const total = data.reduce((s,e)=>s+e.amount,0);
        const cats  = [...new Set(data.map(e=>e.category))].length;
        const months = [...new Set(data.map(e=>e.month))].length;
        const approved = data.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount,0);
        const appRate  = data.length ? Math.round(data.filter(e=>e.status==='Approved').length/data.length*100) : 0;
        document.getElementById('cmpKpiStrip').innerHTML = `
            <div class="bg-cyan-50 rounded-xl p-3 border border-cyan-100">
                <p class="text-[11px] text-cyan-600 font-medium uppercase tracking-wider">Total</p>
                <p class="text-lg font-bold text-cyan-700">${fmt(total)}</p>
                <p class="text-[11px] text-cyan-400">${data.length} request(s)</p>
            </div>
            <div class="bg-green-50 rounded-xl p-3 border border-green-100">
                <p class="text-[11px] text-green-600 font-medium uppercase tracking-wider">Approved</p>
                <p class="text-lg font-bold text-green-700">${fmt(approved)}</p>
                <p class="text-[11px] text-green-400">${appRate}% approval rate</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                <p class="text-[11px] text-gray-500 font-medium uppercase tracking-wider">Categories</p>
                <p class="text-lg font-bold text-gray-700">${cats}</p>
                <p class="text-[11px] text-gray-400">utility type(s)</p>
            </div>
            <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                <p class="text-[11px] text-gray-500 font-medium uppercase tracking-wider">Months</p>
                <p class="text-lg font-bold text-gray-700">${months}</p>
                <p class="text-[11px] text-gray-400">with data</p>
            </div>`;
    }

    function cmpDestroyChart(id) {
        if(cmpCharts[id]){ try{ cmpCharts[id].destroy(); }catch(e){} delete cmpCharts[id]; }
    }

    // ── CMP: Monthly Trend ──
    function renderCmpMonthly(data) {
        const monthMap = {};
        data.forEach(e => { if(!monthMap[e.month]) monthMap[e.month]={ label:e.monthLabel, total:0, approved:0, pending:0, declined:0 }; monthMap[e.month].total+=e.amount; if(e.status==='Approved')monthMap[e.month].approved+=e.amount; if(e.status==='Pending')monthMap[e.month].pending+=e.amount; if(e.status==='Declined')monthMap[e.month].declined+=e.amount; });
        const months = Object.keys(monthMap).sort();
        const el = document.getElementById('cmpPanel-monthly');

        if (!months.length) { el.innerHTML = '<p class="text-gray-400 text-center py-12">No monthly data yet.</p>'; return; }

        const maxVal = Math.max(...months.map(m=>monthMap[m].total), 1);

        let cards = months.map((m, i) => {
            const d = monthMap[m];
            const prev = i > 0 ? monthMap[months[i-1]].total : null;
            const diff = prev !== null ? d.total - prev : null;
            const isUp = diff !== null && diff > 0;
            const isDown = diff !== null && diff < 0;
            const pct = prev !== null && prev > 0 ? ((Math.abs(diff) / prev) * 100).toFixed(1) : null;
            const bar = Math.round((d.total / maxVal) * 100);
            const trendBadge = diff === null ? '' :
                isUp ? `<span class="text-xs font-bold text-red-500">▲ ${pct}%</span>` :
                isDown ? `<span class="text-xs font-bold text-green-600">▼ ${pct}%</span>` :
                `<span class="text-xs text-gray-400">→ No change</span>`;
            return `
            <div class="bg-white border border-gray-100 rounded-2xl p-5 hover:shadow-sm transition">
                <div class="flex items-start justify-between mb-3">
                    <p class="text-sm font-bold text-gray-800">${esc(d.label)}</p>
                    ${trendBadge}
                </div>
                <p class="text-2xl font-bold text-cyan-600 mb-3">${fmt(d.total)}</p>
                <div class="h-2 bg-gray-100 rounded-full mb-3">
                    <div class="h-2 rounded-full bg-cyan-400 transition-all" style="width:${bar}%"></div>
                </div>
                <div class="flex gap-3 text-xs">
                    <span class="text-green-600">✓ ${fmt(d.approved)}</span>
                    <span class="text-yellow-600">⏳ ${fmt(d.pending)}</span>
                    <span class="text-red-500">✕ ${fmt(d.declined)}</span>
                </div>
            </div>`;
        }).join('');

        el.innerHTML = `<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">${cards}</div>`;
    }

    // ── CMP: Period vs Period — SIMPLIFIED ──
    function renderCmpPeriod(data) {
        const mA = document.getElementById('cmpPeriodA').value;
        const mB = document.getElementById('cmpPeriodB').value;
        const dA = data.filter(e => e.month === mA);
        const dB = data.filter(e => e.month === mB);
        const labelA = UTILITY_EXPENSES.find(e => e.month === mA)?.monthLabel || mA;
        const labelB = UTILITY_EXPENSES.find(e => e.month === mB)?.monthLabel || mB;

        const totA = dA.reduce((s, e) => s + e.amount, 0);
        const totB = dB.reduce((s, e) => s + e.amount, 0);
        const diff  = totB - totA;
        const isUp  = diff > 0;
        const isEq  = diff === 0;

        // All categories that appear in either period
        const cats = [...new Set([...dA, ...dB].map(e => e.category))].sort((a,b) => {
            const totalA = dA.filter(e=>e.category===a).reduce((s,e)=>s+e.amount,0);
            const totalB = dB.filter(e=>e.category===b).reduce((s,e)=>s+e.amount,0);
            return (totalB + dA.filter(e=>e.category===b).reduce((s,e)=>s+e.amount,0)) -
                   (totalA + dB.filter(e=>e.category===a).reduce((s,e)=>s+e.amount,0));
        });

        cmpDestroyChart('cmpPeriodBar');

        // ── Arrow indicator ──
        const arrowColor = isEq ? '#6b7280' : isUp ? '#ef4444' : '#10b981';
        const arrowIcon  = isEq ? '→' : isUp ? '↑' : '↓';
        const arrowLabel = isEq ? 'No change' : isUp ? 'Increased' : 'Decreased';
        const diffAbs    = Math.abs(diff);
        const diffPctNum = totA > 0 ? ((diffAbs / totA) * 100).toFixed(1) : (totB > 0 ? '100' : '0');

        // ── Category rows ──
        let catRows = '';
        cats.forEach(cat => {
            const a = dA.filter(e => e.category === cat).reduce((s, e) => s + e.amount, 0);
            const b = dB.filter(e => e.category === cat).reduce((s, e) => s + e.amount, 0);
            const d = b - a;
            const icon = UTIL_ICONS[cat] || '🔌';
            const maxVal = Math.max(a, b, 1);
            const barA = Math.round((a / maxVal) * 100);
            const barB = Math.round((b / maxVal) * 100);
            const changeColor = d > 0 ? 'text-red-600' : d < 0 ? 'text-green-600' : 'text-gray-400';
            const changeBg    = d > 0 ? 'bg-red-50 border-red-100' : d < 0 ? 'bg-green-50 border-green-100' : 'bg-gray-50 border-gray-100';
            const changeSign  = d > 0 ? '+' : '';
            catRows += `
            <div class="bg-white border border-gray-100 rounded-xl p-4 hover:shadow-sm transition">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-sm font-semibold text-gray-800">${icon} ${esc(cat)}</span>
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full border ${changeBg} ${changeColor}">
                        ${d === 0 ? 'No change' : changeSign + fmt(Math.abs(d))}
                    </span>
                </div>
                <div class="space-y-1.5">
                    <div class="flex items-center gap-3">
                        <span class="text-[11px] text-cyan-600 font-semibold w-20 shrink-0">${esc(labelA)}</span>
                        <div class="flex-1 bg-gray-100 rounded-full h-2">
                            <div class="h-2 rounded-full bg-cyan-400" style="width:${barA}%"></div>
                        </div>
                        <span class="text-xs font-bold text-gray-700 w-24 text-right shrink-0">${a > 0 ? fmt(a) : '—'}</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-[11px] text-orange-500 font-semibold w-20 shrink-0">${esc(labelB)}</span>
                        <div class="flex-1 bg-gray-100 rounded-full h-2">
                            <div class="h-2 rounded-full bg-orange-400" style="width:${barB}%"></div>
                        </div>
                        <span class="text-xs font-bold text-gray-700 w-24 text-right shrink-0">${b > 0 ? fmt(b) : '—'}</span>
                    </div>
                </div>
            </div>`;
        });

        // ── Status summary for each period ──
        const statusSummary = (d, label, colorClass) => {
            const app = d.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount,0);
            const pen = d.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount,0);
            const dec = d.filter(e=>e.status==='Declined').reduce((s,e)=>s+e.amount,0);
            return `
            <div>
                <p class="text-xs font-semibold ${colorClass} mb-2">${esc(label)}</p>
                <div class="space-y-1 text-xs">
                    <div class="flex justify-between"><span class="text-gray-500">✓ Approved</span><span class="font-semibold text-green-700">${fmt(app)}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">⏳ Pending</span><span class="font-semibold text-yellow-700">${fmt(pen)}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">✕ Declined</span><span class="font-semibold text-red-700">${fmt(dec)}</span></div>
                </div>
            </div>`;
        };

        document.getElementById('cmpPanel-period').innerHTML = `
            <!-- ── Big summary header ── -->
            <div class="grid grid-cols-3 gap-4 mb-6">
                <div class="bg-cyan-50 border border-cyan-200 rounded-2xl p-5 text-center">
                    <p class="text-xs font-bold text-cyan-600 uppercase tracking-wider mb-1">${esc(labelA)}</p>
                    <p class="text-2xl font-bold text-cyan-700">${fmt(totA)}</p>
                    <p class="text-xs text-cyan-400 mt-1">${dA.length} request(s)</p>
                </div>
                <div class="flex flex-col items-center justify-center bg-gray-50 border border-gray-200 rounded-2xl p-4">
                    <span class="text-3xl font-black" style="color:${arrowColor}">${arrowIcon}</span>
                    <p class="text-sm font-bold mt-1" style="color:${arrowColor}">${diffPctNum}%</p>
                    <p class="text-[11px] text-gray-400 mt-0.5">${arrowLabel}</p>
                    <p class="text-xs font-semibold mt-2" style="color:${arrowColor}">${diff === 0 ? '₱0.00' : (isUp ? '+' : '-') + fmt(diffAbs)}</p>
                </div>
                <div class="bg-orange-50 border border-orange-200 rounded-2xl p-5 text-center">
                    <p class="text-xs font-bold text-orange-500 uppercase tracking-wider mb-1">${esc(labelB)}</p>
                    <p class="text-2xl font-bold text-orange-600">${fmt(totB)}</p>
                    <p class="text-xs text-orange-400 mt-1">${dB.length} request(s)</p>
                </div>
            </div>

            <!-- ── Status breakdown side by side ── -->
            <div class="grid grid-cols-2 gap-4 mb-6 p-4 bg-gray-50 rounded-xl border border-gray-200">
                ${statusSummary(dA, labelA, 'text-cyan-600')}
                ${statusSummary(dB, labelB, 'text-orange-500')}
            </div>

            <!-- ── Chart ── -->
            ${cats.length ? `<div style="position:relative;width:100%;height:${Math.max(180, cats.length * 48 + 60)}px;margin-bottom:20px"><canvas id="cmpPeriodBar"></canvas></div>` : ''}

            <!-- ── Category-by-category breakdown ── -->
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Category Breakdown</p>
            <div class="space-y-3">${catRows || '<p class="text-gray-400 text-sm text-center py-4">No category data for selected periods.</p>'}</div>`;

        if (cats.length) {
            cmpCharts['cmpPeriodBar'] = new Chart(document.getElementById('cmpPeriodBar').getContext('2d'), {
                type: 'bar', indexAxis: 'y',
                data: {
                    labels: cats.map(c => (UTIL_ICONS[c]||'🔌') + ' ' + c),
                    datasets: [
                        { label: labelA, data: cats.map(c => dA.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0)), backgroundColor: '#06b6d455', borderColor: '#06b6d4', borderWidth: 1.5, borderRadius: 4, borderSkipped: false },
                        { label: labelB, data: cats.map(c => dB.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0)), backgroundColor: '#f9731655', borderColor: '#f97316', borderWidth: 1.5, borderRadius: 4, borderSkipped: false },
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: true, position: 'top', labels: { boxWidth: 12, font: { size: 11 } } }, tooltip: { callbacks: { label: c => ' ' + fmt(c.raw) } } },
                    scales: { x: { grid: { color: 'rgba(0,0,0,.04)' }, ticks: { callback: v => '₱' + v.toLocaleString('en-PH'), font: { size: 10 } } }, y: { grid: { display: false }, ticks: { font: { size: 11 } } } }
                }
            });
        }
    }

    // ── CMP: By Category ──
    function renderCmpCategory(data) {
        const catMap = {};
        data.forEach(e=>{ if(!catMap[e.category])catMap[e.category]={total:0,approved:0,pending:0,declined:0,count:0}; catMap[e.category].total+=e.amount; catMap[e.category].count++; if(e.status==='Approved')catMap[e.category].approved+=e.amount; if(e.status==='Pending')catMap[e.category].pending+=e.amount; if(e.status==='Declined')catMap[e.category].declined+=e.amount; });
        const cats = Object.keys(catMap).sort((a,b)=>catMap[b].total-catMap[a].total);
        const grandTotal = cats.reduce((s,c)=>s+catMap[c].total,0);
        const el = document.getElementById('cmpPanel-category');

        if (!cats.length) { el.innerHTML = '<p class="text-gray-400 text-center py-12">No category data.</p>'; return; }

        const cards = cats.map((c,i) => {
            const d = catMap[c];
            const pct = grandTotal ? Math.round(d.total/grandTotal*100) : 0;
            const color = UTIL_PALETTE[c] || '#9ca3af';
            const icon = UTIL_ICONS[c] || '🔌';
            const appPct = d.total ? Math.round(d.approved/d.total*100) : 0;
            return `
            <div class="bg-white border border-gray-100 rounded-2xl p-5 hover:shadow-sm transition">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-bold text-gray-800">${icon} ${esc(c)}</span>
                    <span class="text-xs font-bold px-2 py-0.5 rounded-full text-white" style="background:${color}">${pct}%</span>
                </div>
                <p class="text-2xl font-bold mb-2" style="color:${color}">${fmt(d.total)}</p>
                <div class="h-1.5 bg-gray-100 rounded-full mb-3">
                    <div class="h-1.5 rounded-full" style="width:${pct}%;background:${color}"></div>
                </div>
                <div class="flex gap-3 text-xs">
                    <span class="text-green-600">✓ ${fmt(d.approved)}</span>
                    <span class="text-yellow-600">⏳ ${fmt(d.pending)}</span>
                    <span class="text-red-500">✕ ${fmt(d.declined)}</span>
                </div>
                <p class="text-[11px] text-gray-400 mt-2">${d.count} request(s) · ${appPct}% approved</p>
            </div>`;
        }).join('');

        el.innerHTML = `<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">${cards}</div>`;
    }

    // ── CMP: By Department ──
    function renderCmpDepartment(data) {
        const deptMap = {};
        data.forEach(e=>{ if(!deptMap[e.department])deptMap[e.department]={total:0,approved:0,pending:0,declined:0,count:0}; deptMap[e.department].total+=e.amount; deptMap[e.department].count++; if(e.status==='Approved')deptMap[e.department].approved+=e.amount; if(e.status==='Pending')deptMap[e.department].pending+=e.amount; if(e.status==='Declined')deptMap[e.department].declined+=e.amount; });
        const depts = Object.keys(deptMap).sort((a,b)=>deptMap[b].total-deptMap[a].total);
        const grandTotal = depts.reduce((s,d)=>s+deptMap[d].total,0);
        const el = document.getElementById('cmpPanel-department');

        if (!depts.length) { el.innerHTML = '<p class="text-gray-400 text-center py-12">No department data.</p>'; return; }

        const cards = depts.map((d,i) => {
            const v = deptMap[d];
            const pct = grandTotal ? Math.round(v.total/grandTotal*100) : 0;
            const color = RPALETTE[i % RPALETTE.length];
            return `
            <div class="bg-white border border-gray-100 rounded-2xl p-5 hover:shadow-sm transition">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-bold text-gray-800">${esc(d)}</span>
                    <span class="text-xs font-semibold text-gray-500">${pct}% of total</span>
                </div>
                <p class="text-2xl font-bold mb-2" style="color:${color}">${fmt(v.total)}</p>
                <div class="h-1.5 bg-gray-100 rounded-full mb-3">
                    <div class="h-1.5 rounded-full" style="width:${pct}%;background:${color}"></div>
                </div>
                <div class="flex gap-3 text-xs">
                    <span class="text-green-600">✓ ${fmt(v.approved)}</span>
                    <span class="text-yellow-600">⏳ ${fmt(v.pending)}</span>
                    <span class="text-red-500">✕ ${fmt(v.declined)}</span>
                </div>
                <p class="text-[11px] text-gray-400 mt-2">${v.count} request(s)</p>
            </div>`;
        }).join('');

        el.innerHTML = `<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">${cards}</div>`;
    }

    // ── CMP: By Status ──
    function renderCmpStatus(data) {
        const total = data.reduce((s,e)=>s+e.amount,0);
        const approved = data.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount,0);
        const pending  = data.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount,0);
        const declined = data.filter(e=>e.status==='Declined').reduce((s,e)=>s+e.amount,0);
        const appPct = total ? Math.round(approved/total*100) : 0;
        const penPct = total ? Math.round(pending/total*100) : 0;
        const decPct = total ? Math.round(declined/total*100) : 0;
        const el = document.getElementById('cmpPanel-status');

        el.innerHTML = `
            <div class="grid grid-cols-3 gap-4 mb-6">
                <div class="bg-green-50 border border-green-200 rounded-2xl p-6 text-center">
                    <p class="text-xs font-bold text-green-600 uppercase tracking-wider mb-2">✓ Approved</p>
                    <p class="text-3xl font-bold text-green-700">${appPct}%</p>
                    <p class="text-sm font-semibold text-green-600 mt-1">${fmt(approved)}</p>
                    <p class="text-xs text-green-400 mt-1">${data.filter(e=>e.status==='Approved').length} request(s)</p>
                </div>
                <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 text-center">
                    <p class="text-xs font-bold text-yellow-600 uppercase tracking-wider mb-2">⏳ Pending</p>
                    <p class="text-3xl font-bold text-yellow-700">${penPct}%</p>
                    <p class="text-sm font-semibold text-yellow-600 mt-1">${fmt(pending)}</p>
                    <p class="text-xs text-yellow-400 mt-1">${data.filter(e=>e.status==='Pending').length} request(s)</p>
                </div>
                <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-center">
                    <p class="text-xs font-bold text-red-500 uppercase tracking-wider mb-2">✕ Declined</p>
                    <p class="text-3xl font-bold text-red-600">${decPct}%</p>
                    <p class="text-sm font-semibold text-red-500 mt-1">${fmt(declined)}</p>
                    <p class="text-xs text-red-400 mt-1">${data.filter(e=>e.status==='Declined').length} request(s)</p>
                </div>
            </div>
            <div class="bg-white border border-gray-100 rounded-2xl p-5">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Approval breakdown by category</p>
                <div class="space-y-3">
                ${[...new Set(data.map(e=>e.category))].sort().map(c => {
                    const app=data.filter(e=>e.category===c&&e.status==='Approved').reduce((s,e)=>s+e.amount,0);
                    const tot=data.filter(e=>e.category===c).reduce((s,e)=>s+e.amount,0);
                    const pct=tot?Math.round(app/tot*100):0;
                    const icon=UTIL_ICONS[c]||'🔌';
                    return `<div class="flex items-center gap-3">
                        <span class="text-sm w-32 shrink-0 text-gray-700">${icon} ${esc(c)}</span>
                        <div class="flex-1 bg-gray-100 rounded-full h-2">
                            <div class="h-2 rounded-full bg-green-400" style="width:${pct}%"></div>
                        </div>
                        <span class="text-xs font-bold text-gray-600 w-20 text-right shrink-0">${fmt(tot)} <span class="text-green-600">(${pct}%)</span></span>
                    </div>`;
                }).join('')}
                </div>
            </div>`;
    }

    // ── CMP: Year-over-Year ──
    function renderCmpYoY(data) {
        const yearMap = {};
        data.forEach(e=>{ const y=e.month.substring(0,4); if(!yearMap[y])yearMap[y]=0; yearMap[y]+=e.amount; });
        const years = Object.keys(yearMap).sort();
        const el = document.getElementById('cmpPanel-yoy');

        if (!years.length) { el.innerHTML = '<p class="text-gray-400 text-center py-12">No year data.</p>'; return; }

        const maxVal = Math.max(...years.map(y=>yearMap[y]), 1);
        const yearColors = ['#06b6d4','#f97316','#8b5cf6','#10b981','#ef4444'];

        const cards = years.map((y, i) => {
            const val = yearMap[y];
            const prevY = years[i-1];
            const prev = prevY ? yearMap[prevY] : null;
            const diff = prev !== null ? val - prev : null;
            const isUp = diff !== null && diff > 0;
            const pct = prev !== null && prev > 0 ? ((Math.abs(diff)/prev)*100).toFixed(1) : null;
            const bar = Math.round((val/maxVal)*100);
            const color = yearColors[i % yearColors.length];
            const trendBadge = diff === null ? '' :
                isUp ? `<span class="text-xs font-bold text-red-500">▲ ${pct}% vs ${prevY}</span>` :
                `<span class="text-xs font-bold text-green-600">▼ ${pct}% vs ${prevY}</span>`;
            return `
            <div class="bg-white border border-gray-100 rounded-2xl p-5 hover:shadow-sm transition">
                <div class="flex items-start justify-between mb-2">
                    <p class="text-lg font-bold" style="color:${color}">${y}</p>
                    ${trendBadge}
                </div>
                <p class="text-2xl font-bold text-gray-800 mb-3">${fmt(val)}</p>
                <div class="h-2 bg-gray-100 rounded-full">
                    <div class="h-2 rounded-full transition-all" style="width:${bar}%;background:${color}"></div>
                </div>
            </div>`;
        }).join('');

        el.innerHTML = `<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">${cards}</div>`;
    }

    // ═══════════════════════════════
    // REPORT FUNCTIONS
    // ═══════════════════════════════

    function openReport() {
        const modal = document.getElementById('reportModal');
        modal.classList.remove('hidden'); modal.classList.add('flex');
        document.getElementById('reportDateLabel').textContent = 'Generated ' + new Date().toLocaleDateString('en-PH', { month:'long', day:'numeric', year:'numeric' });
        renderReportActive();
    }

    function closeReport() {
        const modal = document.getElementById('reportModal');
        modal.classList.add('hidden'); modal.classList.remove('flex');
        Object.values(rCharts).forEach(c => { try { c.destroy(); } catch(e){} }); rCharts = {};
    }

    function rFilteredData() { const st=document.getElementById('rFilterStatus').value; return REPORT_DEPT_DATA.map(d=>({...d,expenses:st==='all'?d.expenses:d.expenses.filter(e=>e.status===st)})); }
    function rSortedData(data) { const by=document.getElementById('rSortBy').value; return [...data].sort((a,b)=>{ if(by==='amount')return b.expenses.reduce((s,e)=>s+e.amount,0)-a.expenses.reduce((s,e)=>s+e.amount,0); if(by==='count')return b.expenses.length-a.expenses.length; return a.name.localeCompare(b.name); }); }

    function rBuildSummary(data) {
        const all=data.flatMap(d=>d.expenses); const total=all.reduce((s,e)=>s+e.amount,0); const approved=all.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount,0); const pending=all.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount,0); const declined=all.filter(e=>e.status==='Declined').reduce((s,e)=>s+e.amount,0);
        document.getElementById('rSummaryGrid').innerHTML=`<div class="bg-indigo-50 rounded-xl p-4 border border-indigo-100"><p class="text-xs text-indigo-600 font-medium mb-1">Total</p><p class="text-xl font-bold text-indigo-700">${fmt(total)}</p><p class="text-xs text-indigo-400 mt-1">${all.length} request(s)</p></div><div class="bg-green-50 rounded-xl p-4 border border-green-100"><p class="text-xs text-green-600 font-medium mb-1">Approved</p><p class="text-xl font-bold text-green-700">${fmt(approved)}</p><p class="text-xs text-green-400 mt-1">${all.filter(e=>e.status==='Approved').length} request(s)</p></div><div class="bg-yellow-50 rounded-xl p-4 border border-yellow-100"><p class="text-xs text-yellow-600 font-medium mb-1">Pending</p><p class="text-xl font-bold text-yellow-700">${fmt(pending)}</p><p class="text-xs text-yellow-400 mt-1">${all.filter(e=>e.status==='Pending').length} request(s)</p></div><div class="bg-red-50 rounded-xl p-4 border border-red-100"><p class="text-xs text-red-600 font-medium mb-1">Declined</p><p class="text-xl font-bold text-red-700">${fmt(declined)}</p><p class="text-xs text-red-400 mt-1">${all.filter(e=>e.status==='Declined').length} request(s)</p></div>`;
    }

    function rRenderOverview(data) {
        const sorted=rSortedData(data); const labels=sorted.map(d=>d.name); const amounts=sorted.map(d=>d.expenses.reduce((s,e)=>s+e.amount,0));
        rDestroyChart('rBarChart'); const h=Math.max(240,labels.length*52+60);
        document.getElementById('rPanel-overview').innerHTML=`<div style="position:relative;width:100%;height:${h}px"><canvas id="rBarChart"></canvas></div><p class="text-xs text-center text-gray-400 mt-2">Total expense amount per department</p>`;
        rCharts['rBarChart']=new Chart(document.getElementById('rBarChart').getContext('2d'),{type:'bar',data:{labels,datasets:[{label:'Total',data:amounts,backgroundColor:RPALETTE.map(c=>c+'cc'),borderColor:RPALETTE,borderWidth:1.5,borderRadius:8,borderSkipped:false}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:ctx=>' '+fmt(ctx.raw)}}},scales:{x:{grid:{color:'rgba(0,0,0,.06)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:11}}},y:{grid:{display:false},ticks:{font:{size:12}}}}}});
    }

    function rRenderRanking(data) {
        const sorted=rSortedData(data); const max=Math.max(...sorted.map(d=>d.expenses.reduce((s,e)=>s+e.amount,0)),1); let rows='';
        sorted.forEach((dept,i)=>{const total=dept.expenses.reduce((s,e)=>s+e.amount,0);const approved=dept.expenses.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount,0);const pending=dept.expenses.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount,0);const declined=dept.expenses.filter(e=>e.status==='Declined').reduce((s,e)=>s+e.amount,0);const pct=Math.round(total/max*100);const color=RPALETTE[i%RPALETTE.length];const medal=i===0?'🥇':i===1?'🥈':i===2?'🥉':`<span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-gray-100 text-gray-500 text-xs font-medium">${i+1}</span>`;rows+=`<tr class="hover:bg-gray-50 transition-colors"><td class="px-4 py-3 text-base">${medal}</td><td class="px-4 py-3 font-medium text-gray-900 text-sm">${esc(dept.name)}</td><td class="px-4 py-3 font-bold text-indigo-600 text-sm">${fmt(total)}</td><td class="px-4 py-3 min-w-[100px]"><div class="h-1.5 bg-gray-200 rounded-full"><div class="h-1.5 rounded-full" style="width:${pct}%;background:${color}"></div></div></td><td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-green-100 text-green-800">${fmt(approved)}</span></td><td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-yellow-100 text-yellow-800">${fmt(pending)}</span></td><td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full text-[11px] font-semibold bg-red-100 text-red-800">${fmt(declined)}</span></td><td class="px-4 py-3 text-sm text-gray-500">${dept.expenses.length}</td></tr>`;});
        document.getElementById('rPanel-ranking').innerHTML=`<div class="overflow-x-auto rounded-xl border border-gray-200"><table class="w-full text-sm border-collapse"><thead><tr class="bg-gray-50 border-b border-gray-200"><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">#</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Department</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider min-w-[100px]">Share</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Approved</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Pending</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Declined</th><th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Requests</th></tr></thead><tbody class="divide-y divide-gray-100">${rows}</tbody></table></div>`;
    }

    function rRenderBreakdown(data) {
        const all=data.flatMap(d=>d.expenses); const statuses=['Approved','Pending','Declined']; const amounts=statuses.map(s=>all.filter(e=>e.status===s).reduce((sum,e)=>sum+e.amount,0)); const typeMap={}; all.forEach(e=>{const t=e.expenseType||'Other';if(!typeMap[t])typeMap[t]=0;typeMap[t]+=e.amount;}); const typeEntries=Object.entries(typeMap).sort((a,b)=>b[1]-a[1]);
        rDestroyChart('rDonutChart'); rDestroyChart('rTypeChart');
        const legendHtml=statuses.map((s,i)=>`<div class="flex items-center gap-2 text-xs text-gray-600"><span class="w-3 h-3 rounded-sm inline-block" style="background:${[RSTATUS_COLORS.Approved,RSTATUS_COLORS.Pending,RSTATUS_COLORS.Declined][i]}"></span>${s}: ${fmt(amounts[i])}</div>`).join('');
        const typeH=Math.max(180,typeEntries.length*36+60);
        document.getElementById('rPanel-breakdown').innerHTML=`<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 items-start"><div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">By Status (Amount)</p><div style="position:relative;width:100%;height:220px"><canvas id="rDonutChart"></canvas></div><div class="flex flex-wrap gap-3 mt-3">${legendHtml}</div></div><div><p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-3">By Expense Type</p><div style="position:relative;width:100%;height:${typeH}px"><canvas id="rTypeChart"></canvas></div></div></div>`;
        rCharts['rDonutChart']=new Chart(document.getElementById('rDonutChart').getContext('2d'),{type:'doughnut',data:{labels:statuses,datasets:[{data:amounts,backgroundColor:[RSTATUS_COLORS.Approved,RSTATUS_COLORS.Pending,RSTATUS_COLORS.Declined],borderWidth:2,borderColor:'#fff',hoverOffset:4}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}}}}});
        rCharts['rTypeChart']=new Chart(document.getElementById('rTypeChart').getContext('2d'),{type:'bar',data:{labels:typeEntries.map(t=>t[0]),datasets:[{label:'Amount',data:typeEntries.map(t=>t[1]),backgroundColor:RPALETTE.map(c=>c+'cc'),borderColor:RPALETTE,borderWidth:1.5,borderRadius:6,borderSkipped:false}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+fmt(c.raw)}}},scales:{x:{grid:{color:'rgba(0,0,0,.06)'},ticks:{callback:v=>'₱'+v.toLocaleString('en-PH'),font:{size:10}}},y:{grid:{display:false},ticks:{font:{size:11}}}}}});
    }

    function rRenderInsights(data) {
        const all=data.flatMap(d=>d.expenses); const total=all.reduce((s,e)=>s+e.amount,0); const sorted=rSortedData(data);
        const top=sorted[0]; const topTotal=top?top.expenses.reduce((s,e)=>s+e.amount,0):0; const topPct=total?Math.round(topTotal/total*100):0;
        const pendingByDept=sorted.map(d=>({name:d.name,amt:d.expenses.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount,0)})).sort((a,b)=>b.amt-a.amt); const highPending=pendingByDept[0];
        const approved=all.filter(e=>e.status==='Approved').length; const appRate=all.length?Math.round(approved/all.length*100):0;
        const decByDept=sorted.map(d=>({name:d.name,n:d.expenses.filter(e=>e.status==='Declined').length})).sort((a,b)=>b.n-a.n); const highDeclined=decByDept[0];
        const avg=sorted.length?total/sorted.filter(d=>d.expenses.length>0).length:0; const aboveAvg=sorted.filter(d=>d.expenses.reduce((s,e)=>s+e.amount,0)>avg);
        const typeMap={}; all.forEach(e=>{const t=e.expenseType||'Other';if(!typeMap[t])typeMap[t]=0;typeMap[t]+=e.amount;}); const topType=Object.entries(typeMap).sort((a,b)=>b[1]-a[1])[0];
        const ic=(bc,lc,label,content)=>`<div class="border-l-4 rounded-r-xl px-4 py-3 bg-gray-50 mb-3" style="border-color:${bc}"><p class="text-[10px] font-bold uppercase tracking-wider mb-1" style="color:${lc}">${label}</p><p class="text-sm text-gray-700">${content}</p></div>`;
        let html='';
        if(top)html+=ic('#4f46e5','#4f46e5','Top Spender',`<strong>${esc(top.name)}</strong> accounts for <strong>${topPct}%</strong> of total spending at ${fmt(topTotal)}.${topPct>40?' This is a disproportionately large share — consider reviewing its budget allocation.':''}`);
        if(highPending&&highPending.amt>0)html+=ic('#f59e0b','#b45309','Highest Pending',`<strong>${esc(highPending.name)}</strong> has the most unresolved expenses at <strong>${fmt(highPending.amt)}</strong>.`);
        html+=ic(appRate>=70?'#10b981':'#f59e0b',appRate>=70?'#059669':'#b45309','Approval Rate',`Overall approval rate is <strong>${appRate}%</strong> (${approved} of ${all.length} requests). ${appRate<70?'Consider reviewing the approval pipeline.':'The approval pipeline looks healthy.'}`);
        if(highDeclined&&highDeclined.n>0)html+=ic('#ef4444','#b91c1c','Most Declined',`<strong>${esc(highDeclined.name)}</strong> has the highest number of declined requests (<strong>${highDeclined.n}</strong>).`);
        if(aboveAvg.length>0)html+=ic('#6366f1','#4338ca','Budget Distribution',`Average spending per department is <strong>${fmt(avg)}</strong>. <strong>${aboveAvg.length} department${aboveAvg.length!==1?'s':''}</strong> (${aboveAvg.map(d=>esc(d.name)).join(', ')}) ${aboveAvg.length===1?'is':'are'} above average.`);
        if(topType)html+=ic('#10b981','#059669','Dominant Category',`<strong>${esc(topType[0])}</strong> is the highest expense type at <strong>${fmt(topType[1])}</strong>, representing <strong>${total?Math.round(topType[1]/total*100):0}%</strong> of all spending.`);
        const bottom=sorted[sorted.length-1];
        if(bottom&&bottom!==top){const bt=bottom.expenses.reduce((s,e)=>s+e.amount,0);html+=ic('#9ca3af','#6b7280','Lowest Spender',`<strong>${esc(bottom.name)}</strong> has the lowest spend at <strong>${fmt(bt)}</strong> — ${total?Math.round(bt/total*100):0}% of total.`);}
        document.getElementById('rPanel-insights').innerHTML=html||'<p class="text-gray-400 text-center py-8">No data to analyse.</p>';
    }

    function getPayrollCutoffsSorted() {
        return (window.PAYROLL_DEPT_DATA || [])
            .slice()
            .sort((a, b) => Number((b.id || '').split('-')[0] || 0) - Number((a.id || '').split('-')[0] || 0));
    }

    function payrollPct(part, total) {
        if (!total) return '0.0%';
        return ((part / total) * 100).toFixed(1) + '%';
    }

    function payrollDelta(curr, prev) {
        const diff = curr - prev;
        const pct = prev ? ((diff / prev) * 100).toFixed(1) : (curr > 0 ? '100.0' : '0.0');
        return {
            diff,
            pctText: `${diff >= 0 ? '+' : ''}${pct}%`,
            cls: diff > 0 ? 'text-red-600' : diff < 0 ? 'text-green-600' : 'text-gray-500'
        };
    }

    function renderPayrollAnalysis() {
        const panel = document.getElementById('rPanel-payroll');
        const cutoffs = getPayrollCutoffsSorted();

        if (!cutoffs.length) {
            document.getElementById('rSummaryGrid').innerHTML = '';
            panel.innerHTML = '<p class="text-gray-400 text-center py-8">No payroll snapshots available for analysis.</p>';
            return;
        }

        if (!rSelectedPayrollCutoffId || !cutoffs.some(c => c.id === rSelectedPayrollCutoffId)) {
            rSelectedPayrollCutoffId = cutoffs[0].id;
        }

        const current = cutoffs.find(c => c.id === rSelectedPayrollCutoffId) || cutoffs[0];
        const currentIndex = cutoffs.findIndex(c => c.id === current.id);
        const previous = currentIndex >= 0 && currentIndex < cutoffs.length - 1 ? cutoffs[currentIndex + 1] : null;

        const gross = current.grossSalary || current.fullGross || 0;
        const net = current.netSalary || current.fullNet || 0;
        const deductions = current.totalDeductions || 0;
        const employees = current.totalEmployees || 0;
        const avgNet = employees ? net / employees : 0;

        const prevGross = previous ? (previous.grossSalary || previous.fullGross || 0) : 0;
        const prevNet = previous ? (previous.netSalary || previous.fullNet || 0) : 0;
        const prevEmployees = previous ? (previous.totalEmployees || 0) : 0;

        const dGross = payrollDelta(gross, prevGross);
        const dNet = payrollDelta(net, prevNet);
        const dHead = payrollDelta(employees, prevEmployees);

        document.getElementById('rSummaryGrid').innerHTML = `
            <div class="bg-indigo-50 rounded-xl p-4 border border-indigo-100"><p class="text-xs text-indigo-600 font-medium mb-1">Gross Payroll</p><p class="text-xl font-bold text-indigo-700">${fmt(gross)}</p><p class="text-xs ${dGross.cls} mt-1">${previous ? dGross.pctText + ' vs previous cutoff' : 'No previous cutoff'}</p></div>
            <div class="bg-green-50 rounded-xl p-4 border border-green-100"><p class="text-xs text-green-600 font-medium mb-1">Net Payroll</p><p class="text-xl font-bold text-green-700">${fmt(net)}</p><p class="text-xs ${dNet.cls} mt-1">${previous ? dNet.pctText + ' vs previous cutoff' : 'No previous cutoff'}</p></div>
            <div class="bg-gray-50 rounded-xl p-4 border border-gray-200"><p class="text-xs text-gray-500 font-medium mb-1">Headcount</p><p class="text-xl font-bold text-gray-700">${employees}</p><p class="text-xs ${dHead.cls} mt-1">${previous ? dHead.pctText + ' vs previous cutoff' : 'No previous cutoff'}</p></div>
            <div class="bg-amber-50 rounded-xl p-4 border border-amber-100"><p class="text-xs text-amber-600 font-medium mb-1">Avg Net / Employee</p><p class="text-xl font-bold text-amber-700">${fmt(avgNet)}</p><p class="text-xs text-amber-500 mt-1">Deductions: ${fmt(deductions)}</p></div>`;

        const departments = (current.departments || []).slice().sort((a, b) => (b.grossSalary || 0) - (a.grossSalary || 0));
        const allEmployees = departments.flatMap(d => d.employees || []);

        const highDeductionEmployees = allEmployees
            .map(e => {
                const ratio = e.grossSalary > 0 ? (e.totalDeductions / e.grossSalary) : 0;
                return { ...e, ratio };
            })
            .filter(e => e.ratio >= 0.35 || e.netSalary <= 0)
            .sort((a, b) => b.ratio - a.ratio)
            .slice(0, 8);

        const topPenaltyDept = departments
            .map(d => ({ name: d.name, penalty: (d.latePenalty || 0) + (d.absencePenalty || 0) }))
            .sort((a, b) => b.penalty - a.penalty)[0];

        const cutoffOptions = cutoffs.map(c => `<option value="${c.id}" ${c.id === current.id ? 'selected' : ''}>${esc(c.cutoffLabel || c.payPeriod || c.id)}</option>`).join('');

        panel.innerHTML = `
            <div class="mb-5 p-4 bg-indigo-50 border border-indigo-200 rounded-xl flex flex-wrap items-end gap-3">
                <div class="min-w-[260px]">
                    <label class="block text-xs font-semibold text-indigo-700 uppercase tracking-wider mb-1">Payroll Cutoff</label>
                    <select id="rPayrollCutoffSelect" onchange="rSelectedPayrollCutoffId=this.value; renderReportActive();" class="px-3 py-2 rounded-lg border border-indigo-200 text-sm bg-white text-gray-700 w-full">
                        ${cutoffOptions}
                    </select>
                </div>
                <div class="text-xs text-indigo-700">
                    <p><strong>Period:</strong> ${esc(current.payPeriod || 'N/A')}</p>
                    <p><strong>Status:</strong> ${esc(current.status || 'N/A')}</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mb-5">
                <div class="bg-white border border-gray-200 rounded-xl p-4">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Department Cost Distribution</p>
                    <div class="space-y-3">
                        ${departments.map((d, i) => {
                            const share = payrollPct(d.grossSalary || 0, gross);
                            const avg = d.employeeCount ? ((d.grossSalary || 0) / d.employeeCount) : 0;
                            const color = RPALETTE[i % RPALETTE.length];
                            return `<div>
                                <div class="flex justify-between text-sm mb-1"><span class="font-medium text-gray-800">${esc(d.name)}</span><span class="font-semibold" style="color:${color}">${fmt(d.grossSalary || 0)} (${share})</span></div>
                                <div class="h-2 bg-gray-100 rounded-full mb-1"><div class="h-2 rounded-full" style="width:${share};background:${color}"></div></div>
                                <p class="text-[11px] text-gray-400">${d.employeeCount || 0} employee(s) • Avg Gross: ${fmt(avg)}</p>
                            </div>`;
                        }).join('') || '<p class="text-sm text-gray-400">No departments found.</p>'}
                    </div>
                </div>

                <div class="bg-white border border-gray-200 rounded-xl p-4">
                    <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Key Insights</p>
                    <div class="space-y-3 text-sm text-gray-700">
                        <div class="p-3 rounded-lg bg-gray-50 border border-gray-100">
                            <p><strong>Net Payout Ratio:</strong> ${payrollPct(net, gross)} of gross payroll.</p>
                            <p><strong>Deduction Ratio:</strong> ${payrollPct(deductions, gross)} of gross payroll.</p>
                        </div>
                        <div class="p-3 rounded-lg bg-gray-50 border border-gray-100">
                            <p><strong>Highest Penalty Impact Dept:</strong> ${topPenaltyDept ? esc(topPenaltyDept.name) : 'N/A'}</p>
                            <p><strong>Penalty Total:</strong> ${topPenaltyDept ? fmt(topPenaltyDept.penalty) : '₱0.00'}</p>
                        </div>
                        <div class="p-3 rounded-lg bg-gray-50 border border-gray-100">
                            <p><strong>Variance vs Previous:</strong> Gross ${previous ? dGross.pctText : 'N/A'}, Net ${previous ? dNet.pctText : 'N/A'}, Headcount ${previous ? dHead.pctText : 'N/A'}.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-xl p-4">
                <p class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-3">Exception Monitoring (High Deductions / Low Net)</p>
                ${highDeductionEmployees.length ? `
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left border-b border-gray-200">
                                <th class="py-2 pr-3">Employee</th>
                                <th class="py-2 pr-3">Gross</th>
                                <th class="py-2 pr-3">Deductions</th>
                                <th class="py-2 pr-3">Net</th>
                                <th class="py-2 pr-0">Deduction Ratio</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${highDeductionEmployees.map(e => `
                                <tr class="border-b border-gray-100">
                                    <td class="py-2 pr-3 font-medium text-gray-800">${esc(e.employeeName || '')}</td>
                                    <td class="py-2 pr-3">${fmt(e.grossSalary || 0)}</td>
                                    <td class="py-2 pr-3 text-red-600">${fmt(e.totalDeductions || 0)}</td>
                                    <td class="py-2 pr-3 ${e.netSalary <= 0 ? 'text-red-600 font-semibold' : ''}">${fmt(e.netSalary || 0)}</td>
                                    <td class="py-2 pr-0 font-semibold ${e.ratio >= 0.5 ? 'text-red-600' : 'text-amber-600'}">${(e.ratio * 100).toFixed(1)}%</td>
                                </tr>`).join('')}
                        </tbody>
                    </table>
                </div>` : '<p class="text-sm text-gray-400">No high-risk deduction outliers in selected cutoff.</p>'}
            </div>`;
    }

    function rDestroyChart(id) { if(rCharts[id]){try{rCharts[id].destroy();}catch(e){}delete rCharts[id];} }

    function renderReportActive() {
        const data=rFilteredData();
        const expenseFilters=document.getElementById('rExpenseFilters');

        if(rActiveTab==='payroll'){
            if(expenseFilters) expenseFilters.classList.add('hidden');
            renderPayrollAnalysis();
            return;
        }

        if(expenseFilters) expenseFilters.classList.remove('hidden');
        rBuildSummary(data);
        if(rActiveTab==='overview')rRenderOverview(data);
        else if(rActiveTab==='ranking')rRenderRanking(data);
        else if(rActiveTab==='breakdown')rRenderBreakdown(data);
        else if(rActiveTab==='insights')rRenderInsights(data);
    }

    function switchReportTab(tab,btn) {
        rActiveTab=tab;
        ['overview','ranking','breakdown','insights','payroll'].forEach(t=>{document.getElementById('rTab-'+t).className='flex-1 px-4 py-2 rounded-lg text-sm font-medium transition-all '+(t===tab?'bg-white shadow text-indigo-600':'text-gray-500 hover:text-gray-700');document.getElementById('rPanel-'+t).style.display=t===tab?'block':'none';});
        renderReportActive();
    }

    // ═══════════════════════════════
    // DEPT / PAYROLL / INGREDIENT PANELS
    // ═══════════════════════════════
    function openDeptPanel(type, title, expensesOrEmpty, dataArr) {
        const panel=document.getElementById('deptPanel'); const content=document.getElementById('deptPanelContent');
        document.getElementById('panelDeptName').textContent=title;
        if(type==='department'){document.getElementById('panelSubtitle').textContent='All expense requests for this department';buildExpenseOnlyPanel(expensesOrEmpty);}
        else if(type==='ingredient'){document.getElementById('panelSubtitle').textContent='All ingredient stock requests';buildIngredientOnlyPanel(dataArr);}
        else if(type==='payroll'){document.getElementById('panelSubtitle').textContent='All payroll snapshots — grouped by department';buildPayrollPanel(dataArr);}
        panel.classList.remove('hidden');
        requestAnimationFrame(()=>{content.classList.remove('translate-x-full');content.classList.add('translate-x-0');});
    }

    function closeDeptPanel() { const c=document.getElementById('deptPanelContent'); c.classList.remove('translate-x-0');c.classList.add('translate-x-full'); setTimeout(()=>document.getElementById('deptPanel').classList.add('hidden'),300); }

    function buildExpenseOnlyPanel(expenses) {
        document.getElementById('panelTabs').innerHTML=`<button class="flex-1 px-4 py-2 rounded-lg text-sm font-medium bg-white shadow text-[#A36A66]">Expense Requests (${expenses.length})</button>`;
        renderExpensesTab(expenses);
    }

    function renderExpensesTab(expenses) {
        const body = document.getElementById('panelBody');
        if (!expenses.length) {
            body.innerHTML = '<p class="text-gray-400 text-center py-8">No expense requests for this department</p>';
            return;
        }

        const grouped = {};
        expenses.forEach(e => {
            const key = e.expenseType || 'Uncategorized';
            if (!grouped[key]) grouped[key] = [];
            grouped[key].push(e);
        });

        const sortedKeys = Object.keys(grouped)
            .sort((a, b) => grouped[b].reduce((s, e) => s + e.amount, 0) - grouped[a].reduce((s, e) => s + e.amount, 0));

        let html = `<div class="grid grid-cols-3 gap-3 mb-6">
            <div class="bg-yellow-50 rounded-xl p-3 border border-yellow-200"><p class="text-xs text-yellow-700 font-medium">Pending</p><p class="text-lg font-bold text-yellow-800">${fmt(expenses.filter(e => e.status === 'Pending').reduce((s, e) => s + e.amount, 0))}</p></div>
            <div class="bg-green-50 rounded-xl p-3 border border-green-200"><p class="text-xs text-green-700 font-medium">Approved</p><p class="text-lg font-bold text-green-800">${fmt(expenses.filter(e => e.status === 'Approved').reduce((s, e) => s + e.amount, 0))}</p></div>
            <div class="bg-red-50 rounded-xl p-3 border border-red-200"><p class="text-xs text-red-700 font-medium">Declined</p><p class="text-lg font-bold text-red-800">${fmt(expenses.filter(e => e.status === 'Declined').reduce((s, e) => s + e.amount, 0))}</p></div>
        </div>`;

        sortedKeys.forEach(cat => {
            const items = grouped[cat];
            const catTotal = items.reduce((s, e) => s + e.amount, 0);

            html += `<div class="mb-6">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-sm font-semibold text-gray-900">${esc(cat)} <span class="text-gray-400 font-normal">(${items.length})</span></h3>
                    <span class="text-sm font-bold text-[#A36A66]">${fmt(catTotal)}</span>
                </div>
                <div class="space-y-2">`;

            items.forEach(exp => {
                const badge = exp.status === 'Pending'
                    ? '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>'
                    : exp.status === 'Approved'
                        ? '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800">✓ Approved</span>'
                        : '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-red-100 text-red-800">✕ Declined</span>';

                const actions = exp.status === 'Pending'
                    ? `<div class="flex gap-1.5 mt-2 optimistic-actions">
                            <button onclick="event.stopPropagation();openApproveModal('${exp.id}','${esc(exp.expenseId)}',${exp.amount})" class="px-3 py-1 bg-green-600 text-white text-[11px] font-medium rounded-lg hover:bg-green-700">Approve</button>
                            <button onclick="event.stopPropagation();openDeclineModal('${exp.id}','${esc(exp.expenseId)}',false)" class="px-3 py-1 bg-red-600 text-white text-[11px] font-medium rounded-lg hover:bg-red-700">Decline</button>
                       </div>`
                    : '';

                const notes = exp.status === 'Declined' && exp.notes
                    ? `<p class="text-[11px] text-red-600 mt-1">Reason: ${esc(exp.notes)}</p>`
                    : '';

                const detailPayload = JSON.stringify(exp).replace(/"/g, '&quot;');

                html += `<button type="button" onclick="openExpenseDetailsModal(${detailPayload})" data-expense-id="${esc(exp.id || '')}" class="w-full text-left bg-gray-50 rounded-xl p-4 border border-gray-100 hover:border-[#A36A66]/40 hover:bg-[#fff8f8] transition">
                    <div class="flex items-start justify-between">
                        <div class="flex-1 mr-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-xs font-semibold text-blue-600">${esc(exp.expenseId)}</span>
                                ${badge}
                            </div>
                            <p class="text-sm font-medium text-gray-800">${esc(exp.requestedBy)}</p>
                            <p class="text-xs text-gray-400 mt-0.5">${esc(exp.description || '')}</p>
                            <p class="text-[11px] text-gray-400 mt-1">${exp.requestedAt}</p>
                            ${notes}
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-sm font-bold text-gray-900">${fmt(exp.amount)}</p>
                            <p class="text-[10px] text-gray-400">Click to view</p>
                        </div>
                    </div>
                    ${actions}
                </button>`;
            });

            html += '</div></div>';
        });

        body.innerHTML = html;
    }

