                    </div>
                    <div class="h-1 bg-gray-100 rounded-full mt-1.5 ml-4">
                        <div class="h-1 rounded-full" style="width:${pct}%;background:${color}"></div>
                    </div>
                </td>
                <td class="px-3 py-3 text-sm font-semibold text-purple-700">${hc}</td>
                <td class="px-3 py-3 text-sm font-bold text-gray-900">${fmt(v.totalGross)}</td>
                <td class="px-3 py-3 text-sm text-indigo-700 font-semibold">${fmt(costPerHead)}</td>
                <td class="px-3 py-3 text-sm text-green-700">${fmt(v.totalNet)}</td>
            </tr>`;
        });

        html += `</tbody></table></div>`;

        // Per-dept cost card breakdown
        html += `<div class="space-y-3">`;
        depts.forEach(([name, v], i) => {
            const hc = v.headcount.size || 1;
            const costPerHead = v.totalGross / hc;
            const deductRate = v.totalGross > 0 ? Math.round(v.totalDeductions/v.totalGross*100) : 0;
            const color = sPalette[i % sPalette.length];
            html += `<div class="bg-white rounded-xl border border-gray-100 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full" style="background:${color}"></div>
                        <p class="text-sm font-semibold text-gray-900">${esc(name)}</p>
                        <span class="text-xs text-gray-400">${hc} employee${hc>1?'s':''}</span>
                    </div>
                    <span class="text-sm font-bold text-gray-900">${fmt(v.totalGross)}</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-xs">
                    <div class="bg-purple-50 rounded-lg p-2 text-center">
                        <p class="text-purple-500">Cost/Head</p>
                        <p class="font-bold text-purple-800">${fmt(costPerHead)}</p>
                    </div>
                    <div class="bg-green-50 rounded-lg p-2 text-center">
                        <p class="text-green-500">Net Pay</p>
                        <p class="font-bold text-green-800">${fmt(v.totalNet)}</p>
                    </div>
                    <div class="bg-red-50 rounded-lg p-2 text-center">
                        <p class="text-red-500">Ded Rate</p>
                        <p class="font-bold text-red-800">${deductRate}%</p>
                    </div>
                </div>
            </div>`;
        });
        html += `</div>`;

        body.innerHTML = html;
    }

    // ═══════════════════════════════════════════════════════
    // ── PRINT / PDF ──
    // ═══════════════════════════════════════════════════════
    function printReport(){
        const modal = document.getElementById('reportModal');
        const title = 'Expense Report by Department';
        const dateStr = new Date().toLocaleDateString('en-PH', { month:'long', day:'numeric', year:'numeric' });

        // Get current tab content
        const activePanel = document.querySelector('#rPanel-overview, #rPanel-ranking, #rPanel-breakdown, #rPanel-insights');
        const summaryGrid = document.getElementById('rSummaryGrid')?.innerHTML || '';
        const panelHtml = activePanel ? activePanel.innerHTML : '';

        const printWindow = window.open('', '_blank');
      
    }

    // ═══════════════════════════════════════════════════════
    // ── KEYBOARD SHORTCUTS ──
    // ═══════════════════════════════════════════════════════
    function openShortcuts(){ document.getElementById('shortcutsModal').classList.remove('hidden'); document.getElementById('shortcutsModal').classList.add('flex'); }
    function closeShortcuts(){ document.getElementById('shortcutsModal').classList.add('hidden'); document.getElementById('shortcutsModal').classList.remove('flex'); }

    document.addEventListener('keydown', e => {
        const tag = (document.activeElement?.tagName||'').toLowerCase();
        const inInput = tag==='input'||tag==='textarea'||tag==='select';

        if(e.key === 'Escape'){
            closeDeptPanel(); closeUtilitiesPanel(); closeApproveModal();
            closeDeclineModal(); closePayrollConfirm(); closeEmployeeModal();
            closeReport(); closeUtilitiesComparison();
            closeAgingPanel(); closeSupplierPanel(); closeHeadcountPanel();
            closeShortcuts();
            document.getElementById('searchDropdown').classList.add('hidden');
            return;
        }

        if(inInput) return;

        if(e.key==='?' || (e.shiftKey && e.key==='/')){  openShortcuts(); e.preventDefault(); }
        if(e.key==='r' || e.key==='R'){  openReport(); e.preventDefault(); }
        if(e.key==='a' || e.key==='A'){  openAgingPanel(); e.preventDefault(); }
        if(e.key==='s' || e.key==='S'){  openSupplierPanel(); e.preventDefault(); }
        if(e.key==='h' || e.key==='H'){  openHeadcountPanel(); e.preventDefault(); }
        if(e.key==='p' || e.key==='P'){  printReport(); e.preventDefault(); }
        if(e.key==='/' || e.key==='f' || e.key==='F'){
            document.getElementById('globalSearch')?.focus(); e.preventDefault();
        }
    });

    // ═══════════════════════════════════════════════════════
    // ── INIT on page load ──
    // ═══════════════════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', ()=>{
        applyPinnedState();
        initAgingBadge();
    });

</script>
