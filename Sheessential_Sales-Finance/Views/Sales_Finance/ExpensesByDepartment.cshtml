    function buildUtilitiesPanel(filterCat) {
        const caps = getCaps();
        const categories = [...new Set(UTILITY_EXPENSES.map(e => e.category))].sort();
        const all = filterCat === 'all' ? UTILITY_EXPENSES : UTILITY_EXPENSES.filter(e => e.category === filterCat);

        const tabsEl = document.getElementById('utilityTypeTabs');
        const tabs = [{ key:'all', label:'All' }, ...categories.map(c => ({ key:c, label:(UTIL_ICONS[c]||'🔌')+' '+c }))];
        tabsEl.innerHTML = tabs.map(t => `
            <button onclick="buildUtilitiesPanel('${t.key}')"
                class="px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${t.key===filterCat?'bg-white shadow text-cyan-700':'text-cyan-600 hover:text-cyan-800'}">
                ${esc(t.label)}
            </button>`).join('');

        document.getElementById('utilitiesPanelSubtitle').textContent =
            filterCat === 'all' ? `${UTILITY_EXPENSES.length} expense(s) across ${categories.length} category/ies` : `${all.length} ${filterCat} expense(s)`;

        const body = document.getElementById('utilitiesPanelBody');
        if (!all.length) { body.innerHTML = '<p class="text-gray-400 text-center py-12">No utility expenses found for this category.</p>'; return; }

        const total    = all.reduce((s,e)=>s+e.amount, 0);
        const approved = all.filter(e=>e.status==='Approved').reduce((s,e)=>s+e.amount, 0);
        const pending  = all.filter(e=>e.status==='Pending').reduce((s,e)=>s+e.amount, 0);
        const declined = all.filter(e=>e.status==='Declined').reduce((s,e)=>s+e.amount, 0);

        const byCat = {};
        all.forEach(e => { if(!byCat[e.category]) byCat[e.category]=[]; byCat[e.category].push(e); });
        const sortedCats = Object.keys(byCat).sort((a,b) => byCat[b].reduce((s,e)=>s+e.amount,0) - byCat[a].reduce((s,e)=>s+e.amount,0));

        let html = `
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            <div class="bg-cyan-50 rounded-xl p-3 border border-cyan-100"><p class="text-xs text-cyan-600 font-medium">Total</p><p class="text-lg font-bold text-cyan-700">${fmt(total)}</p></div>
            <div class="bg-green-50 rounded-xl p-3 border border-green-100"><p class="text-xs text-green-600 font-medium">Approved</p><p class="text-lg font-bold text-green-700">${fmt(approved)}</p></div>
            <div class="bg-yellow-50 rounded-xl p-3 border border-yellow-100"><p class="text-xs text-yellow-600 font-medium">Pending</p><p class="text-lg font-bold text-yellow-700">${fmt(pending)}</p></div>
            <div class="bg-red-50 rounded-xl p-3 border border-red-100"><p class="text-xs text-red-600 font-medium">Declined</p><p class="text-lg font-bold text-red-700">${fmt(declined)}</p></div>
        </div>`;

        sortedCats.forEach(cat => {
            const items = byCat[cat];
            const catTotal = items.reduce((s,e)=>s+e.amount, 0);
            const color = UTIL_PALETTE[cat] || '#9ca3af';
            const icon  = UTIL_ICONS[cat] || '🔌';
            const cap   = caps[cat] || null;

            // ── Cap indicator ──
            let capHtml = '';
            if (cap) {
                const pct     = Math.min(Math.round((catTotal / cap) * 100), 100);
                const over    = catTotal > cap;
                const near    = !over && pct >= 80;
                const barColor = over ? '#ef4444' : near ? '#f59e0b' : '#10b981';
                const bgColor  = over ? 'bg-red-50 border-red-200' : near ? 'bg-yellow-50 border-yellow-200' : 'bg-green-50 border-green-100';
                const label    = over
                    ? `<span class="text-xs font-bold text-red-600">⚠ Over budget by ${fmt(catTotal - cap)}</span>`
                    : near
                    ? `<span class="text-xs font-bold text-yellow-600">⚠ ${pct}% of cap used</span>`
                    : `<span class="text-xs text-green-600 font-medium">${pct}% of cap used</span>`;
                capHtml = `
                <div class="mb-3 p-3 rounded-xl border ${bgColor}">
                    <div class="flex items-center justify-between mb-1.5">
                        ${label}
                        <span class="text-xs text-gray-500">${fmt(catTotal)} / ${fmt(cap)}</span>
                    </div>
                    <div class="h-2 bg-white rounded-full border border-gray-200">
                        <div class="h-2 rounded-full transition-all" style="width:${pct}%;background:${barColor}"></div>
                    </div>
                </div>`;
            }

            html += `<div class="mb-6">
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-sm font-semibold text-gray-900 flex items-center gap-2">
                        <span class="text-base">${icon}</span>
                        ${esc(cat)} <span class="text-gray-400 font-normal">(${items.length})</span>
                        ${cap ? `<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-gray-100 text-gray-500">Cap: ${fmt(cap)}</span>` : ''}
                    </h3>
                    <span class="text-sm font-bold" style="color:${color}">${fmt(catTotal)}</span>
                </div>
                ${capHtml}
                <div class="space-y-2">`;

            items.sort((a,b) => b.amount - a.amount).forEach(exp => {
                const badge = exp.status==='Pending'
                    ? '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>'
                    : exp.status==='Approved'
                        ? '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800">✓ Approved</span>'
                        : '<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-red-100 text-red-800">✕ Declined</span>';
                const notes = exp.status==='Declined'&&exp.notes
                    ? `<p class="text-[11px] text-red-600 mt-1">Reason: ${esc(exp.notes)}</p>` : '';
                html += `
                <div class="bg-gray-50 rounded-xl p-4 border border-gray-100">
                    <div class="flex items-start justify-between">
                        <div class="flex-1 mr-3">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-xs font-semibold text-cyan-600">${esc(exp.expenseId||'—')}</span>${badge}
                                <span class="text-[11px] text-gray-400">${esc(exp.department)}</span>
                            </div>
                            <p class="text-sm font-medium text-gray-800">${esc(exp.requestedBy||'')}</p>
                            <p class="text-xs text-gray-400 mt-0.5">${esc(exp.description||exp.expenseType||'')}</p>
                            <p class="text-[11px] text-gray-400 mt-1">${esc(exp.requestedAtDisplay)}</p>
                            ${notes}
                        </div>
                        <div class="text-right shrink-0">
                            <p class="text-sm font-bold text-gray-900">${fmt(exp.amount)}</p>
                        </div>
                    </div>
                </div>`;
            });

            html += `</div></div>`;
        });

        body.innerHTML = html;
    }

