    function buildIngredientOnlyPanel(requests){
        document.getElementById('panelTabs').innerHTML=`<button class="flex-1 px-4 py-2 rounded-lg text-sm font-medium bg-white shadow text-orange-600">Ingredient Requests (${requests.length})</button>`;
        const body=document.getElementById('panelBody');
        if(!requests.length){body.innerHTML='<p class="text-gray-400 text-center py-8">No ingredient requests</p>';return;}
        const pendingAmt=requests.filter(r=>r.status==='Pending').reduce((s,r)=>s+r.totalCost,0);const approvedAmt=requests.filter(r=>r.status&&r.status.startsWith('Approved')).reduce((s,r)=>s+r.totalCost,0);const declinedAmt=requests.filter(r=>r.status==='Declined').reduce((s,r)=>s+r.totalCost,0);
        let html=`<div class="grid grid-cols-3 gap-3 mb-6"><div class="bg-yellow-50 rounded-xl p-3 border border-yellow-200"><p class="text-xs text-yellow-700 font-medium">Pending</p><p class="text-lg font-bold text-yellow-800">${fmt(pendingAmt)}</p></div><div class="bg-green-50 rounded-xl p-3 border border-green-200"><p class="text-xs text-green-700 font-medium">Approved</p><p class="text-lg font-bold text-green-800">${fmt(approvedAmt)}</p></div><div class="bg-red-50 rounded-xl p-3 border border-red-200"><p class="text-xs text-red-700 font-medium">Declined</p><p class="text-lg font-bold text-red-800">${fmt(declinedAmt)}</p></div></div>`;
        const grouped={};requests.forEach(r=>{const k=r.supplierName||'Unknown';if(!grouped[k])grouped[k]=[];grouped[k].push(r);});
        Object.keys(grouped).sort((a,b)=>grouped[b].reduce((s,r)=>s+r.totalCost,0)-grouped[a].reduce((s,r)=>s+r.totalCost,0)).forEach(supplier=>{const items=grouped[supplier];const total=items.reduce((s,r)=>s+r.totalCost,0);html+=`<div class="mb-6"><div class="flex items-center justify-between mb-3"><h3 class="text-sm font-semibold text-gray-900">${esc(supplier)} <span class="text-gray-400 font-normal">(${items.length})</span></h3><span class="text-sm font-bold text-orange-600">${fmt(total)}</span></div><div class="space-y-2">`;items.forEach(r=>{const badge=r.status==='Pending'?'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-yellow-100 text-yellow-800">Pending</span>':r.status&&r.status.startsWith('Approved')?`<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800">✓ ${esc(r.status)}</span>`:'<span class="px-2 py-0.5 text-[10px] font-semibold rounded-full bg-red-100 text-red-800">✕ Declined</span>';const actions=r.status==='Pending'?`<div class="flex gap-1.5 mt-2"><button onclick="event.stopPropagation();approveIngredient('${r.id}','${r.expenseId||''}')" class="px-3 py-1 bg-green-600 text-white text-[11px] font-medium rounded-lg hover:bg-green-700">Approve</button><button onclick="event.stopPropagation();openDeclineModal('${r.id}','Stock Request',true)" class="px-3 py-1 bg-red-600 text-white text-[11px] font-medium rounded-lg hover:bg-red-700">Decline</button></div>`:'';html+=`<div class="bg-gray-50 rounded-xl p-4 border border-gray-100"><div class="flex items-start justify-between"><div class="flex-1 mr-3"><div class="flex items-center gap-2 mb-1"><span class="text-xs font-semibold text-orange-600">${esc(r.ingredientName)}</span>${badge}</div><p class="text-sm font-medium text-gray-800">${esc(r.requestedBy)}</p><p class="text-xs text-gray-400 mt-0.5">${r.quantityRequested} ${esc(r.unit)} • Stock: ${r.currentStock} • ${r.requestDate}</p></div><div class="text-right shrink-0"><p class="text-sm font-bold text-gray-900">${fmt(r.totalCost)}</p></div></div>${actions}</div>`;});html+='</div></div>';});
        body.innerHTML=html;
    }

    function openApproveModal(id,label,amount){document.getElementById('approveId').value=id;document.getElementById('approveExpenseLabel').textContent=label;document.getElementById('approveAmountDisplay').textContent=fmt(amount);document.getElementById('approveBalanceAfter').textContent=fmt(availableBalance-amount);document.getElementById('deptApproveModal').classList.remove('hidden');}
