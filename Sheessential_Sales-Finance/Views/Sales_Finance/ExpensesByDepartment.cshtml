    // ═══════════════════════════════════════════════════════
    // ── PINNED DEPARTMENTS (localStorage) ──
    // ═══════════════════════════════════════════════════════
    const PINNED_KEY = 'sheessential_pinned_depts';
    function getPinned(){ try{ return JSON.parse(localStorage.getItem(PINNED_KEY)||'[]'); }catch(e){ return []; } }
    function savePinned(arr){ localStorage.setItem(PINNED_KEY, JSON.stringify(arr)); }
    function togglePin(deptName, btn){
        let pinned = getPinned();
        const idx = pinned.indexOf(deptName);
        if(idx > -1){ pinned.splice(idx,1); }
        else{ pinned.push(deptName); }
        savePinned(pinned);
        applyPinnedState();
    }
    function applyPinnedState(){
        const pinned = getPinned();
        const grid = document.querySelector('.grid.grid-cols-1.sm\\:grid-cols-2');
        if(!grid) return;
        const cards = [...grid.children];
        // Sort: pinned first
        cards.forEach(card => {
            const btn = card.querySelector('.pin-btn');
            if(!btn) return;
            const dept = btn.dataset.dept;
            const isPinned = pinned.includes(dept);
            btn.classList.toggle('text-amber-400', isPinned);
            btn.classList.toggle('text-gray-300', !isPinned);
            card.style.order = isPinned ? '-1' : '0';
        });
    }

    // ═══════════════════════════════════════════════════════
    // ── UNDO TOAST ──
    // ═══════════════════════════════════════════════════════
    let undoTimer = null, undoAction = null;
    function showUndoToast(message, undoFn){
        clearTimeout(undoTimer);
        undoAction = undoFn;
        const toast = document.getElementById('undoToast');
        document.getElementById('undoToastMsg').textContent = message;
        const bar = document.getElementById('undoProgressBar');
        toast.classList.remove('hidden');
        // Reset progress bar
        bar.style.transition = 'none';
        bar.style.width = '100%';
        requestAnimationFrame(()=>{
            requestAnimationFrame(()=>{
                bar.style.transition = 'width 5s linear';
                bar.style.width = '0%';
            });
        });
        undoTimer = setTimeout(()=>{ toast.classList.add('hidden'); undoAction=null; }, 5000);
    }
    function dismissToast(){
        clearTimeout(undoTimer);
        document.getElementById('undoToast').classList.add('hidden');
        undoAction = null;
    }

    // ═══════════════════════════════════════════════════════
    // ── OPTIMISTIC UI — approve/decline without page reload ──
    // ═══════════════════════════════════════════════════════
    async function optimisticApprove(id, label, amount, formData){
        // Post to server
        try {
            const res = await fetch('/Sales_Finance/ApproveExpense', {
                method: 'POST',
                body: new URLSearchParams(formData)
            });
            if(res.ok || res.redirected){
                showUndoToast(`✓ Approved: ${label} (${fmt(amount)})`, ()=>{ location.reload(); });
                // Remove the action buttons from the DOM optimistically
                document.querySelectorAll(`[data-expense-id="${id}"]`).forEach(el => {
                    const actionDiv = el.querySelector('.optimistic-actions');
                    if(actionDiv) actionDiv.remove();
                    el.classList.add('opacity-50');
                    const badge = el.querySelector('.status-badge');
                    if(badge){ badge.className='px-2 py-0.5 text-[10px] font-semibold rounded-full bg-green-100 text-green-800 status-badge'; badge.textContent='✓ Approved'; }
                });
                closeApproveModal();
            } else {
                location.reload(); // fallback
            }
        } catch(err) {
            location.reload();
        }
    }

    // ═══════════════════════════════════════════════════════
    // ── GLOBAL SEARCH ──
    // ═══════════════════════════════════════════════════════
    function onGlobalSearch(query){
        const dd = document.getElementById('searchDropdown');
        if(!query || query.length < 2){ dd.classList.add('hidden'); return; }
        const q = query.toLowerCase();
        const results = [];

        // Search dept expenses
        REPORT_DEPT_DATA.forEach(dept => {
            dept.expenses.forEach(e => {
                if((e.description||'').toLowerCase().includes(q) ||
                   (e.expenseType||'').toLowerCase().includes(q) ||
                   (e.requestedBy||'').toLowerCase().includes(q) ||
                   String(e.amount).includes(q)){
                    results.push({ type:'expense', dept:dept.name, label:e.description||e.expenseType, sub:e.requestedBy+' • '+fmt(e.amount), status:e.status });
                }
            });
        });

        // Search utility expenses
        UTILITY_EXPENSES.forEach(e => {
            if((e.description||'').toLowerCase().includes(q) ||
               (e.expenseType||'').toLowerCase().includes(q) ||
               (e.requestedBy||'').toLowerCase().includes(q) ||
               (e.expenseId||'').toLowerCase().includes(q)){
                results.push({ type:'utility', dept:'Utilities', label:e.category+': '+(e.description||e.expenseType), sub:e.requestedBy+' • '+fmt(e.amount), status:e.status });
            }
        });

        // Search stock requests
        if(typeof ALL_EXPENSES_CMP !== 'undefined'){
            ALL_EXPENSES_CMP.forEach(e => {
                if((e.description||'').toLowerCase().includes(q) ||
                   (e.expenseType||'').toLowerCase().includes(q) ||
                   (e.department||'').toLowerCase().includes(q)){
                    if(!results.find(r=>r.label===e.description&&r.dept===e.department)){
                        results.push({ type:'all', dept:e.department, label:e.description||e.expenseType, sub:e.department+' • '+fmt(e.amount), status:e.status });
                    }
                }
            });
        }

        if(!results.length){
            dd.innerHTML='<div class="px-4 py-6 text-center text-sm text-gray-400">No results found for "<strong>'+esc(query)+'</strong>"</div>';
            dd.classList.remove('hidden');
            return;
        }

        const statusColor = s => s==='Approved'?'bg-green-100 text-green-800':s==='Pending'?'bg-yellow-100 text-yellow-800':'bg-red-100 text-red-800';
        const typeIcon = t => t==='utility'?'⚡':t==='expense'?'📋':'📦';

        dd.innerHTML = results.slice(0,12).map(r=>`
            <div class="px-4 py-3 hover:bg-gray-50 cursor-pointer border-b border-gray-100 last:border-0 flex items-start gap-3">
                <span class="text-base mt-0.5">${typeIcon(r.type)}</span>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-gray-800 truncate">${esc(r.label)}</p>
                    <p class="text-xs text-gray-400 truncate">${esc(r.sub)}</p>
                    <p class="text-[10px] text-gray-400">${esc(r.dept)}</p>
                </div>
                <span class="px-2 py-0.5 text-[10px] font-semibold rounded-full shrink-0 ${statusColor(r.status)}">${esc(r.status)}</span>
            </div>`).join('') + (results.length>12?`<div class="px-4 py-2 text-center text-xs text-gray-400">${results.length-12} more results…</div>`:'');

        dd.classList.remove('hidden');
    }

    document.addEventListener('click', e => {
        if(!e.target.closest('#globalSearch') && !e.target.closest('#searchDropdown')){
            document.getElementById('searchDropdown').classList.add('hidden');
