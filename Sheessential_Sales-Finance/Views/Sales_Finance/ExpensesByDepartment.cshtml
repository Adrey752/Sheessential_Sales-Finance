    function renderCmpActive() {
        const data = cmpFilteredExpenses();
        buildCmpKpiStrip(data);
        if      (cmpActiveTab==='monthly')    renderCmpMonthly(data);
        else if (cmpActiveTab==='period')     renderCmpPeriod(data);
        else if (cmpActiveTab==='category')   renderCmpCategory(data);
        else if (cmpActiveTab==='department') renderCmpDepartment(data);
        else if (cmpActiveTab==='status')     renderCmpStatus(data);
        else if (cmpActiveTab==='yoy')        renderCmpYoY(data);
