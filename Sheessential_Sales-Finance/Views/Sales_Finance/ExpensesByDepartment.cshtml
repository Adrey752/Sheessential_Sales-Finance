    function closeSupplierPanel(){
        const c = document.getElementById('supplierPanelContent');
        c.classList.remove('translate-x-0'); c.classList.add('translate-x-full');
        setTimeout(()=>document.getElementById('supplierPanel').classList.add('hidden'), 300);
    }

    function buildSupplierPanel(){
        const body = document.getElementById('supplierPanelBody');
        const supplierMap = {};
        (window.STOCK_REQUESTS_DATA||[]).forEach(r => {
            const s = r.supplierName || 'Unknown';
            if(!supplierMap[s]) supplierMap[s] = { total:0, count:0, approved:0, pending:0, declined:0, items:[] };
            supplierMap[s].total += r.totalCost;
            supplierMap[s].count++;
            supplierMap[s].items.push(r);
            if(r.status&&r.status.startsWith('Approved')) supplierMap[s].approved += r.totalCost;
            else if(r.status==='Pending') supplierMap[s].pending += r.totalCost;
            else if(r.status==='Declined') supplierMap[s].declined += r.totalCost;
        });

        const suppliers = Object.entries(supplierMap).sort((a,b)=>b[1].total-a[1].total);
        const grandTotal = suppliers.reduce((s,[,v])=>s+v.total, 0);

        if(!suppliers.length){ body.innerHTML='<p class="text-gray-400 text-center py-12">No supplier data available.</p>'; return; }

        const sPalette = ['#f97316','#f59e0b','#eab308','#84cc16','#22c55e','#06b6d4','#6366f1','#ec4899'];
        let html = `<div class="mb-5 p-3 bg-orange-50 border border-orange-200 rounded-xl text-sm text-orange-800">
            <strong>${suppliers.length} supplier${suppliers.length>1?'s':''}</strong> · Total spend: <strong>${fmt(grandTotal)}</strong>
        </div>`;

        suppliers.forEach(([name, v], i) => {
            const pct = grandTotal ? Math.round(v.total/grandTotal*100) : 0;
            const color = sPalette[i % sPalette.length];
            const medal = i===0?'🥇':i===1?'🥈':i===2?'🥉':`<span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-gray-100 text-gray-500 text-xs font-bold">${i+1}</span>`;
            html += `<div class="bg-white rounded-xl border border-gray-100 p-4 mb-3 hover:shadow-sm transition">
                <div class="flex items-start justify-between mb-2">
                    <div class="flex items-center gap-2">
                        <span class="text-lg">${medal}</span>
                        <div>
                            <p class="text-sm font-semibold text-gray-900">${esc(name)}</p>
                            <p class="text-xs text-gray-400">${v.count} request(s)</p>
                        </div>
                    </div>
                    <p class="text-sm font-bold" style="color:${color}">${fmt(v.total)}</p>
                </div>
                <div class="h-1.5 bg-gray-100 rounded-full mb-2">
                    <div class="h-1.5 rounded-full" style="width:${pct}%;background:${color}"></div>
                </div>
                <div class="flex gap-3 text-xs">
                    <span class="text-green-600">Approved: ${fmt(v.approved)}</span>
                    <span class="text-yellow-600">Pending: ${fmt(v.pending)}</span>
                    <span class="text-red-600">Declined: ${fmt(v.declined)}</span>
                </div>
            </div>`;
        });

        body.innerHTML = html;
    }

    // ─── HEADCOUNT VS PAYROLL ───
    function openHeadcountPanel(){
        const panel = document.getElementById('headcountPanel');
        const content = document.getElementById('headcountPanelContent');
        buildHeadcountPanel();
        panel.classList.remove('hidden');
        requestAnimationFrame(()=>{ content.classList.remove('translate-x-full'); content.classList.add('translate-x-0'); });
