    function closeHeadcountPanel(){
        const c = document.getElementById('headcountPanelContent');
        c.classList.remove('translate-x-0'); c.classList.add('translate-x-full');
        setTimeout(()=>document.getElementById('headcountPanel').classList.add('hidden'), 300);
    }

    function buildHeadcountPanel(){
        const body = document.getElementById('headcountPanelBody');
        const deptMap = {};
        (window.PAYROLL_DEPT_DATA||[]).forEach(cutoff => {
            (cutoff.departments||[]).forEach(d => {
                if(!deptMap[d.name]) deptMap[d.name] = { totalGross:0, totalNet:0, totalDeductions:0, headcount:new Set(), cutoffs:0 };
                deptMap[d.name].totalGross += d.grossSalary;
                deptMap[d.name].totalNet += d.netSalary;
                deptMap[d.name].totalDeductions += d.totalDeductions;
                deptMap[d.name].cutoffs++;
                (d.employees||[]).forEach(e => deptMap[d.name].headcount.add(e.employeeId||e.employeeName));
            });
        });

        const depts = Object.entries(deptMap).sort((a,b)=>b[1].totalGross-a[1].totalGross);
        if(!depts.length){ body.innerHTML='<p class="text-gray-400 text-center py-12">No payroll data available.</p>'; return; }

        const grandGross = depts.reduce((s,[,v])=>s+v.totalGross, 0);
        const sPalette = ['#8b5cf6','#6366f1','#3b82f6','#06b6d4','#14b8a6','#10b981','#84cc16','#f59e0b'];

        let html = `<div class="mb-5 p-3 bg-purple-50 border border-purple-200 rounded-xl text-sm text-purple-800">
            Total payroll across all cutoffs: <strong>${fmt(grandGross)}</strong>
            <span class="text-xs text-purple-600 ml-2">(all cutoffs combined)</span>
        </div>`;

        html += `<div class="overflow-x-auto rounded-xl border border-gray-200 mb-5">
            <table class="w-full text-sm border-collapse">
                <thead><tr class="bg-purple-50 border-b border-purple-100">
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Department</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Headcount</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Total Gross</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Cost/Head</th>
                    <th class="px-3 py-2 text-left text-xs font-semibold text-purple-700 uppercase">Net Pay</th>
                </tr></thead>
                <tbody class="divide-y divide-gray-100">`;

        depts.forEach(([name, v], i) => {
            const hc = v.headcount.size || 1;
            const costPerHead = v.totalGross / hc;
            const pct = grandGross ? Math.round(v.totalGross/grandGross*100) : 0;
            const color = sPalette[i % sPalette.length];
            html += `<tr class="hover:bg-purple-50 transition">
                <td class="px-3 py-3">
                    <div class="flex items-center gap-2">
                        <div class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${color}"></div>
                        <span class="font-medium text-gray-800 text-sm">${esc(name)}</span>
                    </div>
                    <div class="h-1 bg-gray-100 rounded-full mt-1.5 ml-4">
                        <div class="h-1 rounded-full" style="width:${pct}%;background:${color}"></div>
                    </div>
                </td>
                <td class="px-3 py-3 text-sm font-semibold text-purple-700">${hc}</td>
                <td class="px-3 py-3 text-sm font-bold text-gray-900">${fmt(v.totalGross)}</td>
                <td class="px-3 py-3 text-sm text-indigo-700 font-semibold">${fmt(costPerHead)}</td>
                <td class="px-3 py-3 text-sm text-green-700">${fmt(v.totalNet)}</td>
            </tr>`;
        });

        html += `</tbody></table></div>`;

        html += `<div class="space-y-3">`;
        depts.forEach(([name, v], i) => {
            const hc = v.headcount.size || 1;
            const costPerHead = v.totalGross / hc;
            const deductRate = v.totalGross > 0 ? Math.round(v.totalDeductions/v.totalGross*100) : 0;
            const color = sPalette[i % sPalette.length];
            html += `<div class="bg-white rounded-xl border border-gray-100 p-4">
                <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full" style="background:${color}"></div>
                        <p class="text-sm font-semibold text-gray-900">${esc(name)}</p>
                        <span class="text-xs text-gray-400">${hc} employee${hc>1?'s':''}</span>
                    </div>
                    <span class="text-sm font-bold text-gray-900">${fmt(v.totalGross)}</span>
                </div>
                <div class="grid grid-cols-3 gap-2 text-xs">
                    <div class="bg-purple-50 rounded-lg p-2 text-center">
                        <p class="text-purple-500">Cost/Head</p>
                        <p class="font-bold text-purple-800">${fmt(costPerHead)}</p>
                    </div>
                    <div class="bg-green-50 rounded-lg p-2 text-center">
                        <p class="text-green-500">Net Pay</p>
                        <p class="font-bold text-green-800">${fmt(v.totalNet)}</p>
                    </div>
                    <div class="bg-red-50 rounded-lg p-2 text-center">
                        <p class="text-red-500">Ded Rate</p>
                        <p class="font-bold text-red-800">${deductRate}%</p>
                    </div>
                </div>
            </div>`;
        });
        html += `</div>`;

        body.innerHTML = html;
    }

    async function updateEmployeePayrollStatus(snapshotId, status, declineReason = '') {
        try {
            const body = `snapshotId=${encodeURIComponent(snapshotId)}&status=${encodeURIComponent(status)}&declineReason=${encodeURIComponent(declineReason || '')}`;
            const res = await fetch('/Sales_Finance/ReleasePayrollEmployee', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body
            });

            const raw = await res.text();
            let data;
            try { data = JSON.parse(raw); }
            catch { alert('❌ Server error: ' + raw); return; }

            if (res.ok && data.success) {
                closeEmployeeModal();
                if (typeof showUndoToast === 'function') {
                    showUndoToast('✓ ' + (data.message || 'Employee payroll updated.'), () => { });
                    setTimeout(() => location.reload(), 1100);
                } else {
                    alert('✅ ' + (data.message || 'Employee payroll updated.'));
                    location.reload();
                }
            } else {
                alert('❌ ' + (data.message || 'Error updating employee payroll.'));
            }
        } catch (err) {
            alert('❌ ' + err.message);
        }
    }

    function approveEmployeePayroll(snapshotId) {
        if (!snapshotId) return alert('❌ Missing employee payroll snapshot ID.');
        if (!confirm('Approve this employee payroll?')) return;
        updateEmployeePayrollStatus(snapshotId, 'Completed', '');
    }

    function declineEmployeePayroll(snapshotId) {
        if (!snapshotId) return alert('❌ Missing employee payroll snapshot ID.');
        const reason = prompt('Please enter reason for declining this employee payroll:');
        if (reason === null) return;
        const trimmed = reason.trim();
        if (!trimmed) return alert('❌ Decline reason is required.');
        updateEmployeePayrollStatus(snapshotId, 'Declined', trimmed);
    }

    // Override with per-employee actions enabled
    function showEmployeeBreakdown(emp){
        document.getElementById('empModalName').textContent=emp.employeeName;
        document.getElementById('empModalPosition').textContent=emp.position||'Position not set';

        const statusRaw = (emp.status || '').trim();
        const statusLower = statusRaw.toLowerCase();
        const isCompleted = statusLower === 'completed' || statusLower === 'approved';
        const isDeclined = statusLower === 'declined';
        const canApprove = !isCompleted;
        const canDecline = !isDeclined && !isCompleted;

        const remarksHtml = emp.remarks
            ? `<div class="mb-4 bg-red-50 border border-red-200 rounded-xl p-3"><p class="text-xs font-bold text-red-700 uppercase mb-1">Decline Reason</p><p class="text-sm text-red-800">${esc(emp.remarks)}</p></div>`
            : '';

        const statusBadge = isCompleted
            ? '<span class="px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">Completed</span>'
            : isDeclined
                ? '<span class="px-2 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">Declined</span>'
                : `<span class="px-2 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">${esc(statusRaw || 'Pending')}</span>`;

        const actionButtons = emp.snapshotId
            ? `<div class="flex gap-2 mb-4">
                    <button onclick="approveEmployeePayroll('${emp.snapshotId}')" ${canApprove ? '' : 'disabled'} class="px-3 py-2 rounded-lg text-sm font-medium ${canApprove ? 'bg-green-600 hover:bg-green-700 text-white' : 'bg-gray-200 text-gray-400 cursor-not-allowed'}">Approve</button>
                    <button onclick="declineEmployeePayroll('${emp.snapshotId}')" ${canDecline ? '' : 'disabled'} class="px-3 py-2 rounded-lg text-sm font-medium ${canDecline ? 'bg-red-600 hover:bg-red-700 text-white' : 'bg-gray-200 text-gray-400 cursor-not-allowed'}">Decline</button>
               </div>`
            : '<p class="text-xs text-red-500 mb-4">Snapshot ID missing. Cannot update status.</p>';

        const body=document.getElementById('empModalBody');
        body.innerHTML=`
            <div class="flex items-center justify-between mb-4">${statusBadge}</div>
            ${remarksHtml}
            ${actionButtons}
            <div class="grid grid-cols-3 gap-3 mb-5">
                <div class="bg-indigo-50 p-3 rounded-xl border border-indigo-200"><p class="text-[10px] text-indigo-700 font-medium">Gross</p><p class="text-sm font-bold text-indigo-900">${fmt(emp.grossSalary)}</p></div>
                <div class="bg-red-50 p-3 rounded-xl border border-red-200"><p class="text-[10px] text-red-700 font-medium">Deductions</p><p class="text-sm font-bold text-red-900">${fmt(emp.totalDeductions)}</p></div>
                <div class="bg-green-50 p-3 rounded-xl border border-green-200"><p class="text-[10px] text-green-700 font-medium">Net Pay</p><p class="text-sm font-bold text-green-900">${fmt(emp.netSalary)}</p></div>
            </div>
            <div class="bg-gray-50 rounded-xl p-4 border mb-4">
                <h4 class="text-xs font-bold text-gray-700 uppercase mb-2">Attendance</h4>
                <div class="grid grid-cols-3 gap-3 text-xs">
                    <div class="flex justify-between"><span class="text-gray-500">Present</span><span class="font-medium">${emp.daysPresent} / ${emp.totalWorkingDays}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Absent</span><span class="font-medium">${emp.daysAbsent}</span></div>
                    <div class="flex justify-between"><span class="text-gray-500">Late</span><span class="font-medium">${emp.daysLate}x (${emp.minutesLate} min)</span></div>
                </div>
            </div>`;

        document.getElementById('employeeModal').classList.remove('hidden');
    }

    // ─── PRINT / PDF ───
    function printReport() {
        var status = document.getElementById('rFilterStatus').value;
        var sortBy = document.getElementById('rSortBy').value;
        window.open('/Sales_Finance/ExpenseReportPrint?status=' + status + '&sortBy=' + sortBy, '_blank');
    }

    // ─── ESCAPE KEY — close panels ───
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            closeDeptPanel();
            closeUtilitiesPanel();
            closeApproveModal();
            closeDeclineModal();
            closePayrollConfirm();
            closeEmployeeModal();
            closeReport();
            closeUtilitiesComparison();
            closeAgingPanel();
            closeNewRequestPanel();
            closeSupplierPanel();
            closeHeadcountPanel();
            closeCapsModal();
            closeExpenseDetailsModal();
            closeAddExpenseModal();
            document.getElementById('searchDropdown').classList.add('hidden');
        }
    });

    // ─── INIT ───
    document.addEventListener('DOMContentLoaded', ()=>{
        applyPinnedState();
        initNewRequestBadge();
        initAgingBadge();

        const addExpenseModal = document.getElementById('addExpenseModal');
        const quickForm = document.getElementById('quickExpenseForm');
        const deptSel = document.getElementById('quickDepartment');
        const typeSel = document.getElementById('quickExpenseType');
        const typeOther = document.getElementById('quickExpenseTypeOther');

        deptSel?.addEventListener('change', renderQuickExpenseCategories);
        typeSel?.addEventListener('change', ()=>{
            if(!typeOther) return;
            if(typeSel.value === '__other__'){
                typeOther.classList.remove('hidden');
                typeOther.focus();
            } else {
                typeOther.classList.add('hidden');
                typeOther.value = '';
            }
        });

        addExpenseModal?.addEventListener('click', (e)=>{
            if(e.target === addExpenseModal) closeAddExpenseModal();
        });

        quickForm?.addEventListener('submit', async (e)=>{
            e.preventDefault();

            const formData = new FormData(quickForm);
            const selectedCategory = typeSel?.value || '';
            if(!selectedCategory){
                alert('Please select an expense category.');
                typeSel?.focus();
                return;
            }

            let finalCategory = selectedCategory;
            if(selectedCategory === '__other__'){
                const custom = (typeOther?.value || '').trim();
                if(!custom){
                    alert('Please specify the expense category.');
                    typeOther?.focus();
                    return; 
                }
                finalCategory = custom;
            }

            formData.set('ExpenseType', finalCategory);

            try {
                const res = await fetch('/Sales_Finance/AddExpense', { method:'POST', body: formData });
                const data = await res.json();
                if(data.success){
                    showActionNotice('Expense request submitted successfully.', 'success');
                    setTimeout(()=>location.reload(), 900);
                } else {
                    showActionNotice(data.message || 'Failed to submit expense request.', 'error');
                }
            } catch(err){
                showActionNotice(err.message || 'An error occurred while submitting the request.', 'error');
            }
        });
    });

</script>
