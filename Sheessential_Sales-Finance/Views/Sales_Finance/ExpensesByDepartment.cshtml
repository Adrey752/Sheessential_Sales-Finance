@using Sheessential_Sales_Finance.Models
@using Newtonsoft.Json
@model ExpensesWithBalanceViewModel

@{
    ViewData["Title"] = "Expenses by Department";

    var expenses = Model?.Expenses ?? new List<Expenses>();
    var stockRequests = Model?.StockRequests ?? new List<IngredientStockRequestDisplayModel>();
    var payrollSnapshots = Model?.PayrollSnapshots ?? new List<PayrollSnapshot>();
    var currentBalance = Model?.Balance?.CurrentBalance ?? 0;

    // ── 1. Expense departments ──
    var deptFromExpenses = expenses
        .GroupBy(e => string.IsNullOrWhiteSpace(e.Department) ? "Unassigned" : e.Department.Trim())
        .ToDictionary(g => g.Key, g => g.ToList());

    var allDeptNames = deptFromExpenses.Keys.OrderBy(d => d).ToList();

    // ── 2. Utilities — pulled from ExpenseType matching utility keywords ──
    var utilityKeywords = new[] { "water", "electricity", "electric", "internet", "wifi", "wi-fi", "gas", "phone", "telephone", "cable", "waste", "sewage", "garbage", "trash", "cooling", "heating", "hvac", "utility", "utilities", "power", "energy" };

    var utilityExpenses = expenses
        .Where(e => utilityKeywords.Any(k =>
            (!string.IsNullOrWhiteSpace(e.ExpenseType) && e.ExpenseType.ToLower().Contains(k)) ||
            (!string.IsNullOrWhiteSpace(e.Description) && e.Description.ToLower().Contains(k))))
        .ToList();

    // Group utilities by their type/description for the card display
    var utilityByType = utilityExpenses
        .GroupBy(e =>
        {
            var combined = ((e.ExpenseType ?? "") + " " + (e.Description ?? "")).ToLower();
            if (combined.Contains("water")) return "Water";
            if (combined.Contains("electric") || combined.Contains("power") || combined.Contains("energy")) return "Electricity";
            if (combined.Contains("internet") || combined.Contains("wifi") || combined.Contains("wi-fi")) return "Internet";
            if (combined.Contains("gas")) return "Gas";
            if (combined.Contains("phone") || combined.Contains("telephone")) return "Phone";
            if (combined.Contains("cable")) return "Cable";
            if (combined.Contains("waste") || combined.Contains("garbage") || combined.Contains("trash") || combined.Contains("sewage")) return "Waste";
            if (combined.Contains("cooling") || combined.Contains("heating") || combined.Contains("hvac")) return "HVAC";
            return "Other Utilities";
        })
        .Select(g => new
        {
            type = g.Key,
            total = g.Sum(e => e.Amount),
            count = g.Count(),
            pending = g.Count(e => e.Status == "Pending"),
            pendingAmt = g.Where(e => e.Status == "Pending").Sum(e => e.Amount),
            approved = g.Count(e => e.Status == "Approved"),
            approvedAmt = g.Where(e => e.Status == "Approved").Sum(e => e.Amount),
            declined = g.Count(e => e.Status == "Declined"),
            declinedAmt = g.Where(e => e.Status == "Declined").Sum(e => e.Amount)
        })
        .OrderByDescending(x => x.total)
        .ToList();

    var utilityTotal = utilityExpenses.Sum(e => e.Amount);
    var utilityPending = utilityExpenses.Count(e => e.Status == "Pending");
    var utilityPendingAmt = utilityExpenses.Where(e => e.Status == "Pending").Sum(e => e.Amount);
    var utilityApproved = utilityExpenses.Count(e => e.Status == "Approved");
    var utilityApprovedAmt = utilityExpenses.Where(e => e.Status == "Approved").Sum(e => e.Amount);
    var utilityDeclined = utilityExpenses.Count(e => e.Status == "Declined");
    var utilityDeclinedAmt = utilityExpenses.Where(e => e.Status == "Declined").Sum(e => e.Amount);

    // Utility expenses serialized for JS (with month/date info for comparison)
    var utilityExpensesJson = utilityExpenses.Select(e => new
    {
        id = e.Id,
        expenseId = e.ExpenseId,
        expenseType = e.ExpenseType,
        description = e.Description,
        amount = e.Amount,
        status = e.Status,
        requestedBy = e.RequestedBy,
        requestedAt = e.RequestedAt.ToString("yyyy-MM-dd"),
        requestedAtDisplay = e.RequestedAt.ToString("MMM dd, yyyy"),
        month = e.RequestedAt.ToString("yyyy-MM"),
        monthLabel = e.RequestedAt.ToString("MMM yyyy"),
        department = string.IsNullOrWhiteSpace(e.Department) ? "Unassigned" : e.Department.Trim(),
        notes = e.Notes ?? "",
        utilityCategory = utilityKeywords.Any(k => (!string.IsNullOrWhiteSpace(e.ExpenseType) && e.ExpenseType.ToLower().Contains(k)) ? k.Contains("electric") || k.Contains("power") || k.Contains("energy") : false)
            ? "Electricity"
            : ""
    }).ToList();

    // All expenses serialized for comparison (includes month info)
    var allExpensesForCompare = expenses.Select(e => new
    {
        expenseType = e.ExpenseType ?? "Other",
        description = e.Description ?? "",
        amount = e.Amount,
        status = e.Status,
        month = e.RequestedAt.ToString("yyyy-MM"),
        monthLabel = e.RequestedAt.ToString("MMM yyyy"),
        department = string.IsNullOrWhiteSpace(e.Department) ? "Unassigned" : e.Department.Trim(),
        requestedAt = e.RequestedAt.ToString("yyyy-MM-dd")
    }).ToList();

    // ── 3. Payroll snapshots ──
    var payrollCutoffs = payrollSnapshots
        .GroupBy(p => new { p.PayPeriodStart, p.PayPeriodEnd })
        .OrderByDescending(g => g.Key.PayPeriodStart)
        .Select(g => new
        {
            id = $"{g.Key.PayPeriodStart:yyyyMMdd}-{g.Key.PayPeriodEnd:yyyyMMdd}",
            payRunNumber = $"{g.Key.PayPeriodStart:MMM dd} – {g.Key.PayPeriodEnd:MMM dd}",
            payPeriod = $"{g.Key.PayPeriodStart:MMM dd} – {g.Key.PayPeriodEnd:MMM dd, yyyy}",
            payDate = g.Max(x => x.ProcessedAt).ToString("MMM dd, yyyy"),
            payType = "Snapshot",
            cutoffHalf = g.Key.PayPeriodStart.Day <= 15 ? "1st Half" : "2nd Half",
            cutoffLabel = $"{g.Key.PayPeriodStart:MMM yyyy} ({(g.Key.PayPeriodStart.Day <= 15 ? "1st – 15th" : $"16th – {DateTime.DaysInMonth(g.Key.PayPeriodStart.Year, g.Key.PayPeriodStart.Month)}th")})",
            status = g.All(x => x.Status == "Completed") ? "Completed" : g.FirstOrDefault()?.Status ?? "Completed",
            isPaid = g.All(x => x.Status == "Completed"),
            totalEmployees = g.Count(),
            grossSalary = g.Sum(x => x.GrossPay),
            netSalary = g.Sum(x => x.NetPay),
            totalDeductions = g.Sum(x => x.TotalDeductions),
            overtimePay = g.Sum(x => x.TotalOvertime),
            fullGross = g.Sum(x => x.GrossPay),
            fullNet = g.Sum(x => x.NetPay),
            departments = g
                .GroupBy(i => string.IsNullOrWhiteSpace(i.Department) ? "Unassigned" : i.Department.Trim())
                .OrderBy(d => d.Key)
                .Select(d => new
                {
                    name = d.Key,
                    employeeCount = d.Count(),
                    grossSalary = d.Sum(x => x.GrossPay),
                    netSalary = d.Sum(x => x.NetPay),
                    totalDeductions = d.Sum(x => x.TotalDeductions),
                    overtimePay = d.Sum(x => x.TotalOvertime),
                    sss = d.Sum(x => x.SssDeduction),
                    philHealth = d.Sum(x => x.PhilhealthDeduction),
                    pagIbig = d.Sum(x => x.PagibigDeduction),
                    withholdingTax = d.Sum(x => x.WithholdingTax),
                    sssLoan = 0m,
                    pagIbigLoan = 0m,
                    companyLoan = 0m,
                    absencePenalty = d.Sum(x => x.AbsenceDeduction),
                    latePenalty = d.Sum(x => x.TotalPenalties),
                    unpaidLeave = 0m,
                    otherDeductions = d.Sum(x => x.TotalLoans),
                    allowances = d.Sum(x => x.HousingAllowance + x.TransportAllowance + x.MealAllowance + x.OtherAllowances),
                    bonuses = 0m,
                    holidayPay = d.Sum(x => x.HolidayPay + x.SpecialDayPay),
                    nightDiff = 0m,
                    employees = d.Select(e => new
                    {
                        employeeId = e.EmployeeId,
                        employeeName = e.FullName,
                        position = "",
                        basicSalary = e.BasicSalary,
                        proratedBasic = e.BasicSalary,
                        grossSalary = e.GrossPay,
                        netSalary = e.NetPay,
                        totalDeductions = e.TotalDeductions,
                        overtimePay = e.TotalOvertime,
                        allowances = e.HousingAllowance + e.TransportAllowance + e.MealAllowance + e.OtherAllowances,
                        bonuses = 0m,
                        holidayPay = e.HolidayPay + e.SpecialDayPay,
                        nightDiff = 0m,
                        otherEarnings = e.ExcessDaysPay,
                        sss = e.SssDeduction,
                        philHealth = e.PhilhealthDeduction,
                        pagIbig = e.PagibigDeduction,
                        withholdingTax = e.WithholdingTax,
                        sssLoan = 0m,
                        pagIbigLoan = 0m,
                        companyLoan = 0m,
                        absencePenalty = e.AbsenceDeduction,
                        latePenalty = e.TotalPenalties,
                        unpaidLeave = 0m,
                        otherDeductions = e.TotalLoans,
                        daysPresent = e.DaysPresent,
                        daysAbsent = e.DaysAbsent,
                        totalWorkingDays = e.DaysWorked,
                        daysLate = 0,
                        minutesLate = 0,
                        regularOT = 0m,
                        holidayOT = 0m,
                        nightDiffHours = 0m,
                        status = e.Status ?? ""
                    }).OrderBy(e => e.employeeName).ToList()
                }).ToList()
        }).ToList();

    var stockRequestsJson = stockRequests.Select(r => new
    {
        id = r.Id,
        expenseId = r.ExpenseId,
        ingredientName = r.IngredientName,
        supplierName = r.SupplierName,
        requestedBy = r.RequestedBy,
        quantityRequested = r.QuantityRequested,
        unit = r.Unit,
        totalCost = r.TotalCost,
        currentStock = r.CurrentStockAtRequest,
        status = r.RequestStatus,
        requestDate = r.RequestDate?.ToString("MMM dd, yyyy") ?? "",
        instructions = r.Instructions ?? ""
    }).ToList();

    var deptDataForReport = deptFromExpenses.Select(kvp => new
    {
        name = kvp.Key,
        expenses = kvp.Value.Select(e => new
        {
            expenseType = e.ExpenseType,
            description = e.Description,
            amount = e.Amount,
            status = e.Status,
            requestedBy = e.RequestedBy,
            isoDate = e.RequestedAt.ToString("yyyy-MM-dd")
        })
    }).ToList();

    var ingredientTotal = stockRequests.Sum(r => r.TotalCost);
    var payrollTotal = payrollSnapshots.Sum(p => p.GrossPay);
    var grandTotal = expenses.Sum(e => e.Amount) + ingredientTotal + payrollTotal;
}

<div class="p-6 bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">

    <!-- Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-[#A36A66]">Expenses by Department</h1>
            <p class="text-sm text-gray-500 mt-1">All expense requests, ingredient requests & payroll — grouped per department</p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
            <!-- ═══ GLOBAL SEARCH ═══ -->
            <div class="relative">
                <input type="text" id="globalSearch" placeholder="Search expenses, people, IDs…"
                       oninput="onGlobalSearch(this.value)"
                       class="pl-9 pr-4 py-2 rounded-xl border border-gray-200 text-sm bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#A36A66]/40 w-56 shadow-sm" />
                <svg class="w-4 h-4 text-gray-400 absolute left-2.5 top-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0" /></svg>
                <div id="searchDropdown" class="hidden absolute top-full right-0 mt-1 w-96 bg-white rounded-xl shadow-2xl border border-gray-200 z-[80] max-h-80 overflow-y-auto"></div>
            </div>
            <!-- ═══ NOTIFICATION BADGE ═══ -->
            <button onclick="openAgingPanel()" id="agingBadgeBtn"
                    class="hidden px-4 py-2.5 bg-amber-500 text-white rounded-xl hover:opacity-90 transition-all shadow-md items-center gap-2 text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                <span id="agingBadgeCount">0</span> Aging
            </button>
            <!-- ═══ GENERATE REPORT BUTTON ═══ -->
            <button onclick="openReport()"
                    class="px-5 py-2.5 bg-indigo-600 text-white rounded-xl hover:opacity-90 transition-all shadow-md flex items-center gap-2 text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                </svg>
                Generate Report
            </button>
            <a href="@Url.Action("Expenses", "Sales_Finance")"
               class="px-5 py-2.5 bg-[#A36A66] text-white rounded-xl hover:opacity-90 transition-all shadow-md flex items-center gap-2 text-sm font-medium">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Back to Expenses
            </a>
        </div>
    </div>

    <!-- Grand Total Banner -->
    <div class="bg-white rounded-2xl shadow-md p-6 mb-8 border border-gray-100">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-[#A36A66]/10 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                </div>
                <div>
                    <p class="text-sm text-gray-500 font-medium">Overall Total</p>
                    <p class="text-3xl font-bold text-[#A36A66]">₱@grandTotal.ToString("N2")</p>
                </div>
            </div>
            <div class="flex gap-6 text-right">
                <div><p class="text-xs text-gray-400">Departments</p><p class="text-xl font-bold text-gray-800">@allDeptNames.Count</p></div>
                <div><p class="text-xs text-gray-400">Balance</p><p class="text-xl font-bold text-green-600">₱@currentBalance.ToString("N2")</p></div>
            </div>
        </div>
    </div>

    <!-- ═══ DEPARTMENT CARDS ═══ -->
    <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
        Departments
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-10">
        @foreach (var deptName in allDeptNames)
        {
            var deptExpenses = deptFromExpenses.GetValueOrDefault(deptName) ?? new List<Expenses>();
            var expTotal = deptExpenses.Sum(e => e.Amount);
            var expPending = deptExpenses.Count(e => e.Status == "Pending");
            var expPendingAmt = deptExpenses.Where(e => e.Status == "Pending").Sum(e => e.Amount);
            var expApproved = deptExpenses.Count(e => e.Status == "Approved");
            var expApprovedAmt = deptExpenses.Where(e => e.Status == "Approved").Sum(e => e.Amount);
            var expDeclined = deptExpenses.Count(e => e.Status == "Declined");
            var expDeclinedAmt = deptExpenses.Where(e => e.Status == "Declined").Sum(e => e.Amount);

            var deptExpJson = deptExpenses.Select(e => new
            {
                id = e.Id,
                expenseId = e.ExpenseId,
                expenseType = e.ExpenseType,
                description = e.Description,
                amount = e.Amount,
                requestedBy = e.RequestedBy,
                status = e.Status,
                requestedAt = e.RequestedAt.ToString("MMM dd, yyyy"),
                isoDate = e.RequestedAt.ToString("yyyy-MM-dd"),
                dateApproved = e.DateApproved?.ToString("MMM dd, yyyy") ?? "",
                notes = e.Notes
            }).ToList();

            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100 flex flex-col cursor-pointer"
                 onclick='openDeptPanel("department", @Html.Raw(JsonConvert.SerializeObject(deptName)), @Html.Raw(JsonConvert.SerializeObject(deptExpJson)), [])'>
                <div class="p-5 border-b border-gray-100">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-[#A36A66]/10 rounded-lg flex items-center justify-center">
                                <span class="text-[#A36A66] font-bold text-sm">@deptName.Substring(0, Math.Min(2, deptName.Length)).ToUpper()</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-semibold text-gray-900">@deptName</h3>
                                <p class="text-xs text-gray-400">@deptExpenses.Count expense request(s)</p>
                            </div>
                        </div>
                        <button onclick="event.stopPropagation();togglePin(@Html.Raw(JsonConvert.SerializeObject(deptName)),this)"
                                class="pin-btn p-1.5 rounded-lg hover:bg-gray-100 transition text-gray-300 hover:text-amber-400"
                                title="Pin department" data-dept="@deptName">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                        </button>
                    </div>
                    <p class="text-2xl font-bold text-[#A36A66]">₱@expTotal.ToString("N2")</p>
                    <p class="text-xs text-gray-400 mt-1">Expense requests total</p>
                    @{
                        var agingCount = deptExpenses.Count(e => e.Status == "Pending" && (DateTime.Now - e.RequestedAt).TotalDays >= 3);
                    }
                    @if (agingCount > 0)
                    {
                        <div class="mt-2 flex items-center gap-1.5 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 rounded-lg px-2 py-1 w-fit">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            @agingCount aging request@(agingCount > 1 ? "s" : "")
                        </div>
                    }
                </div>
                <div class="px-5 py-4 space-y-2">
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-500 rounded-full"></span><span class="text-gray-600">Pending (@expPending)</span></span>
                        <span class="font-medium text-gray-800">₱@expPendingAmt.ToString("N2")</span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2"><span class="w-2 h-2 bg-green-500 rounded-full"></span><span class="text-gray-600">Approved (@expApproved)</span></span>
                        <span class="font-medium text-gray-800">₱@expApprovedAmt.ToString("N2")</span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2"><span class="w-2 h-2 bg-red-500 rounded-full"></span><span class="text-gray-600">Declined (@expDeclined)</span></span>
                        <span class="font-medium text-gray-800">₱@expDeclinedAmt.ToString("N2")</span>
                    </div>
                </div>
                <div class="px-5 py-3 mt-auto border-t border-gray-100 bg-gray-50 rounded-b-2xl">
                    <span class="text-sm text-[#A36A66] font-medium flex items-center gap-1">
                        Click to view all requests
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                    </span>
                </div>
            </div>
        }

        <!-- ═══ UTILITIES CARD ═══ -->
        <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-cyan-100 flex flex-col cursor-pointer"
             onclick="openUtilitiesPanel()">
            <div class="p-5 border-b border-cyan-50">
                <div class="flex items-start justify-between mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-cyan-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Utilities</h3>
                            <p class="text-xs text-gray-400">@utilityExpenses.Count request(s) · @utilityByType.Count type(s)</p>
                        </div>
                    </div>
                    <button onclick="event.stopPropagation();openUtilitiesComparison()"
                            class="flex items-center gap-1 text-[11px] font-semibold text-cyan-700 bg-cyan-50 border border-cyan-200 px-2.5 py-1 rounded-lg hover:bg-cyan-100 transition-colors"
                            title="Compare months">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                        Compare
                    </button>
                </div>
                <p class="text-2xl font-bold text-cyan-600">₱@utilityTotal.ToString("N2")</p>
                <p class="text-xs text-gray-400 mt-1">Total utility expenses</p>
            </div>

            <!-- Per-utility-type mini breakdown -->
            <div class="px-5 py-4 space-y-1.5">
                @foreach (var ut in utilityByType.Take(4))
                {
                    var icon = ut.type == "Electricity" ? "⚡" : ut.type == "Water" ? "💧" : ut.type == "Internet" ? "📶" : ut.type == "Gas" ? "🔥" : ut.type == "Phone" ? "📞" : ut.type == "Waste" ? "🗑️" : ut.type == "HVAC" ? "❄️" : "🔌";
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2 text-gray-600">
                            <span class="text-base leading-none">@icon</span>
                            <span>@ut.type (@ut.count)</span>
                        </span>
                        <span class="font-semibold text-cyan-700">₱@ut.total.ToString("N2")</span>
                    </div>
                }
                @if (utilityByType.Count > 4)
                {
                    <p class="text-[11px] text-gray-400 mt-1">+@(utilityByType.Count - 4) more type(s)</p>
                }
                @if (!utilityByType.Any())
                {
                    <p class="text-xs text-gray-400 text-center py-2">No utility expenses found</p>
                }
            </div>

            <!-- Status row -->
            <div class="px-5 pb-3 space-y-1.5 border-t border-cyan-50 pt-3">
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-500 rounded-full"></span><span class="text-gray-600">Pending (@utilityPending)</span></span>
                    <span class="font-medium text-gray-800">₱@utilityPendingAmt.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-2"><span class="w-2 h-2 bg-green-500 rounded-full"></span><span class="text-gray-600">Approved (@utilityApproved)</span></span>
                    <span class="font-medium text-gray-800">₱@utilityApprovedAmt.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-2"><span class="w-2 h-2 bg-red-500 rounded-full"></span><span class="text-gray-600">Declined (@utilityDeclined)</span></span>
                    <span class="font-medium text-gray-800">₱@utilityDeclinedAmt.ToString("N2")</span>
                </div>
            </div>

            <div class="px-5 py-3 mt-auto border-t border-cyan-100 bg-cyan-50/50 rounded-b-2xl">
                <span class="text-sm text-cyan-600 font-medium flex items-center gap-1">
                    Click to view all utility expenses
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </span>
            </div>
        </div>

        <!-- ═══ INVENTORY / INGREDIENT CARD ═══ -->
        @{
            var ingPending = stockRequests.Count(r => r.RequestStatus == "Pending");
            var ingPendingAmt = stockRequests.Where(r => r.RequestStatus == "Pending").Sum(r => r.TotalCost);
            var ingApproved = stockRequests.Count(r => r.RequestStatus.StartsWith("Approved"));
            var ingApprovedAmt = stockRequests.Where(r => r.RequestStatus.StartsWith("Approved")).Sum(r => r.TotalCost);
            var ingDeclined = stockRequests.Count(r => r.RequestStatus == "Declined");
            var ingDeclinedAmt = stockRequests.Where(r => r.RequestStatus == "Declined").Sum(r => r.TotalCost);
        }
        <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100 flex flex-col cursor-pointer"
             onclick='openDeptPanel("ingredient", "Inventory / Ingredients", [], @Html.Raw(JsonConvert.SerializeObject(stockRequestsJson)))'>
            <div class="p-5 border-b border-gray-100">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 bg-orange-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900">Inventory / Ingredients</h3>
                        <p class="text-xs text-gray-400">@stockRequests.Count request(s)</p>
                    </div>
                </div>
                <p class="text-2xl font-bold text-orange-600">₱@ingredientTotal.ToString("N2")</p>
            </div>
            <div class="px-5 py-4 space-y-2">
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-2"><span class="w-2 h-2 bg-yellow-500 rounded-full"></span><span class="text-gray-600">Pending (@ingPending)</span></span>
                    <span class="font-medium text-gray-800">₱@ingPendingAmt.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-2"><span class="w-2 h-2 bg-green-500 rounded-full"></span><span class="text-gray-600">Approved (@ingApproved)</span></span>
                    <span class="font-medium text-gray-800">₱@ingApprovedAmt.ToString("N2")</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-2"><span class="w-2 h-2 bg-red-500 rounded-full"></span><span class="text-gray-600">Declined (@ingDeclined)</span></span>
                    <span class="font-medium text-gray-800">₱@ingDeclinedAmt.ToString("N2")</span>
                </div>
            </div>
            <div class="px-5 py-3 mt-auto border-t border-gray-100 bg-gray-50 rounded-b-2xl">
                <span class="text-sm text-orange-600 font-medium flex items-center gap-1">Click to view all requests <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
            </div>
        </div>

        <!-- ═══ PAYROLL CARD ═══ -->
        @if (payrollCutoffs.Any())
        {
            var prPending = payrollCutoffs.Count(p => p.status == "Calculated");
            var prApproved = payrollCutoffs.Count(p => p.status == "Completed");
            var prDeclined = payrollCutoffs.Count(p => p.status == "Declined");

            <div class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100 flex flex-col cursor-pointer"
                 onclick='openDeptPanel("payroll", "Payroll", [], @Html.Raw(JsonConvert.SerializeObject(payrollCutoffs)))'>
                <div class="p-5 border-b border-gray-100">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-semibold text-gray-900">Payroll</h3>
                            <p class="text-xs text-gray-400">@payrollCutoffs.Count cutoff(s)</p>
                        </div>
                    </div>
                    <p class="text-2xl font-bold text-indigo-600">₱@payrollTotal.ToString("N2")</p>
                    <p class="text-xs text-gray-400 mt-1">Total gross salary</p>
                </div>
                <div class="px-5 py-4 space-y-2">
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2"><span class="w-2 h-2 bg-blue-500 rounded-full"></span><span class="text-gray-600">Calculated (@prPending)</span></span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2"><span class="w-2 h-2 bg-green-500 rounded-full"></span><span class="text-gray-600">Approved (@prApproved)</span></span>
                    </div>
                    <div class="flex items-center justify-between text-sm">
                        <span class="flex items-center gap-2"><span class="w-2 h-2 bg-red-500 rounded-full"></span><span class="text-gray-600">Declined (@prDeclined)</span></span>
                    </div>
                </div>
                <div class="px-5 py-3 mt-auto border-t border-gray-100 bg-gray-50 rounded-b-2xl">
                    <span class="text-sm text-indigo-600 font-medium flex items-center gap-1">Click to view all cutoffs & breakdowns <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></span>
                </div>
            </div>
        }
    </div>
</div>

