@model IEnumerable<ProductVariant>
@{
    ViewData["Title"] = "Products Overview";
}

<style>
    .row-selected {
        background-color: #F3D7D5 !important; /* light rose highlight */
    }

    /* Date range input styles */
    .date-range-inputs {
        display: none;
        gap: 0.5rem;
        align-items: center;
    }

        .date-range-inputs.active {
            display: flex;
        }

    .date-input {
        padding: 0.5rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        color: #A36A66;
        font-size: 0.875rem;
    }

        .date-input:focus {
            outline: none;
            border-color: #A36A66;
            ring: 2px;
            ring-color: rgba(163, 106, 102, 0.2);
        }

    .apply-date-btn {
        padding: 0.5rem 1rem;
        background-color: #A36A66;
        color: white;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        font-size: 0.875rem;
        transition: background-color 0.2s;
    }

        .apply-date-btn:hover {
            background-color: #8a5a57;
        }
</style>

<div id="loadingOverlay" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-[9999]">
    <div class="text-white text-lg font-semibold">
        <span class="animate-pulse">...</span>
        Generating Report...
    </div>
</div>
<div class="p-6 bg-gray-50 min-h-screen space-y-8">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold" style="color:#A36A66;">
            Sales Management
        </h1>

        <div class="flex items-center gap-3">
            <!-- Date Range Display -->
            <h3 id="currentDateRange" class="text-sm font-semibold" style="color:#A36A66;">
                <!-- Will be populated by JavaScript -->
            </h3>

            <select id="dateRangeSelect" class="border border-gray-300 rounded-lg text-sm px-3 py-1.5 focus:ring-2 focus:ring-pink-400">
                <option value="week">This Week</option>
                <option value="month">This Month</option>
                <option value="year">This Year</option>
                <option value="alltime">All Time</option>
                <option value="custom">Custom Range</option>
            </select>

            <!-- Custom Date Range Inputs (hidden by default) -->
            <div id="customDateRange" class="date-range-inputs">
                <input type="date" id="startDate" class="date-input" />
                <span style="color:#A36A66;">to</span>
                <input type="date" id="endDate" class="date-input" />
                <button id="applyDateRange" class="apply-date-btn">Apply</button>
            </div>

            <button id="generateReportBtn" class="bg-green-500 hover:bg-green-600 text-white text-sm font-medium px-4 py-1.5 rounded-lg shadow-md transition">
                Generate Report
            </button>
        </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6 lg:items-stretch">

        <div class="lg:col-span-3 space-y-6">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="bg-white rounded-2xl shadow-lg p-5 flex items-center space-x-4 border border-gray-100 h-32">
                    <div class="p-3 rounded-full bg-rose-100 mt-0.5" style="color: #A36A66;">
                        <i class="fa-solid fa-money-bill-trend-up fa-lg"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold" style="color: #A36A66;">Total Sales</h2>
                        <p class="text-2xl font-bold text-gray-900 mt-0.5">@ViewBag.TotalSales</p>
                    </div>
                </div>

                <div class="bg-white rounded-2xl shadow-lg p-5 flex items-center space-x-4 border border-gray-100 h-32">
                    <div class="p-3 rounded-full bg-rose-100 mt-0.5" style="color: #A36A66;">
                        <i class="fa-solid fa-bag-shopping fa-lg"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold" style="color: #A36A66;">Total Orders</h2>
                        <p class="text-2xl font-bold text-gray-900 mt-0.5">@ViewBag.TotalOrders</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-lg p-6 h-[30rem] flex flex-col">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-semibold text-gray-800">Product Sales Trend</h2>
                    <span id="chartProductName" class="text-[#A36A66] ml-2"></span>
                </div>

                <!-- Chart wrapper must grow and stretch -->
                <div class="flex-grow relative">
                    <canvas id="productSalesChart" class="absolute inset-0 w-full h-full"></canvas>
                </div>
            </div>
        </div>
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-lg p-5 border border-gray-100 flex flex-col justify-between">
            <div class="aspect-square w-full rounded-xl overflow-hidden bg-gray-100 flex items-center justify-center">
                <img src="~/images/Hand_Sanitizer.jpg"
                     id="productCardImg"
                     class="object-cover w-full h-full"
                     alt="Product Image">
            </div>

            <div class="mt-4">
                <p class="text-center font-bold text-lg text-gray-800" id="productCardName">Hydrating Face Cream</p>
                <p class="text-center text-gray-500 text-sm mt-1">Total Order</p>
                <p class="text-center font-bold text-2xl text-[#A36A66] mt-1" id="productCardTotalOrder">47</p>
            </div>
        </div>


    </div>



    <div class="bg-white rounded-2xl shadow-sm p-6">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-semibold text-gray-800">Products Overview</h2>
            <div class="relative">
                <input id="productSearch" type="text" placeholder="Search product..."
                       class="border border-gray-300 px-4 py-2 pl-10 rounded-xl w-60 focus:ring-2 focus:ring-[#A36A66] text-sm" />
                <i class="fa-solid fa-search absolute left-3 top-2.5 text-gray-400 text-sm"></i>
            </div>
        </div>



        <div class="overflow-x-auto">

            <table class="min-w-full text-sm text-gray-700 border-t border-gray-100">
                <thead class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wider">
                    <tr>
                        <th class="px-4 py-3 text-left">Product ID</th>
                        <th class="px-4 py-3 text-left">Product Name</th>
                        <th class="px-4 py-3 text-left">Category</th>
                        <th class="px-4 py-3 text-left">Selling Price</th>
                        <th class="px-4 py-3 text-left">Stock</th>
                        <th class="px-4 py-3 text-left">Status</th>
                        <th class="px-4 py-3 text-center">Options</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var p in Model)
                    {
                        var statusColor = p.StockQuantity >= 10 ? "text-sky-500" : (p.StockQuantity < 10 && p.StockQuantity > 0 ? "text-orange-400" : "text-red-500");
                        var categoryColor = p.Category switch
                        {
                            "Skincare" => "bg-pink-100 text-pink-700", // Retained
                            "Haircare" => "bg-teal-100 text-teal-700", // Changed from sky-blue to teal
                            "Makeup" => "bg-purple-100 text-purple-700",
                            _ => "bg-gray-100 text-gray-700"
                        };

                        <tr class="product-row hover:bg-[#F0E4E3] transition cursor-pointer"
                            onclick="selectProduct('@p.VariantName', '@p.Id', '@p.OrdersCount', '@p.VariantImg', this)">

                            <td class="px-4 py-3 font-medium text-gray-600">@p.Id</td>
                            <td class="px-4 py-3 text-gray-800">@p.VariantName</td>
                            <td class="px-4 py-3">
                                <span class="@categoryColor text-xs font-semibold px-3 py-1 rounded-lg">@p.Category</span>
                            </td>
                            <td class="px-4 py-3">₱@p.Price</td>
                            <td class="px-4 py-3">@p.StockQuantity</td>
                            <td class="px-4 py-3">
                                @if (p.StockQuantity >= 10)
                                {
                                    <span class="@statusColor font-semibold uppercase text-xs">Available</span>
                                }
                                else if (p.StockQuantity < 10 && p.StockQuantity > 0)
                                {
                                    <span class="@statusColor font-semibold uppercase text-xs">Low</span>
                                }
                                else
                                {
                                    <span class="@statusColor font-semibold uppercase text-xs">Sold</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <button onclick="openModal('@p.VariantName', '@p.Category', '@p.Price', '@p.VariantImg', '@p.Description', '@p.OrdersCount')"
                                        class="text-blue-500 hover:underline text-sm font-medium">
                                    Details
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="flex justify-center mt-6 space-x-2">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="@Url.Action("Products", new { page = ViewBag.CurrentPage - 1 })"
                       class="px-4 py-2 bg-gray-200 rounded-lg text-gray-700 hover:bg-gray-300 text-sm">
                        Previous
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    if (i == ViewBag.CurrentPage)
                    {
                        <span class="px-4 py-2 bg-[#A36A66] text-white rounded-lg text-sm">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Products", new { page = i })"
                           class="px-4 py-2 bg-gray-200 rounded-lg text-gray-700 hover:bg-gray-300 text-sm">
                            @i
                        </a>
                    }
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="@Url.Action("Products", new { page = ViewBag.CurrentPage + 1 })"
                       class="px-4 py-2 bg-gray-200 rounded-lg text-gray-700 hover:bg-gray-300 text-sm">
                        Next
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- Sales Revenue Chart -->
        <div class="bg-white shadow-lg rounded-2xl p-6 flex flex-col h-[460px]" id="revenueCard">

            <div class="flex justify-between items-center mb-3">
                <p class="font-semibold text-sm">Total Revenue</p>
            </div>

            <div class="flex-1 relative">
                <canvas id="salesRevenueChart"></canvas>
            </div>
        </div>

        <!-- Top Products Card -->
        <div id="topProductsCard" class="bg-white shadow-lg rounded-2xl p-6 flex flex-col h-[460px]">
            <h2 class="font-semibold text-sm mb-4">Top Products</h2>

            <div class="flex flex-1 items-center justify-center gap-6">
                <!-- Donut Chart (Left) -->
                <div class="w-1/2 max-w-[280px] relative aspect-square">
                    <canvas id="topProductsChart"></canvas>
                </div>

                <div id="topProductsList" class="w-1/2 flex flex-col ...">
                    <!-- dynamically generated -->
                </div>
            </div>
        </div>
    </div>
</div>

<div id="productModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="bg-white rounded-3xl shadow-xl w-[700px] p-8 relative flex gap-6">
        <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
        <div class="flex-1">
            <h2 id="modalName" class="text-2xl font-bold text-gray-800 mb-2">Product Name</h2>
            <span id="modalCategory" class="bg-[#A36A66] text-white text-sm font-semibold px-3 py-1 rounded-lg inline-block mb-3">Category</span>
            <p class="text-gray-600 text-sm leading-relaxed mb-4" id="modalDescription">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Etiam sollicitudin ipsum arcu.
            </p>
            <div class="mt-4">
                <p class="text-gray-700 font-medium">Selling Price</p>
                <p class="mt-1 font-semibold text-2xl text-[#A36A66]">
                    ₱<span id="modalSelling">0</span>
                </p>
                <p class="text-sm text-gray-500 font-medium mt-1">Purchase Price: ₱<span id="modalPurchase">0</span></p>
            </div>
        </div>
        <div class="w-60">
            <img src="~/images/Hand_Sanitizer.jpg" alt="Product Image" class="rounded-xl shadow-sm w-full object-cover" id="modalImage">
        </div>
    </div>
</div>
<div id="toastContainer" class="fixed top-5 right-5 space-y-2 z-[9999]"></div>

<div class="bg-white mt-10 rounded-2xl shadow-lg p-6 border border-gray-100">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">
        Sales Summary (All Products)
    </h2>

    <div class="overflow-x-auto">
        <table class="min-w-full text-sm text-gray-700 border-t border-gray-100">
            <thead class="bg-gray-50 text-gray-600 uppercase text-xs tracking-wider">
                <tr>
                    <th class="px-4 py-3 text-left">Product Variant</th>
                    <th class="px-4 py-3 text-left">Qty</th>
                    <th class="px-4 py-3 text-left">Price</th>
                    <th class="px-4 py-3 text-left">Total</th>
                    <th class="px-4 py-3 text-left">Transaction Date</th>
                </tr>
            </thead>
            <tbody id="salesTableBody" class="divide-y divide-gray-100">
                <!-- Filled by JS -->
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    <div class="flex justify-between items-center mt-6">
        <div class="text-sm text-gray-600">
            Showing <span id="salesShowingFrom">0</span> to <span id="salesShowingTo">0</span> of <span id="salesTotalItems">0</span> entries
        </div>
        <div id="salesPaginationControls" class="flex space-x-2">
            <!-- Pagination buttons will be generated by JS -->
        </div>
    </div>
</div>



<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
