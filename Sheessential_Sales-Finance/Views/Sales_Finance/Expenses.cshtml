@using Newtonsoft.Json

    <!-- PAYROLL MANAGEMENT SECTION WITH SIDE PANEL -->
    <div id="payrollSection" class="mt-3 p-4 grid my-10 grid-cols-1 lg:grid-cols-5 gap-6 min-h-[500px]">

        <!-- LEFT: Payroll Runs Table (60% width) -->
        <div class="lg:col-span-3 bg-white rounded-2xl shadow-md overflow-hidden">
            <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold text-[#A36A66]">Payroll Management</h2>
                    <p class="text-[#A36A66] text-sm mt-1">Employee payroll overview</p>
                </div>

                <div class="relative inline-block">
                    <button id="filterButtonPayroll"
                            class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Filter
                    </button>

                    <div id="filterDropdownPayroll"
                         class="hidden absolute top-full right-0 mt-2 w-80 bg-white border border-gray-200 rounded-xl shadow-2xl z-[9999] animate-fadeIn flex flex-col max-h-[80vh]">

                        <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl">
                            <h3 class="font-bold text-gray-800">Filter Payroll</h3>
                            <button type="button" onclick="resetPayrollFilters()"
                                    class="text-xs text-red-500 hover:text-red-700 font-medium">
                                Reset All
                            </button>
                        </div>

                        <div class="p-4 overflow-y-auto">
                            <form id="filterFormPayroll" onsubmit="event.preventDefault(); applyPayrollFilters();">
                                <div class="mb-5">
                                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Category</label>
                                    <div class="flex flex-wrap gap-4">
                                        <label class="flex items-center space-x-2 cursor-pointer">
                                            <input type="checkbox" name="category" value="Approved" class="rounded text-green-600">
                                            <span class="text-sm text-gray-700">Approved</span>
                                        </label>

                                        <label class="flex items-center space-x-2 cursor-pointer">
                                            <input type="checkbox" name="category" value="Declined" class="rounded text-red-600">
                                            <span class="text-sm text-gray-700">Declined</span>
                                        </label>

                                        <label class="flex items-center space-x-2 cursor-pointer">
                                            <input type="checkbox" name="category" value="Calculated" class="rounded text-blue-600">
                                            <span class="text-sm text-gray-700">Calculated</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="mb-5">
                                    <label class="block text-xs font-bold text-gray-500 uppercase mb-2">Sort By</label>
                                    <select id="sortBy" class="w-full border rounded-md px-3 py-2 text-sm">
                                        <option value="">None</option>
                                        <option value="date-desc">Date – Newest First</option>
                                        <option value="date-asc">Date – Oldest First</option>
                                        <option value="gross-desc">Gross – High to Low</option>
                                        <option value="gross-asc">Gross – Low to High</option>
                                        <option value="count-desc">Employees – High to Low</option>
                                        <option value="count-asc">Employees – Low to High</option>
                                    </select>
                                </div>

                                <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-lg hover:bg-blue-700">
                                    Apply Filters
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="overflow-x-auto h-[calc(100vh-250px)]">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50 sticky top-0 z-10">
                        <tr>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Pay Run #</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Pay Period</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Pay Date</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Pay Type</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Employees</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Gross Total</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Net Total</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody id="payrollTableBody" class="bg-white divide-y divide-gray-200">
                        @foreach (var run in Model.PayrollRuns)
                        {
                            <tr class="hover:bg-gray-50 cursor-pointer transition-colors payroll-row"
                                data-id="@run.Id"
                                data-payslips="@JsonConvert.SerializeObject(run.Items)"
                                onclick="selectPayrollRow(this)"
                                id="payroll-row-@run.Id">
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-blue-600">@run.PayRunNumber</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@run.PayPeriodStart.ToString("MMM dd") – @run.PayPeriodEnd.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@run.PayDate.ToString("MMM dd, yyyy")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">@run.PayPeriodType</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 text-center">@run.TotalEmployees</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">₱@run.TotalGrossSalary.ToString("N2")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm font-semibold text-gray-900">₱@run.TotalNetSalary.ToString("N2")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="px-3 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full
                                        @(run.Status == "Calculated" ? "bg-blue-100 text-blue-800" :
                                                                                run.Status == "Approved" ? "bg-green-100 text-green-800" :
                                                                                run.Status == "Declined" ? "bg-red-100 text-red-800" :
                                                                                "bg-gray-100 text-gray-800")">
                                    @run.Status
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap space-x-2">
                                @if (run.Status == "Approved" || run.Status == "Declined")
                                    {
                                        <button disabled
                                                class="px-3 py-1.5 bg-gray-100 text-gray-400 text-xs font-medium rounded cursor-not-allowed">
                                            Approve
                                        </button>
                                        <button disabled
                                                class="px-3 py-1.5 bg-gray-100 text-gray-400 text-xs font-medium rounded cursor-not-allowed">
                                            Decline
                                        </button>
                                    }
                                    else
                                    {
                                        <button onclick="releasePayroll('@run.Id', 'Approved')"
                                                class="px-3 py-1.5 bg-green-500 hover:bg-green-600 text-white text-xs font-medium rounded transition">
                                            Approve
                                        </button>
                                        <button onclick="releasePayroll('@run.Id', 'Declined')"
                                                class="px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-medium rounded transition">
                                            Decline
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

                @if (ViewBag.PayrollTotalPages > 1)
