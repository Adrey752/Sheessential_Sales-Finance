@using MongoDB.Driver.Linq
@model Sheessential_Sales_Finance.Models.ExpensesWithBalanceViewModel

@{
    ViewData["Title"] = "Expense Management";
}

<link href="~/css/output.css" rel="stylesheet" />
@* MAIN CONTAINER *@
<div class="p-6 bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen">
    <!-- HEADER -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-4xl font-bold text-[#A36A66] mb-1">Expense Management</h1>
            <p class="text-[#A36A66]">Manage and track company expense requests</p>
        </div>

    </div>
    <!-- HEADER END-->
    <!-- SUMMARY CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-8">
        <!-- Available Balance Card -->
        <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100">
            <div class="flex items-center gap-4 mb-2">
                <div class="w-10 h-10  rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                    </svg>
                </div>
                
                <p class="text-[#A36A66] text-sm font-medium">Available Balance</p>
            </div>

            @if (Model.Balance != null)
            {
                <h3 class="text-3xl font-bold text-[#A36A66] mt-1">
                    @Model.Balance.CurrentBalance.ToString("C")
                </h3>
                <p class="text-[#A36A66] text-sm mt-1">All time</p>
            }
            else
            {
                <h3 class="text-3xl font-bold text-[#A36A66] mt-1">
                    ₱0.00
                </h3>
            }
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100">
            <div class="flex items-center gap-2 mb-2">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <p class="text-[#A36A66] text-sm font-medium">Total Expenses</p>
            </div>
            <h2 class="text-2xl font-bold text-[#A36A66]">₱@ViewBag.TotalExpenses.ToString("N2")</h2>
            <p class="text-[#A36A66] text-sm mt-1">All time</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100">
            <div class="flex items-center gap-2 mb-2">
                <div class="w-10 h-10  rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <p class="text-[#A36A66] text-sm font-medium">Pending</p>
            </div>
            <h2 class="text-2xl font-bold text-[#A36A66]">₱@ViewBag.PendingTotal.ToString("N2")</h2>
            <p class="text-[#A36A66] text-sm mt-1">Awaiting approval</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100">
            <div class="flex items-center gap-2 mb-2">
                <div class="w-10 h-10  rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <p class="text-[#A36A66] text-sm font-medium">Approved</p>
            </div>
            <h2 class="text-2xl font-bold text-[#A36A66]">₱@ViewBag.ApprovedTotal.ToString("N2")</h2>
            <p class="text-[#A36A66] text-sm mt-1">This month</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-md hover:shadow-lg transition-shadow border border-gray-100">
            <div class="flex items-center gap-2 mb-2">
                <div class="w-10 h-10  rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-[#A36A66]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <p class="text-[#A36A66] text-sm font-medium">Declined</p>
            </div>
            <h2 class="text-2xl font-bold text-[#A36A66]">₱@ViewBag.DeclinedTotal.ToString("N2")</h2>
            <p class="text-gray-500 text-sm mt-1">This month</p>
        </div>
    </div>

    <!-- Balance Alert -->
    <div id="balanceAlert" class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6 rounded-lg shadow-sm hidden">
        <div class="flex items-center">
            <svg class="w-5 h-5 text-yellow-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
            <div>
                <p class="text-yellow-800 font-medium">Low Balance Warning</p>
                <p class="text-yellow-700 text-sm">Available balance is below ₱20,000. Consider adding funds before approving large expenses.</p>
            </div>
        </div>
    </div>
    <!-- BALANCE ALERT ondragend=" -->
    <!-- EXPENSE HEADER -->
    <div class="bg-white rounded-2xl shadow-md overflow-hidden w-[1200px] mx-auto mb-4">
        <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">Expense Requests</h2>
                    <p class="text-gray-600 text-sm mt-1">Review and manage company expenses</p>
                </div>

                <div class="flex gap-3">
                    <button id="openModalBtn"
                            class="bg-[#A36A66] text-white px-6 py-3 rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        New Expense Request
                    </button>

                    <div class="relative inline-block text-left">
                        <button id="filterButton"
                                class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors flex items-center gap-2 bg-white text-gray-700 font-medium shadow-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                            </svg>
                            Filter & Sort
                        </button>
                    </div>
                </div>

                <div id="filterDropdown"
                     class="hidden fixed bottom-[40px] right-[40px] w-80 bg-white border border-gray-200 rounded-xl shadow-2xl z-[9999] animate-fadeIn flex flex-col max-h-[80vh]">

                    <div class="p-4 border-b border-gray-100 flex justify-between items-center bg-gray-50 rounded-t-xl">
                        <h3 class="font-bold text-gray-800">Filter Options</h3>
                        <button type="button" onclick="document.getElementById('filterForm').reset()" class="text-xs text-red-500 hover:text-red-700 font-medium">
                            Reset All
                        </button>
                    </div>

                    <div class="p-4 overflow-y-auto">
                        <form id="filterForm" method="get" action="@Url.Action("Expenses")">
                            <div class="mb-5">
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Sort By</label>
                                <select name="sortOrder" class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="">Default</option>
                                    <option value="date_desc">Date Requested (Newest First)</option>
                                    <option value="date_asc">Date Requested (Oldest First)</option>
                                    <option value="amount_desc">Amount (Highest First)</option>
                                    <option value="amount_asc">Amount (Lowest First)</option>
                                    <option value="approved_date_desc">Approved Date (Newest First)</option>
                                </select>
                            </div>

                            <div class="mb-5">
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Department</label>
                                <div class="space-y-2">
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="departments" value="Marketing" class="rounded text-blue-600 focus:ring-blue-500" />
                                        <span class="text-sm text-gray-700">Marketing</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="departments" value="Website" class="rounded text-blue-600 focus:ring-blue-500" />
                                        <span class="text-sm text-gray-700">Website</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="departments" value="HR" class="rounded text-blue-600 focus:ring-blue-500" />
                                        <span class="text-sm text-gray-700">HR</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="departments" value="Accounting" class="rounded text-blue-600 focus:ring-blue-500" />
                                        <span class="text-sm text-gray-700">Accounting</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="departments" value="Inventory" class="rounded text-blue-600 focus:ring-blue-500" />
                                        <span class="text-sm text-gray-700">Inventory</span>
                                    </label>
                                </div>
                            </div>

                            <hr class="border-gray-100 my-4">

                            <div class="mb-5">
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Status</label>
                                <div class="flex gap-4">
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="status" value="Approved" class="rounded text-green-600 focus:ring-green-500" />
                                        <span class="text-sm text-gray-700">Approved</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="status" value="Pending" class="rounded text-yellow-500 focus:ring-yellow-500" />
                                        <span class="text-sm text-gray-700">Pending</span>
                                    </label>
                                    <label class="flex items-center space-x-2 cursor-pointer">
                                        <input type="checkbox" name="status" value="Declined" class="rounded text-yellow-500 focus:ring-yellow-500" />
                                        <span class="text-sm text-gray-700">Declined</span>
                                    </label>
                                </div>
                            </div>

                            <hr class="border-gray-100 my-4">

                            <div class="mb-5">
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Amount</label>
                                <div class="flex items-center gap-2">
                                    <input type="number" name="minAmount" placeholder="Min" class="w-1/2 border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
                                    <span class="text-gray-400">-</span>
                                    <input type="number" name="maxAmount" placeholder="Max" class="w-1/2 border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 outline-none" />
                                </div>
                            </div>

                            <hr class="border-gray-100 my-4">

                            <div class="mb-2">
                                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wide mb-2">Date Requested</label>
                                <div class="space-y-2">
                                    <div class="flex flex-col">
                                        <span class="text-[10px] text-gray-400">From</span>
                                        <input type="date" name="startDate" class="w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm text-gray-600 focus:ring-2 focus:ring-blue-500 outline-none" />
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[10px] text-gray-400">To</span>
                                        <input type="date" name="endDate" class="w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm text-gray-600 focus:ring-2 focus:ring-blue-500 outline-none" />
                                    </div>
                                </div>
                            </div>

                            <div class="mt-6 pt-2">
                                <button type="submit" class="w-full bg-blue-600 text-white font-medium py-2 rounded-lg hover:bg-blue-700 transition shadow-md">
                                    Apply Filters
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <!-- EXPENSE HEADER END -->
    <!-- EXPENSE TABLE -->
    <div class="overflow-x-auto mb-5 w-[1200px] mx-auto h-[450px]">
        <table class="min-w-full divide-y divide-gray-200 table-auto">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[140px] text-center">Expense ID</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[180px] text-center">Requester</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[160px] text-center">Department</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[140px] text-center">Type</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[150px] text-center">Amount</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[350px] text-center">Date Requested</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[350px] text-center">Date Approved</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[350px] text-center">Status</th>
                    <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider min-w[140px] text-center">Actions</th>
                </tr>
            </thead>

            <tbody class="bg-white divide-y divide-gray-200">
                @if (Model != null && Model.Expenses != null && Model.Expenses.Any())
                {
                    @foreach (var expense in Model.Expenses)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">

                            <td class="px-6 py-4 break-words min-w-[138px] text-center">@expense.ExpenseId</td>

                            <td class="px-6 py-4 break-words min-w-[148px] text-center">
                                <div class="flex items-center">
                                    <span class="text-sm text-gray-900 break-words">@expense.RequestedBy</span>
                                </div>
                            </td>

                            <td class="px-6 py-4 min-w-[125px] text-center">
                                <span class="px-3 py-1 inline-flex text-xs leading-5 font-medium rounded-full bg-gray-100 text-gray-800 break-words">
                                    @expense.Department
                                </span>  
                            </td>

                            <td class="px-6 py-4 text-sm text-gray-700 break-words w-[145px] text-center">@expense.ExpenseType</td>

                            <td class="px-6 py-4 min-w-[138px] text-center">
                                <span class="text-sm font-semibold text-gray-900 break-words">₱@expense.Amount.ToString("N2")</span>
                            </td>                         

                            <td class="px-6 py-4 max-w-[300px] break-words text-sm text-gray-700 min-w-[148px] text-center">
                                @(expense.RequestedAt == null ? "not yet" : expense.RequestedAt.ToString("MMM dd, yyyy"))
                            </td>

                            <td class="px-6 py-4 max-w-[300px] break-words text-sm text-gray-700 min-w-[148px] text-center">
                                @(expense.DateApproved == null ? "not yet" : expense.DateApproved.Value.ToString("MMM dd, yyyy"))
                            </td>

                            <td class="px-6 py-4 break-words min-w-[145px]">
                                <!-- Status badge preserved -->
                                @if (expense.Status == "Pending")
                                {
                                    <span class="px-3 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                        <span class="w-2 h-2 bg-yellow-500 rounded-full mr-2 animate-pulse"></span>
                                        Pending
                                    </span>
                                }
                                else if (expense.Status == "Approved")
                                {
                                    <span class="px-3 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        ✓ Approved
                                    </span>
                                }
                                else if (expense.Status == "Declined")
                                {
                                    <span class="px-3 py-1 inline-flex items-center text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                        ✕ Declined
                                    </span>
                                }
                            </td>

                            <td class="px-6 py-4 w-[140px]">
                                @if (expense.Status == "Pending")
                                {
                                    <button type="button"
                                            class="view-details-btn px-4 py-2 bg-gradient-to-r from-blue-600 to-blue-700 text-white text-sm font-medium rounded-lg hover:from-blue-700 hover:to-blue-800 transition-all shadow-sm hover:shadow-md transform hover:-translate-y-0.5"
                                            data-expense-id="@expense.Id"
                                            data-requester="@expense.RequestedBy"
                                            data-department="@expense.Department"
                                            data-type="@expense.ExpenseType"
                                            data-amount="@expense.Amount"
                                            data-description="@expense.Description"
                                            data-notes="@expense.Notes"
                                            data-status="@expense.Status"
                                            data-id="@expense.Id">
                                        Review
                                    </button>
                                }
                                else if (expense.Status == "Approved")
                                {
                                    <button type="button"
                                            class="review-btn bg-gradient-to-r from-green-600 to-green-700 text-white"
                                            data-mode="approved"
                                            data-responded-date="@(expense.DateApproved.HasValue ? expense.DateApproved.Value.ToString("MMM dd, yyyy") : "")"
                                            data-expense-id="@expense.Id"
                                            data-requester="@expense.RequestedBy"
                                            data-department="@expense.Department"
                                            data-type="@expense.ExpenseType"
                                            data-amount="@expense.Amount"
                                            data-description="@expense.Description"
                                            data-notes="@expense.Notes"
                                            data-status="@expense.Status">
                                        View
                                    </button>
                                }
                                else if (expense.Status == "Declined")
                                {
                                    <button type="button"
                                            class="review-btn bg-gradient-to-r from-red-600 to-red-700 text-white"
                                            data-mode="declined"
                                            data-responded-date="@(expense.DateApproved.HasValue ? expense.DateApproved.Value.ToString("MMM dd, yyyy") : "")"
                                            data-expense-id="@expense.Id"
                                            data-requester="@expense.RequestedBy"
                                            data-department="@expense.Department"
                                            data-type="@expense.ExpenseType"
                                            data-amount="@expense.Amount"
                                            data-description="@expense.Description"
                                            data-notes="@expense.Notes"
                                            data-status="@expense.Status">
                                        View
                                    </button>
                                }

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center">
                            <div class="flex flex-col items-center">
                                <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                <p class="text-gray-500 text-lg font-medium">No expense requests found</p>
                                <p class="text-gray-400 text-sm mt-1">Create a new expense request to get started</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
   


    <!-- EXPENSE TABLE END -->
    <!-- INGREDIENT REQUEST HEADER  -->
    <div class="bg-white rounded-2xl shadow-md overflow-hidden w-[1200px] mx-auto h-[450px]">
        <div class="p-6 border-b border-gray-200 bg-gradient-to-r from-gray-50 to-white">
            <div class="flex justify-between items-center">
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">Ingredient Requests</h2>
                    <p class="text-gray-600 text-sm mt-1">Review and manage ingredient stock requests</p>
                </div>

                <div class="relative inline-block text-left">
                    <button id="filterButtonIngredient"
                            type="button"
                            class="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                        </svg>
                        Filter
                    </button>
                </div>

            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Request Date</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Ingredient</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Supplier</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Qty</th>
