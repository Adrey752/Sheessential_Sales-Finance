                            @for (int i = Math.Max(1, ViewBag.PayrollCurrentPage - 2); i <= Math.Min(ViewBag.PayrollTotalPages, ViewBag.PayrollCurrentPage + 2); i++)
                            {
                                <a href="?payrollPage=@i"
                                   class="px-3 py-2 border @(i == ViewBag.PayrollCurrentPage ? "bg-blue-600 text-white border-blue-600" : "border-gray-300 hover:bg-gray-50") rounded-lg transition-colors">
                                    @i
