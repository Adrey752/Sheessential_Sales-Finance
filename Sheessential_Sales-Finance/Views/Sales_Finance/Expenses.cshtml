                        <p class="text-red-700 text-sm mt-1">Available balance is not sufficient for this transfer. Please add funds before approving.</p>
                    </div>
                </div>
            </div>

            <form id="approveForm" asp-action="ApproveExpense" asp-controller="Sales_Finance" method="post">
                <input type="hidden" name="id" id="approve-expense-id" value="" />
                <input type="hidden" name="requestId" id="request-id" value="" />
                <input type="hidden" name="IsStockRequest" id="isStockReqInput" value="false" />            <!-- Balance Summary -->
                <div class="grid grid-cols-3 gap-4 mb-6">
                    <div class="bg-blue-50 p-4 rounded-xl border border-blue-200">
                        <p class="text-xs text-blue-700 font-medium mb-1">Current Balance</p>
                        <p class="text-lg font-bold text-blue-900">@Model.Balance.CurrentBalance</p>
                    </div>
                    <div class="bg-orange-50 p-4 rounded-xl border border-orange-200">
                        <p class="text-xs text-orange-700 font-medium mb-1">Transfer Amount</p>
                        <p class="text-lg font-bold text-orange-900" id="transfer-amount-display-main">₱0.00</p>
                    </div>
                    <div class="bg-green-50 p-4 rounded-xl border border-green-200">
                        <p class="text-xs text-green-700 font-medium mb-1">Balance After</p>
                        <p class="text-lg font-bold text-green-900" id="balance-after-transfer">₱50,000.00</p>
                    </div>
                </div>

                <div class="space-y-5">
                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Transfer Amount
                        </label>
                        <input type="text"
                               id="transfer-amount-display"
                               class="w-full border border-gray-300 rounded-xl p-4 bg-gray-50 text-gray-700 font-semibold text-lg"
                               readonly />
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Transfer To (Account/Person) <span class="text-red-500">*</span>
                        </label>
                        <input type="text"
                               name="TransferTo"
                               class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                               required
                               placeholder="Enter recipient name or account number" />
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Payment Method <span class="text-red-500">*</span>
                        </label>
                        <select name="PaymentMethod"
                                class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                                required>
                            <option value="">Select payment method</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cash">Cash</option>
                            <option value="Check">Check</option>
                            <option value="Online Payment">Online Payment</option>
                            <option value="Credit Card">Credit Card</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Reference Number
                        </label>
                        <input type="text"
                               name="ReferenceNumber"
                               class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                               placeholder="Enter reference or transaction number (optional)" />
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Transfer Notes
                        </label>
                        <textarea name="TransferNotes"
                                  class="w-full border border-gray-300 rounded-xl p-4 focus:ring-2 focus:ring-green-500 focus:border-transparent transition-all"
                                  rows="3"
                                  placeholder="Add any additional notes about the transfer (optional)"></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-8 pt-6 border-t border-gray-200">
                    <button type="button" id="cancelTransferBtn" class="px-6 py-2.5 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-colors font-medium">
                        Cancel
                    </button>
                    <button type="submit" id="confirmApproveBtn" class="px-6 py-2.5 bg-gradient-to-r from-green-500 to-green-600 text-white rounded-xl hover:from-green-600 hover:to-green-700 transition-all shadow-md hover:shadow-lg font-medium flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Confirm & Approve
                    </button>
                </div>
            </form>
        </div>
    </div>


    <!-- ADD EXPENSE MODAL -->
    <div id="expenseModal" class="fixed inset-0 bg-white bg-opacity-60 hidden items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-white w-full max-w-2xl rounded-3xl shadow-2xl p-8 m-4 max-h-[90vh] overflow-y-auto transform transition-all">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-200">
                <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">Create New Expense</h2>
                    <p class="text-gray-600 text-sm">Submit a new expense request</p>
                </div>
            </div>

            <form id="expenseForm">
                <div class="space-y-5">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">
                                Department <span class="text-red-500">*</span>
                            </label>
                            <select name="Department"
                                    class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                    required>
                                <option value="">Select department</option>
                                <option value="HR">HR</option>
                                <option value="Accounting">Accounting</option>
                                <option value="Website">Website</option>
                                <option value="Marketing">Marketing</option>
                                <option value="Inventory">Inventory</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">
                                Expense Type <span class="text-red-500">*</span>
                            </label>
                            <input name="ExpenseType"
                                   class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                   required
                                   placeholder="e.g., Office Supplies" />
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">
                                Requested By <span class="text-red-500">*</span>
                            </label>
                            <input name="RequestedBy"
                                   class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                   required
                                   placeholder="Your name" />
                        </div>
                        <div>
                            <label class="block text-gray-700 font-medium mb-2">
                                Amount (₱) <span class="text-red-500">*</span>
                            </label>
                            <input type="number"
                                   name="Amount"
                                   step="0.01"
                                   class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                   required
                                   placeholder="0.00" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Description <span class="text-red-500">*</span>
                        </label>
                        <textarea name="Description"
                                  class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                  rows="3"
                                  required
                                  placeholder="Describe the purpose of this expense..."></textarea>
                    </div>

                    <div>
                        <label class="block text-gray-700 font-medium mb-2">
                            Additional Notes
                        </label>
                        <textarea name="Notes"
                                  class="w-full border border-gray-300 rounded-xl p-3 focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                                  rows="2"
                                  placeholder="Any additional information (optional)"></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-8 pt-6 border-t border-gray-200">
                    <button type="button" id="closeModalBtn" class="px-6 py-2.5 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-colors font-medium">
                        Cancel
                    </button>
                    <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-blue-700 text-white rounded-xl hover:from-blue-700 hover:to-blue-800 transition-all shadow-md hover:shadow-lg font-medium flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                        Submit Request
                    </button>
                </div>
            </form>
        </div>

    </div>

    <div id="transactionDetailsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-gradient-to-br from-white to-gray-50 w-full max-w-3xl rounded-2xl shadow-xl px-6 pb-6 pt-0 max-h-[90vh] overflow-y-auto">

            <!-- Header -->
            <div class="sticky top-0 bg-white z-20 flex justify-between items-center mb-6 pb-4 border-b border-gray-300">
                <h2 class="text-2xl font-semibold text-gray-900 flex items-center gap-2 p-3">
                    <svg class="w-6 h-6 text-indigo-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4z"></path>
                        <path fill-rule="evenodd" d="M18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h10a1 1 0 010 2H5a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    Payment Transaction Details
                </h2>
                <button onclick="closeTransactionModal()" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Request Details -->
            <h3 class="text-xl font-medium text-gray-800 mb-4">Request Details</h3>
            <div class="space-y-4">
                <div class="bg-blue-100 p-4 rounded-xl shadow-sm">
                    <p class="text-sm text-blue-700 font-medium">Request ID</p>
                    <p id="transaction-request-id" class="text-xl font-bold text-blue-900"></p>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <p class="text-sm text-gray-500">Requested By</p>
                        <p id="transaction-requester" class="text-lg font-semibold text-gray-800"></p>
                    </div>
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <p class="text-sm text-gray-500">Supplier</p>
                        <p id="transaction-supplier" class="text-lg font-semibold text-gray-800"></p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <p class="text-sm text-gray-500">Ingredient</p>
                        <p id="transaction-ingredient" class="text-lg font-semibold text-gray-800"></p>
                    </div>
                    <div class="bg-green-100 p-4 rounded-xl shadow-sm border border-green-300">
                        <p class="text-sm text-green-700">Quantity</p>
                        <p id="transaction-qty" class="text-lg font-bold text-green-800"></p>
                    </div>
                </div>

                <div class="bg-yellow-100 p-4 rounded-xl shadow-sm border-l-4 border-yellow-500">
                    <p class="text-sm text-yellow-700">Total Cost</p>
                    <p id="transaction-total-cost" class="text-xl font-bold text-yellow-800"></p>
                </div>
            </div>

            <!-- Payment Section -->
            <div id="payment-section" class="mt-10 hidden">
                <h3 class="text-xl font-medium text-gray-800 mb-4 border-t pt-4">Transaction Record</h3>
                <div class="space-y-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-purple-100 p-4 rounded-xl shadow-sm border border-purple-300">
                            <p class="text-sm text-purple-700">Amount Paid</p>
                            <p id="payment-amount" class="text-xl font-bold text-purple-900"></p>
                        </div>
                        <div class="bg-purple-100 p-4 rounded-xl shadow-sm border border-purple-300">
                            <p class="text-sm text-purple-700">Payment Date</p>
                            <p id="payment-date" class="text-lg font-semibold text-purple-900"></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                            <p class="text-sm text-gray-500">Method</p>
                            <p id="payment-method" class="text-lg font-semibold text-gray-800"></p>
                        </div>
                        <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                            <p class="text-sm text-gray-500">Transferred To</p>
                            <p id="payment-transfer-to" class="text-lg font-semibold text-gray-800"></p>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <p class="text-sm text-gray-500">Reference Number</p>
                        <p id="payment-ref" class="text-lg font-semibold text-gray-800 break-all"></p>
                    </div>

                    <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-200">
                        <p class="text-sm text-gray-500">Notes</p>
                        <p id="payment-notes" class="text-lg font-semibold text-gray-800"></p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex justify-end mt-8 sticky bottom-0 bg-white pt-4 border-t border-gray-300">
                <button onclick="closeTransactionModal()" class="px-6 py-2.5 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition font-medium">
                    Close
                </button>
            </div>

        </div>
    </div>

    <!-- APPROVAL CONFIRMATION MODAL -->
    <div id="approveModal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold text-green-700 mb-4">Confirm Approval</h2>
            <p class="text-gray-700 mb-6">Are you sure you want to approve this payroll?</p>
            <div class="flex justify-end gap-3">
                <button onclick="closeApproveModal()" class="px-4 py-2 bg-gray-200 rounded-lg">Cancel</button>
                <button id="approveConfirmBtn" class="px-4 py-2 bg-green-600 text-white rounded-lg">Confirm</button>
            </div>
        </div>
    </div>

    <!-- DECLINE CONFIRMATION MODAL -->
    <div id="declineModal" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50 backdrop-blur-sm">
        <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-md">
            <h2 class="text-xl font-bold text-red-700 mb-4">Confirm Decline</h2>
            <p class="text-gray-700 mb-6">Are you sure you want to decline this payroll?</p>
            <div class="flex justify-end gap-3">
                <button onclick="closeDeclineModal()" class="px-4 py-2 bg-gray-200 rounded-lg">Cancel</button>
                <button id="declineConfirmBtn" class="px-4 py-2 bg-red-600 text-white rounded-lg">Confirm</button>
            </div>
        </div>
    </div>
    <script src="~/js/Expenses.js"></script>
    <script>
        // Initialize available balance for the JS module
        @if (Model.Balance != null)
        {
                <text>
                window.setAvailableBalance(@Model.Balance.CurrentBalance);
                </text>
        }
    </script>
