@model Sheessential_Sales_Finance.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        background-color: #FFFBFD;
        color: #A36A66;
    }

    .metric-card {
        cursor: pointer;
        transition: all 0.2s ease;
        border: 2px solid transparent;
    }

        .metric-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(163, 106, 102, 0.15);
        }

        .metric-card.active {
            border-color: #A36A66;
            box-shadow: 0 4px 16px rgba(163, 106, 102, 0.2);
        }

    .date-range-inputs {
        display: none;
        gap: 0.5rem;
        align-items: center;
    }

        .date-range-inputs.active {
            display: flex;
        }

    .date-input {
        padding: 0.4rem 0.6rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        color: #A36A66;
        font-size: 0.8rem;
    }

        .date-input:focus {
            outline: none;
            border-color: #A36A66;
        }

    .apply-date-btn {
        padding: 0.4rem 0.9rem;
        background-color: #A36A66;
        color: white;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.8rem;
        transition: background-color 0.2s;
    }

        .apply-date-btn:hover {
            background-color: #8a5a57;
        }

    /* Tab toggle for activity/orders */
    .tab-btn {
        padding: 0.4rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: transparent;
        color: #9ca3af;
        transition: all 0.15s;
    }

        .tab-btn.active {
            background: #A36A66;
            color: white;
        }
</style>

<div class="p-6 min-h-screen">

    <!-- ── Single header ── -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold" style="color:#A36A66;">Welcome back, @Model.UserName 👋</h1>
            <p class="text-sm text-gray-400 mt-0.5">Here's what's happening with your business.</p>
        </div>
        <!-- Period selector -->
        <div class="flex items-center gap-2 flex-wrap justify-end">
            <select id="timePeriodSelect"
                    class="rounded-xl border border-gray-200 px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-[#A36A66]/30"
                    style="color:#A36A66;">
                <option value="year">This Year</option>
                <option value="month">This Month</option>
                <option value="week">This Week</option>
                <option value="alltime">All Time</option>
                <option value="custom">Custom Range</option>
            </select>
            <div id="customDateRange" class="date-range-inputs">
                <input type="date" id="startDate" class="date-input" />
                <span class="text-gray-400 text-sm">to</span>
                <input type="date" id="endDate" class="date-input" />
                <button id="applyDateRange" class="apply-date-btn">Apply</button>
            </div>
        </div>
    </div>

    <!-- ── Period summary strip ── -->
    <div id="periodStrip" class="mb-6 px-4 py-2.5 bg-[#A36A66]/5 border border-[#A36A66]/15 rounded-xl flex items-center gap-2 text-sm" style="color:#A36A66;">
        <svg class="w-4 h-4 shrink-0 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Showing data for: <strong id="currentDateRange">This Year</strong></span>
    </div>

    <!-- ── Metric cards ── -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

        <!-- Total Sales -->
        <div class="metric-card active bg-white rounded-2xl shadow-sm border border-gray-100 px-6 py-5 flex items-center gap-4"
             id="card-sales" onclick="setActiveCard('sales')">
            <div class="w-12 h-12 rounded-xl bg-[#A36A66]/10 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6" style="color:#A36A66;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25A1.125 1.125 0 019.75 19.875V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25A1.125 1.125 0 0116.5 19.875V4.125z" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Sales</p>
                <p id="totalRevenue" class="text-2xl font-bold" style="color:#A36A66;">₱@Model.Revenue.ToString("N2")</p>
            </div>
        </div>

        <!-- Total Expense -->
        <div class="metric-card bg-white rounded-2xl shadow-sm border border-gray-100 px-6 py-5 flex items-center gap-4"
             id="card-expense" onclick="setActiveCard('expense')">
            <div class="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total Expense</p>
                <p id="totalExpense" class="text-2xl font-bold text-red-500">₱@Model.Expense.ToString("N2")</p>
            </div>
        </div>

        <!-- Net Profit -->
        <div class="metric-card bg-white rounded-2xl shadow-sm border border-gray-100 px-6 py-5 flex items-center gap-4"
             id="card-profit" onclick="setActiveCard('profit')">
            <div class="w-12 h-12 rounded-xl bg-green-50 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
            </div>
            <div>
                <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Net Profit</p>
                <p id="netProfit" class="text-2xl font-bold text-green-600">₱@Model.NetProfit.ToString("N2")</p>
            </div>
        </div>

    </div>

    <!-- ── Charts ── -->
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-4 mb-6">

        <!-- Line/Bar chart — wider -->
        <div class="lg:col-span-3 bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <h2 id="mainChartTitle" class="text-sm font-semibold mb-4 text-gray-500 uppercase tracking-wider">Sales Trend</h2>
            <div class="w-full h-72">
                <canvas id="profitTrendChart"></canvas>
            </div>
        </div>

        <!-- Doughnut chart — narrower but proportional -->
        <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
            <h2 id="doughnutChartTitle" class="text-sm font-semibold mb-4 text-gray-500 uppercase tracking-wider">Expense Breakdown</h2>
            <div class="w-full h-72 flex items-center justify-center">
                <canvas id="expenseBreakdownChart"></canvas>
            </div>
        </div>

    </div>

    <!-- ── Merged Activity + Orders with tab toggle ── -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">

        <!-- Tab header -->
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Recent Activity</h2>
            <div class="flex gap-1 bg-gray-100 p-1 rounded-xl">
                <button class="tab-btn active" id="tab-orders" onclick="switchTab('orders')">Orders</button>
                <button class="tab-btn" id="tab-activity" onclick="switchTab('activity')">Activity Log</button>
            </div>
        </div>

        <!-- Orders tab -->
        <div id="panel-orders">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="text-xs text-gray-400 uppercase border-b border-gray-100">
                    <tr>
                        <th class="py-3 px-3">Order #</th>
                        <th class="py-3 px-3">Customer</th>
                        <th class="py-3 px-3">Amount</th>
                        <th class="py-3 px-3">Payment</th>
                        <th class="py-3 px-3">Date</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="py-3 px-3 font-semibold" style="color:#A36A66;">@order.OrderNumber</td>
                            <td class="py-3 px-3 text-gray-700">@order.ShippingAddress?.FirstName @order.ShippingAddress?.LastName</td>
                            <td class="py-3 px-3 font-bold text-gray-800">₱@order.TotalAmount.ToString("N2")</td>
                            <td class="py-3 px-3">
                                <span class="text-xs px-2.5 py-1 rounded-full font-semibold
                                        @(order.PaymentStatus == "Paid" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-600")">
                                    @order.PaymentStatus
                                </span>
                            </td>
                            <td class="py-3 px-3 text-gray-400 text-xs">@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-10 text-center text-gray-300 text-sm">No recent orders found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Activity log tab (hidden by default) -->
        <div id="panel-activity" class="hidden">
            @if (ViewBag.ActionLogs != null && ((IEnumerable<dynamic>)ViewBag.ActionLogs).Any())
            {
                <div class="divide-y divide-gray-50">
                    @foreach (var log in (IEnumerable<dynamic>)ViewBag.ActionLogs)
                    {
                        <div class="py-3 flex items-start gap-4">
                            <div class="w-8 h-8 rounded-full bg-[#A36A66]/10 flex items-center justify-center shrink-0 mt-0.5">
                                <span class="text-xs font-bold" style="color:#A36A66;">
                                    @log.UserName.ToString().Substring(0, Math.Min(2, log.UserName.ToString().Length)).ToUpper()
                                </span>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-0.5">
                                    <p class="text-sm font-semibold" style="color:#A36A66;">@log.UserName</p>
                                    <span class="text-xs text-gray-300">·</span>
                                    <p class="text-xs text-gray-400">@log.TimeStamp.ToString("MMM dd, yyyy · hh:mm tt")</p>
                                </div>
                                <p class="text-sm text-gray-600">
                                    <span class="font-medium">@log.Action</span> @log.Entity — @log.Description
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-gray-300 text-center py-10">No recent activity yet.</p>
            }
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/Dashboard.js"></script>
    <script>
        // ── Tab toggle ──
        function switchTab(tab) {
            document.getElementById('panel-orders').classList.toggle('hidden', tab !== 'orders');
            document.getElementById('panel-activity').classList.toggle('hidden', tab !== 'activity');
            document.getElementById('tab-orders').classList.toggle('active', tab === 'orders');
            document.getElementById('tab-activity').classList.toggle('active', tab === 'activity');
        }

        // ── Active card highlight ──
        function setActiveCard(name) {
            ['sales','expense','profit'].forEach(n => {
                document.getElementById('card-' + n).classList.toggle('active', n === name);
            });
        }

        // ── Sync period strip label ──
        function updatePeriodStrip(period, startDate, endDate) {
            const el = document.getElementById('currentDateRange');
            const labels = {
                year: 'This Year',
                month: 'This Month',
                week: 'This Week',
                alltime: 'All Time'
            };
            if (period === 'custom' && startDate && endDate) {
                el.textContent = startDate + ' – ' + endDate;
            } else {
                el.textContent = labels[period] || 'This Year';
            }
        }

        // ── Patch Dashboard.js to also update cards & strip ──
        // Override the period select handler after Dashboard.js loads
        document.addEventListener('DOMContentLoaded', function () {
            const sel = document.getElementById('timePeriodSelect');
            const applyBtn = document.getElementById('applyDateRange');
            const customDiv = document.getElementById('customDateRange');

            sel.addEventListener('change', function () {
                const val = this.value;
                customDiv.classList.toggle('active', val === 'custom');
                if (val !== 'custom') {
                    updatePeriodStrip(val);
                    fetchAndUpdateCards(val);
                }
            });

            if (applyBtn) {
                applyBtn.addEventListener('click', function () {
                    const s = document.getElementById('startDate').value;
                    const e = document.getElementById('endDate').value;
                    if (s && e) {
                        updatePeriodStrip('custom', s, e);
                        fetchAndUpdateCards('custom', s, e);
                    }
                });
            }

            updatePeriodStrip('year');
        });

        // ── Fetch updated totals and sync cards ──
        function fetchAndUpdateCards(period, startDate, endDate) {
            let url = '/Sales_Finance/GetChartData?period=' + period;
            if (startDate) url += '&startDate=' + startDate;
            if (endDate) url += '&endDate=' + endDate;

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (!data || !data.summary) return;
                    const fmt = n => '₱' + Number(n).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                    document.getElementById('totalRevenue').textContent = fmt(data.summary.totalRevenue);
                    document.getElementById('totalExpense').textContent = fmt(data.summary.totalExpense);
                    document.getElementById('netProfit').textContent   = fmt(data.summary.netProfit);
                })
                .catch(() => {});
        }
    </script>
}
